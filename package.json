{
  "name": "roughatsea",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:wake-exports && astro dev",
    "build": "npm run validate:save-point && npm run validate:wake && npm run validate:dialogue && npm run build:wake-exports && astro check && astro build && node scripts/verify-dialogue-build.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "validate:save-point": "node scripts/validate-save-point.mjs",
    "validate:wake": "node scripts/validate-wake-data.mjs && node scripts/validate-wake-records.mjs",
    "validate:dialogue": "node scripts/validate-dialogue.mjs && node --test --test-concurrency=1 test/dialogue-phase2.test.mjs test/dialogue-phase3.test.mjs test/dialogue-phase3-deployment.test.mjs test/dialogue-phase3-qualification.test.mjs && node scripts/validate-dialogue-sea-trial.mjs",
    "dialogue:tick": "node scripts/dialogue-tick.mjs",
    "dialogue:benchmark": "node scripts/build-dialogue-benchmark.mjs",
    "test:dialogue:phase2": "node --test --test-concurrency=1 test/dialogue-phase2.test.mjs",
    "test:dialogue:phase3": "node --test --test-concurrency=1 test/dialogue-phase3.test.mjs test/dialogue-phase3-deployment.test.mjs test/dialogue-phase3-qualification.test.mjs",
    "qualify:dialogue:phase3": "node scripts/qualify-dialogue-sea-trial.mjs",
    "dialogue:sea-trial": "node scripts/dialogue-sea-trial.mjs",
    "build:wake-exports": "node scripts/build-wake-exports.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.0",
    "katex": "^0.18.4",
    "maplibre-gl": "^6.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  }
}
