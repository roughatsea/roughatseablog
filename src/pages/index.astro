---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import LinkCard from '../components/LinkCard.astro';
import { getCollection } from 'astro:content';
import { notePublicationTimes } from '../notePublicationTimes';

const notes = await getCollection('notes');
const links = await getCollection('links');

function createExcerpt(body: string | undefined, maxLength = 200) {
  const plainText = (body ?? '')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/[*_`~]/g, '')
    .replace(/^>\s?/gm, '')
    .replace(/\s+/g, ' ')
    .trim();

  if (plainText.length <= maxLength) return plainText;
  return `${plainText.slice(0, maxLength).trimEnd()}…`;
}

function getPublishedTimestamp(entry: any) {
  const explicitPublishedAt = entry.data.data.publishedAt;
  if (explicitPublishedAt instanceof Date) {
    return explicitPublishedAt.valueOf();
  }

  if (entry.type === 'note') {
    const migratedPublishedAt = notePublicationTimes[entry.data.id];
    if (migratedPublishedAt) {
      return new Date(migratedPublishedAt).valueOf();
    }
  }

  return entry.data.data.date.valueOf();
}

// Sort by the declared calendar date first. Publication timestamps are only
// used to resolve same-day ordering so timezone offsets can never move an
// August 15 entry ahead of an August 16 entry.
const allEntries = [
  ...notes.map(note => ({ type: 'note', data: note })),
  ...links.map(link => ({ type: 'link', data: link }))
].sort((a, b) => {
  const dateDifference = b.data.data.date.valueOf() - a.data.data.date.valueOf();
  if (dateDifference !== 0) return dateDifference;

  const timestampDifference = getPublishedTimestamp(b) - getPublishedTimestamp(a);
  if (timestampDifference !== 0) return timestampDifference;

  const aKey = `${a.type}:${a.data.id}`;
  const bKey = `${b.type}:${b.data.id}`;
  return bKey.localeCompare(aKey);
});
---
<BaseLayout title="Commonplace Book">
  <div class="feed-header">
    <h1>The Commonplace</h1>
    <p>A collection of thoughts, notes, and interesting links.</p>
  </div>

  <div class="feed">
    {allEntries.map((entry: any) => {
      if (entry.type === 'note') {
        const noteData = entry.data.data;
        return (
          <NoteCard 
            title={noteData.title}
            description={noteData.description}
            heroImage={noteData.heroImage}
            heroImageAlt={noteData.heroImageAlt}
            slug={entry.data.id}
            date={noteData.date}
            tags={noteData.tags}
            preview={createExcerpt(entry.data.body)}
          />
        );
      } else if (entry.type === 'link') {
        const linkData = entry.data.data;
        return (
          <LinkCard
            title={linkData.title}
            url={linkData.url}
            heroImage={linkData.heroImage}
            heroImageAlt={linkData.heroImageAlt}
            slug={entry.data.id}
            date={linkData.date}
            tags={linkData.tags}
            preview={createExcerpt(entry.data.body)}
          />
        );
      }
    })}
  </div>
</BaseLayout>

<style>
  .feed-header {
    margin-bottom: 3rem;
    text-align: center;
  }
  .feed-header h1 {
    font-family: var(--font-serif);
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }
  .feed-header p {
    color: var(--text-secondary);
    font-size: 1.125rem;
  }
  .feed {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .feed :global(.note-card),
  .feed :global(.link-card) {
    height: 100%;
    margin-bottom: 0;
  }

  @media (min-width: 768px) {
    :global(main.container) {
      max-width: 1200px;
    }
  }
</style>
