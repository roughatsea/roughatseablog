---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import LinkCard from '../components/LinkCard.astro';
import { getCollection, render } from 'astro:content';

const notes = await getCollection('notes');
const links = await getCollection('links');

console.log("NOTES:", JSON.stringify(notes, null, 2));
console.log("LINKS:", JSON.stringify(links, null, 2));

function createExcerpt(body: string | undefined, maxLength = 200) {
  const plainText = (body ?? '')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/^#{1,6}\s+/gm, '')
    .replace(/[*_`~]/g, '')
    .replace(/^>\s?/gm, '')
    .replace(/\s+/g, ' ')
    .trim();

  if (plainText.length <= maxLength) return plainText;
  return `${plainText.slice(0, maxLength).trimEnd()}…`;
}

// Combine and sort by date descending
const allEntries = [
  ...notes.map(note => ({ type: 'note', data: note })),
  ...links.map(link => ({ type: 'link', data: link }))
].sort((a, b) => b.data.data.date.valueOf() - a.data.data.date.valueOf());
---
<BaseLayout title="Commonplace Book">
  <div class="feed-header">
    <h1>The Commonplace</h1>
    <p>A collection of thoughts, notes, and interesting links.</p>
  </div>

  <div class="feed">
    {allEntries.map(async (entry: any) => {
      if (entry.type === 'note') {
        const noteData = entry.data.data;
        return (
          <NoteCard 
            title={noteData.title}
            description={noteData.description}
            slug={entry.data.id}
            date={noteData.date}
            tags={noteData.tags}
            preview={createExcerpt(entry.data.body)}
          />
        );
      } else if (entry.type === 'link') {
        const linkData = entry.data.data;
        const { Content } = await render(entry.data);
        return (
          <LinkCard
            title={linkData.title}
            url={linkData.url}
            date={linkData.date}
            tags={linkData.tags}
          >
            <Content />
          </LinkCard>
        );
      }
    })}
  </div>
</BaseLayout>

<style>
  .feed-header {
    margin-bottom: 3rem;
    text-align: center;
  }
  .feed-header h1 {
    font-family: var(--font-serif);
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }
  .feed-header p {
    color: var(--text-secondary);
    font-size: 1.125rem;
  }
  .feed {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>
