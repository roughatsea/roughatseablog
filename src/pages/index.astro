---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";

const posts = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featuredPosts = posts.filter((post) => post.data.featured).slice(0, 2);
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy reveal">
      <p class="eyebrow"><span class="status-dot"></span> Independent developer · Arizona</p>
      <h1>Software with a<br /><em>point of view.</em></h1>
      <p class="hero-lede">
        I’m Manny. I design and build thoughtful digital products, then write about the choices that made them work.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/work/">Explore the work <span>↗</span></a>
        <a class="text-link" href="/writing/">Read the field notes <span>→</span></a>
      </div>
    </div>

    <div class="hero-instrument reveal" style="--delay: 120ms" aria-label="Current position">
      <div class="instrument-topline">
        <span>ROUGH AT SEA / 2026</span>
        <span class="signal-bars" aria-label="Signal strong"><i></i><i></i><i></i><i></i></span>
      </div>
      <div class="compass" aria-hidden="true">
        <span class="compass-n">N</span>
        <div class="compass-orbit orbit-one"></div>
        <div class="compass-orbit orbit-two"></div>
        <div class="compass-needle"></div>
        <span class="compass-center">R/S</span>
      </div>
      <div class="instrument-readout">
        <div><small>MODE</small><strong>BUILD / LEARN</strong></div>
        <div><small>BEARING</small><strong>USEFUL ↗</strong></div>
      </div>
    </div>
  </section>

  <section class="manifesto-section">
    <div class="shell manifesto-grid">
      <p class="section-number">01 / PRACTICE</p>
      <div>
        <p class="manifesto">
          The best software feels <em>inevitable</em>—clear enough to trust, fast enough to disappear, and opinionated enough to remember.
        </p>
        <div class="principles-grid">
          <article><span>01</span><h3>Start with the constraint</h3><p>Good boundaries turn vague ambition into a system that can ship.</p></article>
          <article><span>02</span><h3>Make the interface honest</h3><p>Structure, language, and motion should clarify what the product is doing.</p></article>
          <article><span>03</span><h3>Leave less behind</h3><p>Performance, accessibility, and maintainability are features—not cleanup.</p></article>
        </div>
      </div>
    </div>
  </section>

  <section class="featured-work shell">
    <div class="section-heading">
      <div><p class="section-number">02 / SELECTED WORK</p><h2>Built in public.<br />Refined in practice.</h2></div>
      <a class="text-link" href="/work/">All work <span>→</span></a>
    </div>
    <a class="project-feature" href="/work/#rough-at-sea">
      <div class="project-visual" aria-hidden="true">
        <div class="project-window">
          <div class="window-bar"><i></i><i></i><i></i><span>roughatsea.com</span></div>
          <div class="window-code">
            <span>01</span><code>const direction = clarity;</code>
            <span>02</span><code>ship(less, better);</code>
            <span>03</span><code class="accent-code">// change course deliberately</code>
          </div>
        </div>
      </div>
      <div class="project-copy">
        <p class="eyebrow">Platform rebuild · 2026</p>
        <h3>Rough at Sea</h3>
        <p>A full-stack publishing platform deliberately rebuilt as a lean, content-first static system.</p>
        <ul><li>Architecture</li><li>Interface design</li><li>Astro</li></ul>
        <span class="project-arrow">↗</span>
      </div>
    </a>
  </section>

  <section class="latest-writing shell">
    <div class="section-heading compact">
      <div><p class="section-number">03 / FIELD NOTES</p><h2>Recent writing</h2></div>
      <a class="text-link" href="/writing/">The full log <span>→</span></a>
    </div>
    <div class="post-grid">
      {featuredPosts.map((post, index) => <PostCard post={post} index={index} />)}
    </div>
  </section>

  <section class="contact-band">
    <div class="shell contact-band-inner">
      <p class="eyebrow">OPEN CHANNEL</p>
      <h2>Have a useful problem?</h2>
      <a href="https://github.com/roughatsea">github.com/roughatsea <span>↗</span></a>
    </div>
  </section>
</BaseLayout>
