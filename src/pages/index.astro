---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import LinkCard from '../components/LinkCard.astro';
import { getCollection } from 'astro:content';

const notes = await getCollection('notes');
const links = await getCollection('links');

// Combine and sort by date descending
const allEntries = [
  ...notes.map(note => ({ type: 'note', data: note })),
  ...links.map(link => ({ type: 'link', data: link }))
].sort((a, b) => b.data.data.date.valueOf() - a.data.data.date.valueOf());
---
<BaseLayout title="Commonplace Book">
  <div class="feed-header">
    <h1>The Commonplace</h1>
    <p>A collection of thoughts, notes, and interesting links.</p>
  </div>

  <div class="feed">
    {allEntries.map((entry: any) => {
      if (entry.type === 'note') {
        const noteData = entry.data.data;
        return (
          <NoteCard 
            title={noteData.title}
            description={noteData.description}
            slug={entry.data.id}
            date={noteData.date}
            tags={noteData.tags}
          />
        );
      } else if (entry.type === 'link') {
        const linkData = entry.data.data;
        return (
          <LinkCard
            title={linkData.title}
            url={linkData.url}
            date={linkData.date}
            tags={linkData.tags}
          />
        );
      }
    })}
  </div>
</BaseLayout>

<style>
  .feed-header {
    margin-bottom: 3rem;
    text-align: center;
  }
  .feed-header h1 {
    font-family: var(--font-serif);
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }
  .feed-header p {
    color: var(--text-secondary);
    font-size: 1.125rem;
  }
  .feed {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>
