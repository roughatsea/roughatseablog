---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
const pilots = [
  { slug: 'open-closed-principle', title: 'Open/Closed Principle', description: 'A new discount arrives. See which code is added and which code stays untouched.' },
  { slug: 'switch-statements', title: 'Switch Statements', description: 'Follow membership rules from repeated conditionals to objects, including the choice that still has to happen.' },
  { slug: 'deadlock', title: 'Deadlock', description: 'Watch two workers stop each other, then see why a shared lock order lets them finish.' },
];
---
<BaseLayout title="Software Engineering Field Guide — Pilot articles" description="Three complete drafts for review before a guide-wide rewrite." robots="noindex, nofollow">
  <section class="pilots">
    <p class="eyebrow">Software Engineering Field Guide</p>
    <h1>Three articles to read before we rewrite the guide.</h1>
    <p>These are complete pilot drafts, not replacements for the published articles. Each includes C# and Python examples; choose a language on the article page.</p>
    {pilots.map((pilot, index) => (
      <article>
        <p class="number">Pilot {index + 1}</p>
        <h2><a href={`/guides/software-engineering/pilot/${pilot.slug}/`}>{pilot.title} →</a></h2>
        <p>{pilot.description}</p>
      </article>
    ))}
    <p class="review-question">The question for this review: would you be pleased if the rest of the guide read like these?</p>
    <a href="/guides/software-engineering/">Return to the existing guide</a>
  </section>
</BaseLayout>
<style>
  .pilots { max-width: 48rem; margin: 2rem auto 4rem; font-family: var(--font-serif, Georgia, serif); font-size: 1.1rem; line-height: 1.75; }
  h1 { font-size: clamp(2rem, 5vw, 3.3rem); line-height: 1.15; margin: 1rem 0 1.6rem; }
  .eyebrow, .number { font-family: var(--font-sans, system-ui, sans-serif); color: var(--text-secondary, #666); font-size: .8rem; }
  article { border-top: 1px solid var(--border-color, #888); padding-top: 1rem; margin-top: 2rem; }
  h2 { font-size: 1.4rem; margin: .5rem 0; }
  a { color: var(--link-color, #006cb5); text-decoration: underline; text-underline-offset: 3px; }
  a:focus-visible { outline: 2px solid var(--link-color, #006cb5); outline-offset: 3px; }
  .review-question { margin-top: 2.8rem; font-style: italic; }
</style>
