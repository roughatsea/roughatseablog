---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SoftwareEngineeringGuideIndex from '../../../components/SoftwareEngineeringGuideIndex.astro';
import { guideDomains, guideIndex, guideSources } from '../../../data/software-engineering-guide.js';
const revisedDescriptions: Record<string, string> = {
  'open-closed-principle': 'Add a new behavior without rewriting the existing code that uses it. Follow a checkout as an employee discount is added.',
  'switch-statements': 'Repeated checks for the same kind of object can make one new case require changes in several places. Compare membership rules before and after refactoring.',
  'deadlock': 'Two or more operations cannot continue because each is waiting for something another holds. Follow two workers and see how a shared lock order prevents their deadlock.',
};
const concepts = guideIndex.map((concept) => revisedDescriptions[concept.slug]
  ? { ...concept, definition: revisedDescriptions[concept.slug], lookFor: revisedDescriptions[concept.slug] }
  : concept);
---

<BaseLayout title="Software Engineering Field Guide" description="Understand software-engineering terms through concrete explanations, C# and Python examples, and practical trade-offs.">
  <article class="guide-introduction">
    <nav aria-label="Breadcrumb"><a href="/">← Rough at Sea</a></nav>
    <p class="eyebrow">Searchable companion reference</p>
    <h1>Software Engineering Field Guide</h1>
    <p class="lede">Search for a name you heard, an alias you half remember, or a problem you can see but cannot yet name. Each result opens a focused page with C# and Python examples.</p>
    <p>This guide contains {guideIndex.length} terms. The Open/Closed Principle, Switch Statements, and Deadlock articles have been rewritten and reviewed. Other entries are being revised in small batches.</p>
    <p>For the personal argument behind the guide, read <a href="/notes/the-working-vocabulary-of-software-engineering/">The Working Vocabulary of Software Engineering</a>.</p>
  </article>
  <SoftwareEngineeringGuideIndex concepts={concepts} domains={guideDomains} sources={guideSources} />
</BaseLayout>

<style>
  .guide-introduction { padding-top: 1rem; }
  .guide-introduction nav { color: var(--text-secondary); font-family: var(--font-sans); font-size: .8rem; margin-bottom: 3rem; }
  .guide-introduction nav a:hover { color: var(--link-color); }
  .eyebrow { color: var(--link-color); font-family: var(--font-sans); font-size: .72rem; font-weight: 700; letter-spacing: .1em; margin-bottom: .5rem; text-transform: uppercase; }
  h1 { font-family: var(--font-serif); font-size: clamp(2.7rem, 8vw, 4.8rem); line-height: 1.02; margin-bottom: 1.5rem; }
  .lede { font-family: var(--font-serif); font-size: 1.3rem; line-height: 1.7; }
  .guide-introduction p:not(.eyebrow) { font-family: var(--font-serif); }
  .guide-introduction a { color: var(--link-color); text-decoration: underline; text-underline-offset: 3px; }
</style>
