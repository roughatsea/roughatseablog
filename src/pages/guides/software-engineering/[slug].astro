---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SoftwareEngineeringConcept from '../../../components/SoftwareEngineeringConcept.astro';
import { guideConcepts } from '../../../data/software-engineering-guide.js';
import { Content as OpenClosed } from './pilot/open-closed-principle.mdx';
import { Content as SwitchStatements } from './pilot/switch-statements.mdx';
import { Content as Deadlock } from './pilot/deadlock.mdx';
import { Content as SingleResponsibility } from './review/solid-batch-1/single-responsibility-principle.mdx';
import { Content as Liskov } from './review/solid-batch-1/liskov-substitution-principle.mdx';
import { Content as InterfaceSegregation } from './review/solid-batch-1/interface-segregation-principle.mdx';
import { Content as DependencyInversion } from './review/solid-batch-1/dependency-inversion-principle.mdx';

export function getStaticPaths() {
  return guideConcepts.map((concept, index) => ({
    params: { slug: concept.slug },
    props: {
      concept,
      previous: index > 0 ? { slug: guideConcepts[index - 1].slug, title: guideConcepts[index - 1].title } : undefined,
      next: index < guideConcepts.length - 1 ? { slug: guideConcepts[index + 1].slug, title: guideConcepts[index + 1].title } : undefined,
    },
  }));
}
const { concept, previous, next } = Astro.props;
// Each MDX Content component supplies its own frontmatter layout.
const replacements: Record<string, any> = {
  'open-closed-principle': OpenClosed,
  'switch-statements': SwitchStatements,
  'deadlocks-and-lock-discipline': Deadlock,
  'single-responsibility-principle': SingleResponsibility,
  'liskov-substitution-principle': Liskov,
  'interface-segregation-principle': InterfaceSegregation,
  'dependency-inversion-principle': DependencyInversion,
};
const ApprovedArticle = replacements[concept.slug];
---

{ApprovedArticle ? <ApprovedArticle /> : (
  <BaseLayout title={`${concept.title} — Software Engineering Field Guide`} description={concept.definition}>
    <SoftwareEngineeringConcept concept={concept} previous={previous} next={next} />
  </BaseLayout>
)}
