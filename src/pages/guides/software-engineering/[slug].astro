---
import { guideConcepts } from '../../../data/software-engineering-guide.js';
import { revisedArticles } from '../../../data/field-guide-revisions';

export function getStaticPaths() {
  return guideConcepts.map((concept) => ({
    params: { slug: concept.slug },
    props: { concept },
  }));
}
const { concept } = Astro.props;
const Article = revisedArticles[concept.slug]?.Content;
if (!Article) {
  throw new Error(`Missing rewritten field-guide article: ${concept.slug}`);
}
---
<Article />
