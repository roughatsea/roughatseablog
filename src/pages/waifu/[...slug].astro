---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const waifus = await getCollection('waifus');
  return waifus.map((waifu: any) => ({
    params: { slug: waifu.id },
    props: { waifu },
  }));
}

const { waifu } = Astro.props as any;
const { Content } = await render(waifu);
const formattedDate = waifu.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={waifu.data.title} description={waifu.data.description}>
  <article class="waifu-article">
    <header class="article-header">
      <div class="meta-row">
        <a href="/waifu/">&larr; All Waifu</a>
        <time datetime={waifu.data.date.toISOString()}>{formattedDate}</time>
      </div>
      <p class="edition">Waifu · Edition {waifu.data.edition}</p>
      <h1>{waifu.data.title}</h1>
      {waifu.data.description && <p class="dek">{waifu.data.description}</p>}

      <div class="character-card">
        <div class="character-name">
          <span>Today's teacher</span>
          <strong>{waifu.data.character.name}</strong>
        </div>
        <dl>
          <div><dt>Age</dt><dd>{waifu.data.character.age}</dd></div>
          <div><dt>Role</dt><dd>{waifu.data.character.role}</dd></div>
          <div><dt>Domain</dt><dd>{waifu.data.domain}</dd></div>
          <div><dt>Reading time</dt><dd>{waifu.data.readTimeMinutes} min</dd></div>
        </dl>
        <p>{waifu.data.character.personality}</p>
      </div>
    </header>

    <figure class="hero">
      <img
        src={waifu.data.heroImage}
        alt={waifu.data.heroImageAlt}
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </figure>

    <div class="prose"><Content /></div>
  </article>
</BaseLayout>

<style>
  :global(main.container) {
    max-width: 880px;
  }
  .waifu-article {
    padding-bottom: 5rem;
  }
  .article-header {
    margin-bottom: 2rem;
  }
  .meta-row {
    align-items: center;
    color: var(--text-secondary);
    display: flex;
    font-size: 0.82rem;
    justify-content: space-between;
    margin-bottom: 1.7rem;
  }
  .meta-row a:hover {
    color: var(--text-primary);
  }
  .edition {
    color: #ff1493;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    margin: 0 0 0.7rem;
    text-transform: uppercase;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.7rem, 8vw, 5.5rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
    margin: 0;
    max-width: 52rem;
  }
  .dek {
    color: var(--text-secondary);
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.65;
    margin: 1.2rem 0 0;
    max-width: 48rem;
  }
  .character-card {
    background:
      radial-gradient(circle at 10% 20%, color-mix(in srgb, #ff1493 12%, transparent), transparent 36%),
      var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    display: grid;
    gap: 1rem 1.5rem;
    grid-template-columns: minmax(11rem, 0.65fr) minmax(0, 1.35fr);
    margin-top: 1.8rem;
    padding: 1.05rem 1.15rem;
  }
  .character-name {
    align-self: center;
    display: flex;
    flex-direction: column;
  }
  .character-name span,
  dt {
    color: var(--text-secondary);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .character-name strong {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    font-weight: 600;
    margin-top: 0.15rem;
  }
  .character-card dl {
    display: grid;
    gap: 0.7rem;
    grid-template-columns: 0.45fr 1.4fr 1fr 0.8fr;
    margin: 0;
  }
  .character-card dl div {
    border-left: 1px solid var(--border-color);
    padding-left: 0.75rem;
  }
  dd {
    font-size: 0.8rem;
    line-height: 1.35;
    margin: 0.2rem 0 0;
  }
  .character-card > p {
    color: var(--text-secondary);
    font-size: 0.78rem;
    grid-column: 1 / -1;
    line-height: 1.5;
    margin: 0;
  }
  .hero {
    margin: 0 0 3rem 50%;
    transform: translateX(-50%);
    width: min(1180px, calc(100vw - 2rem));
  }
  .hero img {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border-color);
    border-radius: 1.15rem;
    box-shadow: var(--glass-shadow);
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }
  :global(.prose) {
    font-size: 1.02rem;
    line-height: 1.78;
  }
  :global(.prose h2) {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 4vw, 2.45rem);
    letter-spacing: -0.025em;
    line-height: 1.1;
    margin-top: 3.2rem;
  }
  :global(.prose h3) {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    margin-top: 2.1rem;
  }
  :global(.prose .waifu-voice) {
    background:
      linear-gradient(120deg, color-mix(in srgb, #ff1493 9%, transparent), transparent 52%),
      var(--surface-color);
    border: 1px solid var(--border-color);
    border-left: 4px solid #ff1493;
    border-radius: 0 0.85rem 0.85rem 0;
    color: var(--text-primary);
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-style: italic;
    line-height: 1.6;
    margin: 2rem 0;
    padding: 1.1rem 1.25rem;
  }
  :global(.prose .waifu-voice p) {
    margin: 0;
  }
  :global(.prose .waifu-inline-image) {
    margin: 2.6rem 0;
  }
  :global(.prose .waifu-inline-image img) {
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    box-shadow: var(--glass-shadow);
    display: block;
    width: 100%;
  }
  :global(.prose .waifu-inline-image figcaption) {
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    line-height: 1.45;
    margin-top: 0.65rem;
    text-align: center;
  }
  :global(.prose .equation-card) {
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    margin: 2rem 0;
    padding: 1.2rem 1.4rem;
    text-align: center;
  }
  :global(.prose .equation-card strong) {
    display: block;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 5vw, 2.5rem);
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  :global(.prose .equation-card span) {
    color: var(--text-secondary);
    display: block;
    font-family: var(--font-sans);
    font-size: 0.76rem;
    margin-top: 0.5rem;
  }
  :global(.prose .little-secret) {
    background:
      radial-gradient(circle at 92% 0%, color-mix(in srgb, #93ff14 12%, transparent), transparent 34%),
      var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    margin-top: 3rem;
    padding: 1.25rem 1.4rem;
  }
  :global(.prose .little-secret h2) {
    margin-top: 0;
  }
  :global(.prose ul),
  :global(.prose ol) {
    margin-left: 1.35rem;
  }
  :global(.prose li) {
    margin-bottom: 0.5rem;
  }
  :global(.prose code) {
    background: var(--surface-color);
    border-radius: 4px;
    padding: 0.12rem 0.3rem;
  }
  @media (max-width: 720px) {
    .character-card {
      grid-template-columns: 1fr;
    }
    .character-card dl {
      grid-template-columns: 1fr 1fr;
    }
    .character-card dl div:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
