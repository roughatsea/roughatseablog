---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const waifus = (await getCollection('waifus')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latest = waifus[0];
const archive = waifus.slice(1);
const formatDate = (date: Date) => date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title="Waifu"
  description="One fictional adult woman, one irresistible question, one serious lesson every day."
>
  <section class="waifu-shell">
    <header class="waifu-masthead">
      <div class="masthead-copy">
        <p class="eyebrow">365 attempts to make learning irresistible</p>
        <h1>Waifu</h1>
        <p class="lede">
          One fictional adult woman. One subject worth understanding. One lesson designed to
          leave you knowing more than you did when the picture caught your eye.
        </p>
      </div>
      <div class="masthead-mark" aria-hidden="true">
        <span>W</span>
        <svg viewBox="0 0 120 120" fill="none">
          <circle cx="60" cy="60" r="43" />
          <path d="M18 70c20-30 38-36 52-20 13 15 26 10 34-8" />
          <path d="M26 88c18-20 37-23 51-8 11 12 22 10 31 2" />
        </svg>
      </div>
    </header>

    {latest ? (
      <article class="today-card">
        <a class="today-image" href={`/waifu/${latest.id}/`} aria-label={`Read ${latest.data.title}`}>
          <img
            src={latest.data.heroImage}
            alt={latest.data.heroImageAlt}
            width="1600"
            height="900"
            loading="eager"
            decoding="async"
          />
        </a>
        <div class="today-copy">
          <div class="today-kicker">
            <span>Today's Waifu</span>
            <time datetime={latest.data.date.toISOString()}>{formatDate(latest.data.date)}</time>
          </div>
          <h2><a href={`/waifu/${latest.id}/`}>{latest.data.title}</a></h2>
          {latest.data.description && <p class="description">{latest.data.description}</p>}
          <dl class="character-facts">
            <div><dt>Meet</dt><dd>{latest.data.character.name}, {latest.data.character.age}</dd></div>
            <div><dt>Role</dt><dd>{latest.data.character.role}</dd></div>
            <div><dt>Today</dt><dd>{latest.data.topic}</dd></div>
            <div><dt>Reading time</dt><dd>{latest.data.readTimeMinutes} min</dd></div>
          </dl>
          <a class="read-button" href={`/waifu/${latest.id}/`}>Meet her &rarr;</a>
        </div>
      </article>
    ) : (
      <p class="empty">The first lesson is still offshore.</p>
    )}

    <aside class="series-note">
      <strong>The house rule:</strong> every character in this series is an unambiguously adult
      woman, age 25 or older. The allure is deliberate; so is the scholarship.
    </aside>

    {archive.length > 0 && (
      <section class="archive-section">
        <div class="archive-heading">
          <div>
            <p class="eyebrow">Previous encounters</p>
            <h2>The archive</h2>
          </div>
          <p>Browse by curiosity. Categories and richer filtering will grow with the collection.</p>
        </div>
        <div class="archive-grid">
          {archive.map((waifu) => (
            <article class="archive-card">
              <a href={`/waifu/${waifu.id}/`} class="archive-image">
                <img src={waifu.data.heroImage} alt={waifu.data.heroImageAlt} loading="lazy" decoding="async" />
              </a>
              <div class="archive-copy">
                <p>{waifu.data.domain} · {formatDate(waifu.data.date)}</p>
                <h3><a href={`/waifu/${waifu.id}/`}>{waifu.data.title}</a></h3>
                <span>{waifu.data.character.name} · age {waifu.data.character.age}</span>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </section>
</BaseLayout>

<style>
  :global(main.container) {
    max-width: 1160px;
  }
  .waifu-shell {
    padding-bottom: 5rem;
  }
  .waifu-masthead {
    align-items: center;
    display: grid;
    gap: 2rem;
    grid-template-columns: minmax(0, 1fr) auto;
    margin: 0 auto 2.5rem;
    max-width: 70rem;
  }
  .eyebrow {
    color: var(--link-color);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    margin: 0 0 0.55rem;
    text-transform: uppercase;
  }
  h1,
  h2,
  h3 {
    font-family: var(--font-serif);
  }
  h1 {
    font-size: clamp(3.2rem, 10vw, 6.6rem);
    letter-spacing: -0.055em;
    line-height: 0.88;
    margin: 0 0 1rem;
  }
  .lede {
    color: var(--text-secondary);
    font-size: clamp(1.04rem, 2vw, 1.22rem);
    line-height: 1.65;
    margin: 0;
    max-width: 48rem;
  }
  .masthead-mark {
    align-items: center;
    display: grid;
    height: 8rem;
    justify-items: center;
    position: relative;
    width: 8rem;
  }
  .masthead-mark span {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    font-style: italic;
    position: absolute;
  }
  .masthead-mark svg {
    color: var(--link-color);
    height: 100%;
    stroke: currentColor;
    stroke-width: 1.2;
    width: 100%;
  }
  .today-card {
    background:
      radial-gradient(circle at 88% 20%, color-mix(in srgb, #ff1493 15%, transparent), transparent 32%),
      radial-gradient(circle at 10% 90%, color-mix(in srgb, #1493ff 13%, transparent), transparent 30%),
      var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 1.4rem;
    box-shadow: var(--glass-shadow);
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(20rem, 0.9fr);
    overflow: hidden;
  }
  .today-image {
    min-height: 31rem;
    overflow: hidden;
  }
  .today-image img {
    display: block;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.45s ease;
    width: 100%;
  }
  .today-image:hover img {
    transform: scale(1.015);
  }
  .today-copy {
    align-self: center;
    padding: clamp(1.6rem, 4vw, 3.2rem);
  }
  .today-kicker {
    align-items: center;
    color: var(--text-secondary);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.75rem;
    gap: 0.8rem;
    justify-content: space-between;
    text-transform: uppercase;
  }
  .today-kicker span {
    color: #ff1493;
    font-weight: 800;
    letter-spacing: 0.13em;
  }
  .today-copy h2 {
    font-size: clamp(2rem, 4vw, 3.3rem);
    letter-spacing: -0.035em;
    line-height: 1.04;
    margin: 1rem 0;
  }
  .today-copy h2 a,
  .archive-card h3 a {
    color: inherit;
  }
  .today-copy h2 a:hover,
  .archive-card h3 a:hover {
    color: var(--link-color);
  }
  .description {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.65;
  }
  .character-facts {
    display: grid;
    gap: 0.7rem;
    grid-template-columns: 1fr 1fr;
    margin: 1.4rem 0 1.7rem;
  }
  .character-facts div {
    border-top: 1px solid var(--border-color);
    padding-top: 0.65rem;
  }
  dt {
    color: var(--text-secondary);
    font-size: 0.63rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  dd {
    font-size: 0.85rem;
    margin: 0.18rem 0 0;
  }
  .read-button {
    background: var(--text-primary);
    border-radius: 999px;
    color: var(--bg-color);
    display: inline-block;
    font-size: 0.86rem;
    font-weight: 700;
    padding: 0.72rem 1rem;
  }
  .read-button:hover {
    opacity: 0.86;
  }
  .series-note {
    border-left: 3px solid #ff1493;
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.55;
    margin: 1.5rem auto 0;
    max-width: 62rem;
    padding: 0.45rem 0 0.45rem 1rem;
  }
  .series-note strong {
    color: var(--text-primary);
  }
  .archive-section {
    margin-top: 4rem;
  }
  .archive-heading {
    align-items: end;
    display: flex;
    gap: 2rem;
    justify-content: space-between;
    margin-bottom: 1.4rem;
  }
  .archive-heading h2 {
    font-size: 2.2rem;
    margin: 0;
  }
  .archive-heading > p {
    color: var(--text-secondary);
    font-size: 0.88rem;
    margin: 0;
    max-width: 28rem;
    text-align: right;
  }
  .archive-grid {
    display: grid;
    gap: 1.2rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .archive-card {
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 1rem;
    overflow: hidden;
  }
  .archive-image {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .archive-image img {
    height: 100%;
    object-fit: cover;
    width: 100%;
  }
  .archive-copy {
    padding: 1rem;
  }
  .archive-copy p,
  .archive-copy span {
    color: var(--text-secondary);
    font-size: 0.72rem;
  }
  .archive-copy h3 {
    font-size: 1.35rem;
    line-height: 1.15;
    margin: 0.45rem 0 0.7rem;
  }
  .empty {
    color: var(--text-secondary);
    text-align: center;
  }
  @media (max-width: 880px) {
    .today-card {
      grid-template-columns: 1fr;
    }
    .today-image {
      min-height: 0;
    }
    .today-image img {
      aspect-ratio: 16 / 9;
    }
    .archive-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 620px) {
    .waifu-masthead {
      grid-template-columns: 1fr;
    }
    .masthead-mark {
      display: none;
    }
    .character-facts,
    .archive-grid {
      grid-template-columns: 1fr;
    }
    .archive-heading {
      align-items: start;
      flex-direction: column;
      gap: 0.7rem;
    }
    .archive-heading > p {
      text-align: left;
    }
  }
</style>
