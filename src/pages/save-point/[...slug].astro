---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const editions = await getCollection('savePoints');
  return editions.map((edition: any) => ({
    params: { slug: edition.id },
    props: { edition },
  }));
}

const { edition } = Astro.props as any;
const { Content } = await render(edition);
const formattedDate = edition.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const laneLabels: Record<string, string> = {
  'final-fantasy': 'Final Fantasy',
  'final-fantasy-xiv': 'Final Fantasy XIV',
  'beyond-final-fantasy': 'Beyond Final Fantasy',
};
const sourceTypeLabels: Record<string, string> = {
  video: 'Video',
  news: 'News',
  lore: 'Lore',
  interview: 'Interview',
  history: 'History',
  design: 'Design',
  music: 'Music',
  preservation: 'Preservation',
  criticism: 'Criticism',
  research: 'Research',
  other: 'Source',
};
---

<BaseLayout
  title={edition.data.title}
  description={edition.data.description}
  image={edition.data.heroImage}
  article={true}
>
  <article class="save-point-container">
    <header class="save-point-article-header">
      <div class="meta">
        <a href="/save-point/" class="back-link">&larr; All Save Points</a>
        <time datetime={(edition.data.publishedAt ?? edition.data.date).toISOString()}>{formattedDate}</time>
      </div>
      <p class="series">Save Point · A daily JRPG corner</p>
      <h1>{edition.data.title}</h1>
      {edition.data.description && <p class="description">{edition.data.description}</p>}
      <p class="reading-time">Approximately {edition.data.readTimeMinutes} minutes</p>
    </header>

    <figure class="hero-image">
      <img
        src={edition.data.heroImage}
        alt={edition.data.heroImageAlt}
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </figure>

    <nav class="issue-map" aria-label="Stories in this edition">
      <p class="issue-map-title">Today at the Save Point</p>
      <div class="issue-map-grid">
        {edition.data.sections.map((section: any) => (
          <a
            href={`#${section.lane}`}
            class:list={['issue-map-item', { feature: section.lane === edition.data.featureLane }]}
          >
            <span class="lane-row">
              <span class="lane-name">{laneLabels[section.lane]}</span>
              {section.lane === edition.data.featureLane && <span class="feature-label">Feature</span>}
            </span>
            <strong>{section.title}</strong>
            <span class="summary">{section.summary}</span>
            <span class="story-facts">
              {sourceTypeLabels[section.sourceType] ?? section.sourceType}
              {section.spoilerLevel === 'major' && ' · Major spoilers collapsed'}
              {section.spoilerLevel === 'light' && ' · Light spoilers'}
            </span>
          </a>
        ))}
      </div>
    </nav>

    <div class="prose save-point-prose"><Content /></div>
  </article>
</BaseLayout>

<style>
  .save-point-container {
    padding-bottom: 4rem;
  }
  .save-point-article-header {
    margin-bottom: 2.5rem;
  }
  .meta {
    align-items: center;
    color: var(--text-secondary);
    display: flex;
    font-size: 0.875rem;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .back-link:hover {
    color: var(--text-primary);
  }
  .series {
    color: var(--link-color);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    margin-bottom: 0.65rem;
    text-transform: uppercase;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.35rem, 7vw, 4.25rem);
    letter-spacing: -0.025em;
    line-height: 1.08;
  }
  .description {
    color: var(--text-secondary);
    font-size: 1.08rem;
    max-width: 46rem;
  }
  .reading-time {
    color: var(--text-secondary);
    font-size: 0.78rem;
    margin: 0.6rem 0 0;
  }
  .hero-image {
    margin: 0 0 2rem 50%;
    transform: translateX(-50%);
    width: min(1120px, calc(100vw - 3rem));
  }
  .hero-image img {
    aspect-ratio: 16 / 9;
    background: #03101f;
    border: 1px solid var(--border-color);
    border-radius: 14px;
    box-shadow: var(--glass-shadow);
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }
  .issue-map {
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    margin: 0 0 3rem;
    padding: 1rem;
  }
  .issue-map-title {
    color: var(--text-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }
  .issue-map-grid {
    display: grid;
    gap: 0.65rem;
  }
  .issue-map-item {
    border: 1px solid var(--border-color);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.85rem 0.9rem;
  }
  .issue-map-item.feature {
    border-color: color-mix(in srgb, #ff1493 55%, var(--border-color));
  }
  .issue-map-item:hover {
    background: var(--bg-color);
    border-color: var(--link-color);
  }
  .lane-row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .lane-name,
  .feature-label,
  .story-facts {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }
  .lane-name,
  .story-facts {
    color: var(--text-secondary);
  }
  .feature-label {
    color: #b00064;
  }
  :global([data-theme='dark']) .feature-label {
    color: #ff6bb5;
  }
  .issue-map-item strong {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.3;
  }
  .summary {
    color: var(--text-secondary);
    font-family: var(--font-serif);
    font-size: 0.82rem;
    line-height: 1.5;
  }
  .story-facts {
    margin-top: 0.2rem;
  }
  :global(.save-point-prose h2) {
    border-top: 1px solid var(--border-color);
    font-size: clamp(1.65rem, 4vw, 2.2rem);
    margin-top: 3.5rem;
    padding-top: 2.25rem;
    scroll-margin-top: 6rem;
  }
  :global(.save-point-prose h3) {
    font-size: 1.18rem;
    margin-top: 2rem;
  }
  :global(.save-point-prose ul),
  :global(.save-point-prose ol) {
    margin: 0 0 1.5rem 1.45rem;
  }
  :global(.save-point-prose li) {
    margin-bottom: 0.45rem;
    padding-left: 0.2rem;
  }
  :global(.save-point-prose .status-line) {
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.76rem;
    letter-spacing: 0.035em;
    margin: -0.25rem 0 1.5rem;
  }
  @media (min-width: 720px) {
    .issue-map-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
