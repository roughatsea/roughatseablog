---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const reckonings = await getCollection('reckonings');
  return reckonings.map((reckoning: any) => ({
    params: { slug: reckoning.id },
    props: { reckoning },
  }));
}

const { reckoning } = Astro.props as any;
const { Content } = await render(reckoning);
const formattedDate = reckoning.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const miniSeries = reckoning.data.miniSeries;
---

<BaseLayout title={reckoning.data.title} description={reckoning.data.description}>
  <article class="reckoning-container">
    <header class="reckoning-header">
      <div class="meta">
        <a href="/reckonings/" class="back-link">&larr; All Reckonings</a>
        <time datetime={reckoning.data.date.toISOString()}>{formattedDate}</time>
      </div>
      <p class="series">The Daily Reckoning</p>
      <h1>{reckoning.data.title}</h1>
      {reckoning.data.description && <p class="description">{reckoning.data.description}</p>}
      {miniSeries && (
        <p class="mini-series">
          {miniSeries.title} · Part {miniSeries.part} of {miniSeries.total}
        </p>
      )}
      <dl class="lesson-facts">
        <div>
          <dt>Difficulty</dt>
          <dd>{reckoning.data.difficulty}</dd>
        </div>
        <div>
          <dt>Area</dt>
          <dd>{reckoning.data.area}</dd>
        </div>
        <div>
          <dt>Reading time</dt>
          <dd>{reckoning.data.readTimeMinutes} minutes</dd>
        </div>
        <div class="wide">
          <dt>Prerequisites</dt>
          <dd>
            {reckoning.data.prerequisites.length > 0
              ? reckoning.data.prerequisites.join(' · ')
              : 'None'}
          </dd>
        </div>
      </dl>
    </header>

    <figure class="hero-image">
      <img
        src={reckoning.data.heroImage}
        alt={reckoning.data.heroImageAlt}
        width="1600"
        height="900"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </figure>

    <div class="prose"><Content /></div>
  </article>
</BaseLayout>

<style>
  .reckoning-container {
    padding-bottom: 4rem;
  }
  .reckoning-header {
    margin-bottom: 2.5rem;
  }
  .meta {
    align-items: center;
    color: var(--text-secondary);
    display: flex;
    font-size: 0.875rem;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }
  .back-link:hover {
    color: var(--text-primary);
  }
  .series {
    color: var(--link-color);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    margin-bottom: 0.65rem;
    text-transform: uppercase;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.35rem, 7vw, 4.25rem);
    letter-spacing: -0.025em;
    line-height: 1.08;
  }
  .description {
    color: var(--text-secondary);
    font-size: 1.08rem;
    max-width: 46rem;
  }
  .mini-series {
    color: var(--link-color);
    font-size: 0.85rem;
    font-weight: 600;
  }
  .lesson-facts {
    display: grid;
    gap: 0.65rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 1.4rem;
  }
  .lesson-facts div {
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 0.65rem 0.8rem;
  }
  .lesson-facts .wide {
    grid-column: 1 / -1;
  }
  dt {
    color: var(--text-secondary);
    font-size: 0.65rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  dd {
    font-size: 0.85rem;
    margin: 0.12rem 0 0;
  }
  .hero-image {
    margin: 0 0 3rem 50%;
    transform: translateX(-50%);
    width: min(1120px, calc(100vw - 3rem));
  }
  .hero-image img {
    aspect-ratio: 16 / 9;
    background: #06111f;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    box-shadow: var(--glass-shadow);
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }
  :global(.prose h2) {
    font-size: clamp(1.55rem, 4vw, 2rem);
    margin-top: 2.8rem;
  }
  :global(.prose h3) {
    font-size: 1.2rem;
    margin-top: 2rem;
  }
  :global(.prose ul),
  :global(.prose ol) {
    margin: 0 0 1.5rem 1.45rem;
  }
  :global(.prose li) {
    margin-bottom: 0.55rem;
    padding-left: 0.25rem;
  }
  :global(.prose .katex-display) {
    margin: 1.6rem 0;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.25rem 0;
  }
  :global(.prose details) {
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    margin: 1rem 0 1.5rem;
    padding: 0.9rem 1rem;
  }
  :global(.prose summary) {
    color: var(--link-color);
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
  }
  :global(.prose details[open] summary) {
    margin-bottom: 1rem;
  }
  :global(.prose table) {
    border-collapse: collapse;
    display: block;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    margin: 1.4rem 0 2rem;
    max-width: 100%;
    overflow-x: auto;
    width: max-content;
  }
  :global(.prose th),
  :global(.prose td) {
    border: 1px solid var(--border-color);
    padding: 0.55rem 0.75rem;
    text-align: left;
  }
  :global(.prose th) {
    background: var(--surface-color);
  }
  :global(.prose code) {
    background: var(--surface-color);
    border-radius: 4px;
    font-size: 0.88em;
    padding: 0.12rem 0.3rem;
  }
  @media (max-width: 560px) {
    .lesson-facts {
      grid-template-columns: 1fr 1fr;
    }
    .lesson-facts div:nth-child(3),
    .lesson-facts .wide {
      grid-column: 1 / -1;
    }
  }
</style>
