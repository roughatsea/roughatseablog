---
import BaseLayout from '../../layouts/BaseLayout.astro';
import rawGames from '../../data/pixel-archive/games.json';
type Game = { date:string;slug:string;title:string;developer:string;description:string;lane:'familiar'|'unexpected';genres:string[];releaseStatus:string;image:string;imageAlt:string;imageCredit:string;article:string[];links:{label:string;url:string}[] };
const games = rawGames as Game[];
const entries = [...games].sort((a,b)=>b.date.localeCompare(a.date));
const genres = [...new Set(entries.flatMap(g=>g.genres))].sort();
---
<BaseLayout title="The Pixel Archive" description="One pixel art game a day: beloved worlds, unexpected experiments, and overlooked wonders." wide>
  <div class="archive">
    <header>
      <p class="eyebrow">One game. Every day. Endless worlds.</p>
      <h1>The Pixel Archive</h1>
      <p class="lede">A growing cabinet of curiosities for games built from pixels. Some discoveries speak to our love of atmospheric adventures and JRPGs; others arrive from the strange and wonderful fringes of game development.</p>
      <div class="stats"><span>{entries.length} discoveries</span><span>Independent of any one storefront</span></div>
    </header>
    <div class="tools">
      <label>Find a world <input id="game-search" type="search" placeholder="Search names, developers, descriptions…" /></label>
      <label>Genre <select id="genre-filter"><option value="">All genres</option>{genres.map(genre=><option value={genre}>{genre}</option>)}</select></label>
      <label>Discovery <select id="lane-filter"><option value="">Every kind</option><option value="familiar">For kindred spirits</option><option value="unexpected">Off the beaten path</option></select></label>
    </div>
    <div class="grid" id="games">
      {entries.map(game=><a class="game" href={`/pixel-art/${game.slug}/`} data-search={`${game.title} ${game.developer} ${game.description}`.toLowerCase()} data-genres={game.genres.join('|')} data-lane={game.lane}>
        {game.image ? <div class="game-media"><img loading="lazy" src={game.image} alt={game.imageAlt || `Editorial illustration for ${game.title}`} /><span class="art-label">AI-generated concept art · Not gameplay</span></div> : <div class="image-placeholder"><span>Artwork on creator’s page ↗</span></div>}
        <div class="copy"><small>{game.date} · {game.lane==='familiar'?'Kindred spirit':'Unexpected discovery'}</small><h2>{game.title}</h2><p>{game.description}</p><span>{game.genres.join(' · ')}</span></div>
      </a>)}
    </div>
    <p id="empty" hidden>No games match your filters. Try another search.</p>
    {entries.length===0 && <div class="opening"><h2>The collection begins here.</h2><p>The daily discoveries will populate this gallery, one researched game at a time. Each will have an individual article and a link to its creator.</p></div>}
  </div>
</BaseLayout>
<script>
  const search=document.querySelector<HTMLInputElement>('#game-search');
  const genre=document.querySelector<HTMLSelectElement>('#genre-filter');
  const lane=document.querySelector<HTMLSelectElement>('#lane-filter');
  const cards=[...document.querySelectorAll<HTMLElement>('.game')];
  const empty=document.querySelector<HTMLElement>('#empty');
  function filter() {
    let count=0;
    cards.forEach(card=>{
      const yes=card.dataset.search?.includes(search?.value.trim().toLowerCase()||'') && (!genre?.value||card.dataset.genres?.split('|').includes(genre.value)) && (!lane?.value||card.dataset.lane===lane.value);
      card.hidden=!yes;if(yes)count++;
    });
    if(empty)empty.hidden=count!==0||cards.length===0;
  }
  [search,genre,lane].forEach(el=>el?.addEventListener('input',filter));
</script>
<style>
.archive{max-width:1200px;margin:auto}.archive header{text-align:center;margin:2rem auto 3rem;max-width:780px}.eyebrow{text-transform:uppercase;letter-spacing:.16em;color:var(--link-color);font-size:.74rem;font-weight:700}h1{font-family:var(--font-serif);font-size:clamp(2.8rem,7vw,5rem);letter-spacing:-.04em;margin:.5rem 0}.lede{font-size:1.15rem;color:var(--text-secondary);line-height:1.8}.stats{display:flex;justify-content:center;flex-wrap:wrap;gap:1.5rem;font-size:.85rem;color:var(--text-secondary)}.tools{display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:2rem}.tools label{display:grid;gap:.35rem;flex:1 1 210px;font-size:.8rem;color:var(--text-secondary)}input,select{width:100%;background:var(--surface-color);color:var(--text-primary);border:1px solid var(--border-color);padding:.8rem;border-radius:.6rem}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}.game{display:block;border:1px solid var(--border-color);border-radius:1rem;overflow:hidden;background:var(--surface-color);color:var(--text-primary);transition:transform .15s,border-color .15s}.game:hover{transform:translateY(-3px);border-color:var(--link-color)}.game[hidden]{display:none}.image-placeholder{aspect-ratio:16/9;display:grid;place-items:center;padding:1rem;text-align:center;background:linear-gradient(135deg,var(--surface-color),var(--bg-color));border-bottom:1px solid var(--border-color);color:var(--text-secondary);font-size:.85rem}.game-media{position:relative}.art-label{position:absolute;left:.6rem;bottom:.6rem;background:rgba(11,19,31,.9);color:#fff!important;font-size:.65rem!important;padding:.35rem .55rem;border-radius:.35rem}.game img{width:100%;aspect-ratio:16/9;object-fit:cover;image-rendering:auto}.copy{padding:1.2rem}.copy small,.copy span{font-size:.75rem;color:var(--text-secondary)}.copy h2{font-size:1.3rem;margin:.4rem 0}.copy p{font-size:.92rem;line-height:1.6}.opening{text-align:center;border:1px dashed var(--border-color);border-radius:1rem;padding:3rem 1rem}.opening h2{font-family:var(--font-serif)}@media(max-width:900px){.grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.grid{grid-template-columns:1fr}.archive header{margin-top:.5rem}}
</style>