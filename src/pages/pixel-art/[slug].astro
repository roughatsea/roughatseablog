---
import BaseLayout from '../../layouts/BaseLayout.astro';
import rawGames from '../../data/pixel-archive/games.json';
type Game = { date:string;slug:string;title:string;developer:string;description:string;lane:'familiar'|'unexpected';genres:string[];releaseStatus:string;image:string;imageAlt:string;imageCredit:string;article:string[];links:{label:string;url:string}[] };
const games = rawGames as Game[];
export async function getStaticPaths(){
  const { default: rawGames } = await import('../../data/pixel-archive/games.json');
  const games = rawGames as Game[];
  return games.map(game => ({ params: { slug: game.slug }, props: { game } }));
}
const {game}=Astro.props;
---
<BaseLayout title={game.title+' · The Pixel Archive'} description={game.description} image={game.image || '/og.png'} article>
  <article class="feature">
    <a class="back" href="/pixel-art/">← The Pixel Archive</a>
    <p class="eyebrow">{game.date} · {game.lane==='familiar'?'Kindred spirit':'Unexpected discovery'}</p>
    <h1>{game.title}</h1>
    <p class="lede">{game.description}</p>
    {game.image ? <figure class="editorial-art"><div class="art-frame"><img src={game.image} alt={game.imageAlt||`Editorial illustration for ${game.title}`} /><span class="art-overlay">AI-generated concept art · Not gameplay</span></div><figcaption>{game.imageCredit||"AI-generated editorial concept art — not official game artwork or gameplay"}</figcaption></figure> : <aside class="media-fallback"><strong>See the game as its creator presents it</strong><p>We could not verify a reusable image for this feature. The official game page contains the creator’s own visual presentation.</p><a href={game.links[0]?.url} target="_blank" rel="noopener noreferrer">View official game artwork and screenshots ↗</a></aside>}
    <div class="facts"><span><strong>Developer</strong>{game.developer}</span><span><strong>Release</strong>{game.releaseStatus}</span><span><strong>Genres</strong>{game.genres.join(', ')}</span></div>
    <section><h2>The discovery</h2>{game.article.map(paragraph=><p>{paragraph}</p>)}</section>
    <section><h2>Find the game</h2><ul>{game.links.map(link=><li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a></li>)}</ul></section>
  </article>
</BaseLayout>
<style>
.feature{max-width:780px;margin:1rem auto 5rem}.back{font-size:.9rem}.eyebrow{text-transform:uppercase;letter-spacing:.14em;color:var(--link-color);font-size:.75rem;font-weight:700;margin-top:2rem}h1{font-family:var(--font-serif);font-size:clamp(2.8rem,7vw,4.5rem);line-height:1.1}.lede{font-size:1.25rem;color:var(--text-secondary);line-height:1.7}.media-fallback{margin:2rem 0;padding:1.5rem;border:1px solid var(--border-color);border-radius:.8rem;background:var(--surface-color)}.media-fallback p{color:var(--text-secondary);line-height:1.6}figure{margin:2rem 0}figure img{width:100%;border-radius:.8rem}.art-frame{position:relative}.art-overlay{position:absolute;left:.85rem;bottom:1rem;background:rgba(12,17,30,.91);color:white;font-size:.75rem;font-weight:600;padding:.5rem .75rem;border-radius:.4rem}.editorial-art figcaption{margin-top:.5rem}figcaption{font-size:.75rem;color:var(--text-secondary)}.facts{display:flex;gap:1.5rem;flex-wrap:wrap;border-block:1px solid var(--border-color);padding:1.2rem 0}.facts span{display:grid;gap:.3rem;font-size:.9rem}.facts strong{font-size:.7rem;text-transform:uppercase;color:var(--text-secondary)}section{margin:2.5rem 0}section p{line-height:1.9;font-size:1.05rem}li{margin:.6rem 0}
</style>