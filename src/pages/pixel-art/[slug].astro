---
import BaseLayout from '../../layouts/BaseLayout.astro';
import rawGames from '../../data/pixel-archive/games.json';
type Game = { date:string;slug:string;title:string;developer:string;description:string;lane:'familiar'|'unexpected';genres:string[];releaseStatus:string;image:string;imageAlt:string;imageCredit:string;article:string[];links:{label:string;url:string}[] };
const games = rawGames as Game[];
export async function getStaticPaths(){
  const { default: rawGames } = await import('../../data/pixel-archive/games.json');
  const games = rawGames as Game[];
  return games.map(game => ({ params: { slug: game.slug }, props: { game } }));
}
const {game}=Astro.props;
---
<BaseLayout title={game.title+' · The Pixel Archive'} description={game.description} image={game.image || '/og.png'} article>
  <article class="feature">
    <a class="back" href="/pixel-art/">← The Pixel Archive</a>
    <p class="eyebrow">{game.date} · {game.lane==='familiar'?'Kindred spirit':'Unexpected discovery'}</p>
    <h1>{game.title}</h1>
    <p class="lede">{game.description}</p>
    {game.image&&<figure><img src={game.image} alt={game.imageAlt||`Screenshot of ${game.title}`}/><figcaption>Game imagery · {game.imageCredit||game.developer}</figcaption></figure>}
    <div class="facts"><span><strong>Developer</strong>{game.developer}</span><span><strong>Release</strong>{game.releaseStatus}</span><span><strong>Genres</strong>{game.genres.join(', ')}</span></div>
    <section><h2>The discovery</h2>{game.article.map(paragraph=><p>{paragraph}</p>)}</section>
    <section><h2>Find the game</h2><ul>{game.links.map(link=><li><a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a></li>)}</ul></section>
  </article>
</BaseLayout>
<style>
.feature{max-width:780px;margin:1rem auto 5rem}.back{font-size:.9rem}.eyebrow{text-transform:uppercase;letter-spacing:.14em;color:var(--link-color);font-size:.75rem;font-weight:700;margin-top:2rem}h1{font-family:var(--font-serif);font-size:clamp(2.8rem,7vw,4.5rem);line-height:1.1}.lede{font-size:1.25rem;color:var(--text-secondary);line-height:1.7}figure{margin:2rem 0}figure img{width:100%;border-radius:.8rem}figcaption{font-size:.75rem;color:var(--text-secondary)}.facts{display:flex;gap:1.5rem;flex-wrap:wrap;border-block:1px solid var(--border-color);padding:1.2rem 0}.facts span{display:grid;gap:.3rem;font-size:.9rem}.facts strong{font-size:.7rem;text-transform:uppercase;color:var(--text-secondary)}section{margin:2.5rem 0}section p{line-height:1.9;font-size:1.05rem}li{margin:.6rem 0}
</style>