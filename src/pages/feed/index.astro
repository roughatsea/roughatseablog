---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Issue from '../../components/first-light/Issue.astro';
import Collection from '../../components/first-light/Collection.astro';
import { readEditions } from '../../../scripts/first-light-data.mjs';
const editions = readEditions();
const [latest, ...previous] = editions;
---
<BaseLayout title="First Light" description="An illustrated daily about science, the technological singularity, and the lives we could lead. A future worth imagining." image={latest?.images.cover.src} wide>
  {latest ? <><Issue edition={latest} hasArchive={previous.length > 0} /><Collection editions={previous} /></> : <section class="coming-soon"><p>An illustrated daily from Rough at Sea</p><h1>First Light</h1><p>Science, possibility, and the lives we could lead.</p><p>The first issue is on its way.</p></section>}
</BaseLayout>

<style>
  .coming-soon { max-width: 800px; margin: 4rem auto 6rem; text-align: center; }
  .coming-soon h1 { font-family: var(--font-serif); font-size: clamp(3.5rem,11vw,7rem); font-weight: 400; letter-spacing: -.06em; margin: 1rem 0; }
  .coming-soon p { color: var(--text-secondary); }
</style>
