---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Issue from '../../components/first-light/Issue.astro';
import type { Edition } from '../../../scripts/first-light-data.mjs';
interface Props { edition: Edition }
import { readEditions } from '../../../scripts/first-light-data.mjs';
export function getStaticPaths() {
  return readEditions().map(edition => ({ params: { date: edition.date }, props: { edition } }));
}
const { edition } = Astro.props;
---
<BaseLayout title={`${edition.title} · First Light ${String(edition.issue).padStart(3, '0')}`} description={edition.dek} image={edition.images.cover.src} article wide>
  <Issue edition={edition} isArchive />
</BaseLayout>
