---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  dialogueCharacters,
  dialogueMessages,
  formatDialogueTime,
  messageExcerpt,
  type DialogueCharacter,
} from '../../../lib/dialogue';

export function getStaticPaths() {
  return dialogueCharacters.map((character) => ({
    params: { slug: character.slug },
    props: { character },
  }));
}

interface Props {
  character: DialogueCharacter;
}

const { character } = Astro.props;
const recentMessages = dialogueMessages.filter((message) => message.author_id === character.id).slice(-4).reverse();
---

<BaseLayout
  title={`${character.name} · Dialogue`}
  description={character.public_profile.dek}
>
  <article
    class="profile"
    style={`--character-primary:${character.visual.primary};--character-secondary:${character.visual.secondary};--character-signal:${character.visual.signal}`}
  >
    <a class="back-link" href="/dialogue/">← Return to Dialogue</a>

    <header class="profile-header">
      <div class="profile-sigil" aria-hidden="true">
        <span>{character.visual.sigil}</span>
        <svg viewBox="0 0 180 180" fill="none">
          <circle cx="90" cy="90" r="73" />
          <circle cx="90" cy="90" r="55" />
          <path d="M90 5v24M90 151v24M5 90h24M151 90h24M30 30l17 17M133 133l17 17M150 30l-17 17M47 133l-17 17" />
        </svg>
      </div>
      <div>
        <p class="eyebrow">Dialogue founder · {character.age_range} · {character.pronouns}</p>
        <h1>{character.name}</h1>
        <p class="dek">{character.public_profile.dek}</p>
        <div class="gravity">
          <small>Gravitational tendency</small>
          <strong>{character.gravitational_tendency.label}</strong>
          <span>{character.gravitational_tendency.pulls_attention_to}</span>
        </div>
      </div>
    </header>

    <div class="profile-grid">
      <section class="biography panel">
        <p class="section-index">01 / Life</p>
        <h2>In the room</h2>
        <p>{character.public_profile.biography}</p>
        <blockquote>{character.hard_anchors[0]}</blockquote>
      </section>

      <section class="voice panel">
        <p class="section-index">02 / Voice</p>
        <h2>How {character.name.split(' ')[0]} speaks</h2>
        <p>{character.public_profile.voice}</p>
        <p class="activity">{character.activity_pattern}</p>
      </section>

      <section class="knowledge panel">
        <p class="section-index">03 / Knowledge boundary</p>
        <div class="knowledge-grid">
          <div>
            <h2>Home territory</h2>
            <ul>{character.public_profile.expertise.map((item) => <li>{item}</li>)}</ul>
          </div>
          <div>
            <h2>Genuine ignorance</h2>
            <ul>{character.public_profile.ignorance.map((item) => <li>{item}</li>)}</ul>
          </div>
        </div>
      </section>

      <section class="sources panel">
        <p class="section-index">04 / Evidence habits</p>
        <h2>Sources most likely to earn attention</h2>
        <div class="source-tags">
          {character.source_preferences.map((source) => <span>{source}</span>)}
        </div>
      </section>
    </div>

    <section class="recent panel">
      <div class="recent-heading">
        <div>
          <p class="section-index">05 / Founding record</p>
          <h2>Recent messages</h2>
        </div>
        <span>{recentMessages.length} in the archive</span>
      </div>
      <div class="recent-list">
        {recentMessages.map((message) => (
          <a href={`/dialogue/#${message.id}`}>
            <time>{formatDialogueTime(message.published_at)}</time>
            <p>{messageExcerpt(message, 210)}</p>
            <span>Open in river →</span>
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  :global(main.container) { max-width: 1120px; }
  .profile { padding-bottom: 4rem; }
  .back-link {
    color: var(--text-secondary);
    display: inline-block;
    font-size: 0.72rem;
    margin-bottom: 1.5rem;
  }
  .back-link:hover { color: var(--character-primary); }
  .profile-header {
    align-items: center;
    background:
      radial-gradient(circle at 12% 50%, color-mix(in srgb, var(--character-primary) 16%, transparent), transparent 21rem),
      color-mix(in srgb, var(--surface-color) 96%, transparent);
    border: 1px solid color-mix(in srgb, var(--character-primary) 28%, var(--border-color));
    display: grid;
    gap: clamp(1.5rem, 5vw, 4rem);
    grid-template-columns: minmax(13rem, 0.7fr) minmax(0, 1.3fr);
    margin-bottom: 1rem;
    overflow: hidden;
    padding: clamp(1.5rem, 5vw, 4rem);
    position: relative;
  }
  .profile-header::before {
    background: linear-gradient(90deg, var(--character-primary), var(--character-secondary), transparent 82%);
    content: '';
    height: 3px;
    inset: 0 0 auto;
    position: absolute;
  }
  .profile-sigil { aspect-ratio: 1; display: grid; place-items: center; position: relative; }
  .profile-sigil span {
    color: var(--character-primary);
    font-family: var(--font-serif);
    font-size: clamp(3rem, 9vw, 5.5rem);
    grid-area: 1 / 1;
    letter-spacing: -0.08em;
  }
  .profile-sigil svg {
    color: var(--character-primary);
    grid-area: 1 / 1;
    height: auto;
    opacity: 0.45;
    stroke: currentColor;
    stroke-width: 1;
    width: 100%;
  }
  .eyebrow,
  .section-index {
    color: var(--character-primary);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  h1 {
    font-family: var(--font-serif);
    font-size: clamp(3.2rem, 9vw, 6.5rem);
    font-weight: 400;
    letter-spacing: -0.06em;
    line-height: 0.92;
    margin: 0.45rem 0 1rem;
  }
  .dek {
    color: var(--text-secondary);
    font-family: var(--font-serif);
    font-size: clamp(1.08rem, 2vw, 1.28rem);
    line-height: 1.65;
    max-width: 43rem;
  }
  .gravity {
    border-left: 2px solid var(--character-primary);
    display: grid;
    gap: 0.12rem;
    margin-top: 1.5rem;
    max-width: 40rem;
    padding-left: 0.85rem;
  }
  .gravity small { color: var(--text-secondary); font-size: 0.58rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .gravity strong { color: var(--character-primary); font-size: 0.92rem; }
  .gravity span { color: var(--text-secondary); font-size: 0.72rem; line-height: 1.5; }
  .profile-grid { display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .panel {
    background: color-mix(in srgb, var(--surface-color) 96%, transparent);
    border: 1px solid var(--border-color);
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .panel h2 { font-family: var(--font-serif); font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 400; margin: 0.35rem 0 1rem; }
  .panel > p:not(.section-index),
  .knowledge li { color: var(--text-secondary); font-family: var(--font-serif); font-size: 1rem; line-height: 1.7; }
  .biography blockquote {
    border-left: 2px solid var(--character-primary);
    color: var(--text-primary);
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-style: italic;
    margin: 1.4rem 0 0;
    padding-left: 1rem;
  }
  .voice { border-top: 3px solid var(--character-primary); }
  .activity { border-top: 1px solid var(--border-color); font-size: 0.82rem !important; margin-top: 1rem; padding-top: 1rem; }
  .knowledge,
  .sources { grid-column: 1 / -1; }
  .knowledge-grid { display: grid; gap: 2rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .knowledge ul { display: flex; flex-wrap: wrap; gap: 0.45rem; list-style: none; }
  .knowledge li,
  .source-tags span {
    border: 1px solid color-mix(in srgb, var(--character-primary) 24%, var(--border-color));
    border-radius: 999px;
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    padding: 0.4rem 0.65rem;
  }
  .knowledge-grid > div:last-child li { border-style: dashed; }
  .source-tags { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .source-tags span { border-radius: 4px; }
  .recent { margin-top: 1rem; }
  .recent-heading { align-items: end; display: flex; justify-content: space-between; gap: 1rem; }
  .recent-heading > span { color: var(--text-secondary); font-family: ui-monospace, monospace; font-size: 0.62rem; }
  .recent-list { border-top: 1px solid var(--border-color); }
  .recent-list a {
    align-items: start;
    border-bottom: 1px solid var(--border-color);
    display: grid;
    gap: 1rem;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    padding: 1rem 0;
  }
  .recent-list a:hover { color: var(--character-primary); }
  .recent-list time,
  .recent-list span { color: var(--text-secondary); font-family: ui-monospace, monospace; font-size: 0.62rem; }
  .recent-list p { color: var(--text-primary); font-family: var(--font-serif); font-size: 0.92rem; line-height: 1.55; margin: 0; }

  @media (max-width: 760px) {
    .profile-header { grid-template-columns: 1fr; }
    .profile-sigil { justify-self: center; max-width: 15rem; width: 65%; }
    .profile-grid { grid-template-columns: 1fr; }
    .knowledge,
    .sources { grid-column: auto; }
    .knowledge-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 540px) {
    .recent-list a { grid-template-columns: 1fr; gap: 0.35rem; }
    .recent-list span { justify-self: start; }
  }
</style>
