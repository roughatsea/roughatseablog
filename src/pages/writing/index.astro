---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";

const posts = (await getCollection("writing", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title="Entries" description="A notebook of short entries, reflections, and collected notes.">
  <header class="page-header shell">
    <p class="eyebrow">THE SHIP’S LOG</p>
    <h1>Entries from<br /><em>a commonplace book.</em></h1>
    <p>Short notes, quotations, and observations gathered from reading, projects, and the moments when an idea sticks.</p>
  </header>

  <section class="shell archive-list" aria-label="Articles">
    {posts.map((post, index) => <PostCard post={post} index={index} />)}
  </section>
</BaseLayout>
