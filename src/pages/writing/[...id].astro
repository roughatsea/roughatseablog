---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, readingTime } from "../../utils/dates";

export async function getStaticPaths() {
  const posts = await getCollection("writing", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<"writing"> }
const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description} article>
  <article class="article shell">
    <header class="article-header">
      <a class="back-link" href="/writing/">← All writing</a>
      <div class="article-meta">
        <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
        <span>/</span><span>{readingTime(post.body)}</span>
      </div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="tag-list">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>
    </header>

    <div class="article-grid">
      <aside class="article-rail">
        <p>IN THIS NOTE</p>
        <ol>
          {headings.filter((heading) => heading.depth === 2).map((heading) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </aside>
      <div class="prose"><Content /></div>
    </div>
  </article>

  <section class="article-next">
    <div class="shell">
      <p class="eyebrow">END OF NOTE</p>
      <h2>Keep following the signal.</h2>
      <a class="button button-primary" href="/writing/">Browse all writing <span>→</span></a>
    </div>
  </section>
</BaseLayout>
