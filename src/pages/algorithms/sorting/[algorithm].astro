---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sorting from '../../../components/algorithms/Sorting.astro';
import SortingLesson from '../../../components/algorithms/SortingLesson.astro';
import {sortingAlgorithms} from '../../../data/sorting';
export function getStaticPaths(){return sortingAlgorithms.map(algorithm=>({params:{algorithm:algorithm.slug},props:{algorithm}}));}
const {algorithm}=Astro.props;
---
<BaseLayout title={algorithm.name} description={algorithm.summary} wide><nav aria-label="Breadcrumb"><a href="/algorithms/">Algorithms</a> / <a href="/algorithms/sorting/">Sorting</a> / {algorithm.short}</nav><h1>{algorithm.name}</h1><p>{algorithm.summary}</p><Sorting selected={algorithm.slug}/><SortingLesson algorithm={algorithm}/></BaseLayout>
<style>h1{font-size:clamp(2rem,4vw,3rem)}</style>
