---
import BaseLayout from '../layouts/BaseLayout.astro';

const youtubeIdeas = [
  'Starting over with vibe coding RuneQuilt from scratch in .NET MAUI',
  'Playing through FFXIV with a new character',
  'Playing through the Final Fantasy Pixel Remaster games',
];
---

<BaseLayout
  title="Content Ideas"
  description="A working list of YouTube video and article ideas."
>
  <header class="page-header">
    <p class="eyebrow">Idea notebook</p>
    <h1>Content Ideas</h1>
    <p class="intro">
      A simple place to keep track of videos I want to make and articles I want to write.
    </p>
  </header>

  <section class="idea-section" aria-labelledby="youtube-heading">
    <div class="section-heading">
      <h2 id="youtube-heading">YouTube Videos</h2>
      <span>{youtubeIdeas.length} ideas</span>
    </div>

    <ol class="idea-list">
      {youtubeIdeas.map((idea) => (
        <li class="idea-card glass-panel">
          <span class="idea-number" aria-hidden="true"></span>
          <span>{idea}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="idea-section" aria-labelledby="articles-heading">
    <div class="section-heading">
      <h2 id="articles-heading">Articles</h2>
      <span>0 ideas</span>
    </div>

    <div class="empty-state glass-panel">
      <p>No article ideas added yet.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    margin: 1rem 0 3rem;
  }

  .eyebrow {
    margin-bottom: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 0.75rem;
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 8vw, 4rem);
    letter-spacing: -0.03em;
  }

  .intro {
    max-width: 38rem;
    margin-bottom: 0;
    color: var(--text-secondary);
    font-size: 1.1rem;
  }

  .idea-section + .idea-section {
    margin-top: 3rem;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1.25rem;
  }

  .section-heading span {
    color: var(--text-secondary);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .idea-list {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    list-style: none;
    counter-reset: ideas;
  }

  .idea-card {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    align-items: start;
    padding: 1rem 1.1rem;
    border-radius: 12px;
    counter-increment: ideas;
  }

  .idea-number::before {
    content: counter(ideas, decimal-leading-zero);
    color: var(--text-secondary);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .empty-state {
    padding: 1.25rem;
    border-radius: 12px;
    color: var(--text-secondary);
  }

  .empty-state p {
    margin: 0;
  }
</style>
