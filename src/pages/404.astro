---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Lost at sea" description="The requested page could not be found.">
  <section class="not-found shell">
    <p class="eyebrow">ERROR / 404</p>
    <div class="not-found-code" aria-hidden="true">404</div>
    <h1>Off the chart.</h1>
    <p>There’s nothing at this coordinate. The current may have moved it, or the address may be wrong.</p>
    <a class="button button-primary" href="/">Return to safe harbor <span>→</span></a>
  </section>
</BaseLayout>
