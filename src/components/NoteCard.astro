---
interface Props {
  title: string;
  description?: string;
  heroImage: string;
  heroImageAlt: string;
  slug: string;
  date: Date;
  tags: string[];
  preview: string;
}
const { title, description, heroImage, heroImageAlt, slug, date, tags, preview } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---
<div class="note-card hover-lift">
  <img
    class="card-image"
    src={heroImage}
    alt={heroImageAlt}
    width="1600"
    height="900"
    loading="lazy"
    decoding="async"
  />
  <div class="card-content">
    <div class="header-row">
      <h3 class="title"><a href={`/notes/${slug}`}>{title}</a></h3>
      <span class="date">{formattedDate}</span>
    </div>
    {description && <p class="description">{description}</p>}
    {preview && <p class="content">{preview}</p>}
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  .note-card {
    display: flex;
    flex-direction: column;
    background-color: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 0;
    margin-bottom: 1.5rem;
    color: inherit;
    position: relative;
    overflow: hidden;
  }
  .card-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--bg-color);
  }
  .card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.25rem 1.5rem 1.5rem;
  }
  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }
  .title {
    margin: 0;
    font-size: 1.25rem;
    font-family: var(--font-serif);
  }
  .title a {
    text-decoration: none;
    color: inherit;
  }
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .description {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    font-size: 1rem;
  }
  .content {
    margin: 0 0 1rem;
    line-height: 1.6;
  }
  .date {
    font-size: 0.875rem;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .tag {
    background: var(--bg-color);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  @media (max-width: 480px) {
    .header-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }
  }

  @media (min-width: 960px) {
    .note-card {
      display: grid;
      grid-template-columns: clamp(22rem, 36vw, 26rem) minmax(0, 1fr);
      min-height: 14rem;
    }

    .card-image {
      aspect-ratio: auto;
      height: 100%;
      min-height: 14rem;
    }

    .card-content {
      min-width: 0;
      padding: 1.25rem 1.5rem;
    }

    .header-row {
      align-items: flex-start;
      gap: 1rem;
    }

    .title {
      display: -webkit-box;
      line-height: 1.25;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .description {
      display: -webkit-box;
      line-height: 1.5;
      margin-bottom: 0.75rem;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }

    .content {
      display: none;
    }

    .tags {
      margin-top: auto;
      max-height: 3.5rem;
      overflow: hidden;
    }
  }
</style>
