---
interface Props {
  title: string;
  description?: string;
  slug: string;
  date: Date;
  tags: string[];
  preview: string;
}
const { title, description, slug, date, tags, preview } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---
<div class="note-card hover-lift">
  <div class="card-content">
    <div class="header-row">
      <h3 class="title"><a href={`/notes/${slug}`}>{title}</a></h3>
      <span class="date">{formattedDate}</span>
    </div>
    {description && <p class="description">{description}</p>}
    {preview && <p class="content">{preview}</p>}
    {tags.length > 0 && (
      <div class="tags">
        {tags.map((tag) => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  .note-card {
    display: block;
    background-color: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    color: inherit;
    position: relative;
  }
  .header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.5rem;
  }
  .title {
    margin: 0;
    font-size: 1.25rem;
    font-family: var(--font-serif);
  }
  .title a {
    text-decoration: none;
    color: inherit;
  }
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .description {
    color: var(--text-secondary);
    margin-bottom: 1rem;
    font-size: 1rem;
  }
  .content {
    margin: 0 0 1rem;
    line-height: 1.6;
  }
  .date {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
  .tags {
    display: flex;
    gap: 0.5rem;
  }
  .tag {
    background: var(--bg-color);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }
</style>
