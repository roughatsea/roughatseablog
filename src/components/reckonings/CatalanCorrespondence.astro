---
const expressions = [
  '((a ★ b) ★ c) ★ d',
  '(a ★ (b ★ c)) ★ d',
  '(a ★ b) ★ (c ★ d)',
  'a ★ ((b ★ c) ★ d)',
  'a ★ (b ★ (c ★ d))',
];
---

<figure class="catalan-lab reckoning-visual" data-catalan-lab>
  <header>
    <p>Catalan correspondence</p>
    <h3>Step through the five structures</h3>
  </header>

  <div class="selector" role="group" aria-label="Choose one of the five Catalan structures">
    {expressions.map((expression, index) => (
      <button
        type="button"
        data-choice={index}
        aria-pressed={index === 0 ? 'true' : 'false'}
        aria-label={`Show structure ${index + 1}: ${expression}`}
      >
        {index + 1}
      </button>
    ))}
  </div>

  <div class="panels">
    <section class="expression-panel" aria-labelledby="catalan-expression-heading">
      <p id="catalan-expression-heading">Parenthesization</p>
      <output data-expression aria-live="polite">{expressions[0]}</output>
      <div class="split-key" aria-hidden="true">
        <span>left subtree</span>
        <i>★</i>
        <span>right subtree</span>
      </div>
      <p class="panel-note">Every pair of parentheses records one binary combine.</p>
    </section>

    <section class="polygon-panel" aria-labelledby="catalan-polygon-heading">
      <p id="catalan-polygon-heading">Pentagon triangulation</p>
      <svg viewBox="0 0 420 330" role="img" aria-labelledby="catalan-svg-title catalan-svg-desc">
        <title id="catalan-svg-title">One of five triangulations of a pentagon</title>
        <desc id="catalan-svg-desc">A convex pentagon has two noncrossing diagonals. The selected pair changes as the numbered controls are activated.</desc>
        <defs>
          <pattern id="catalan-grid" width="26" height="26" patternUnits="userSpaceOnUse">
            <path d="M26 0H0V26" fill="none" />
          </pattern>
        </defs>
        <rect class="plot-bg" width="420" height="330" rx="16" />
        <rect class="grid" width="420" height="330" rx="16" fill="url(#catalan-grid)" />
        <polygon class="polygon-fill" points="210,32 364,144 305,286 115,286 56,144" />
        <polygon class="polygon-edge" points="210,32 364,144 305,286 115,286 56,144" />
        <line class="diagonal diagonal-a" data-diagonal-a x1="210" y1="32" x2="305" y2="286" />
        <line class="diagonal diagonal-b" data-diagonal-b x1="210" y1="32" x2="115" y2="286" />
        <g class="vertices" aria-hidden="true">
          <circle cx="210" cy="32" r="8" /><circle cx="364" cy="144" r="8" />
          <circle cx="305" cy="286" r="8" /><circle cx="115" cy="286" r="8" />
          <circle cx="56" cy="144" r="8" />
        </g>
      </svg>
      <p class="panel-note">Two diagonals divide the pentagon into three triangles.</p>
    </section>
  </div>

  <p class="status" data-status aria-live="polite">
    Structure 1 of 5. The two diagonals share the pentagon's top vertex.
  </p>

  <figcaption>
    <strong>What to notice:</strong> four symbols joined by a binary operation have five complete parenthesizations, and a pentagon has five triangulations. The controls display the two five-item lists in parallel; the shared recurrence below, rather than the display order, proves that the totals agree. Solid polygon edges and dashed diagonals keep the construction legible without relying on color.
  </figcaption>
</figure>

<script>
  const expressions = [
    '((a ★ b) ★ c) ★ d',
    '(a ★ (b ★ c)) ★ d',
    '(a ★ b) ★ (c ★ d)',
    'a ★ ((b ★ c) ★ d)',
    'a ★ (b ★ (c ★ d))',
  ];

  const points = [
    [210, 32],
    [364, 144],
    [305, 286],
    [115, 286],
    [56, 144],
  ];

  const triangulations = [
    [[0, 2], [0, 3]],
    [[0, 2], [2, 4]],
    [[0, 3], [1, 3]],
    [[1, 3], [1, 4]],
    [[1, 4], [2, 4]],
  ];

  const descriptions = [
    "The two diagonals share the pentagon's top vertex.",
    'One diagonal leaves the top vertex; the other leaves the lower-right vertex.',
    'One diagonal leaves the top vertex; the other leaves the upper-right vertex.',
    'The two diagonals share the pentagon\'s upper-right vertex.',
    'The two diagonals meet at the pentagon\'s upper-left vertex.',
  ];

  document.querySelectorAll('[data-catalan-lab]').forEach((figure) => {
    const buttons = Array.from(figure.querySelectorAll('[data-choice]'));
    const expression = figure.querySelector('[data-expression]');
    const diagonalA = figure.querySelector('[data-diagonal-a]');
    const diagonalB = figure.querySelector('[data-diagonal-b]');
    const status = figure.querySelector('[data-status]');

    if (!(expression instanceof HTMLOutputElement) || !(diagonalA instanceof SVGLineElement)) return;
    if (!(diagonalB instanceof SVGLineElement) || !(status instanceof HTMLElement)) return;

    const setLine = (line: SVGLineElement, endpoints: number[]) => {
      const [start, end] = endpoints;
      const [x1, y1] = points[start];
      const [x2, y2] = points[end];
      line.setAttribute('x1', String(x1));
      line.setAttribute('y1', String(y1));
      line.setAttribute('x2', String(x2));
      line.setAttribute('y2', String(y2));
    };

    const show = (index: number) => {
      expression.textContent = expressions[index];
      setLine(diagonalA, triangulations[index][0]);
      setLine(diagonalB, triangulations[index][1]);
      status.textContent = `Structure ${index + 1} of 5. ${descriptions[index]}`;
      buttons.forEach((button, buttonIndex) => {
        button.setAttribute('aria-pressed', buttonIndex === index ? 'true' : 'false');
      });
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => show(index));
    });
  });
</script>

<style>
  .catalan-lab {
    margin: 2.25rem 0;
    overflow: hidden;
    border: 1px solid rgba(0, 229, 255, 0.3);
    border-radius: 18px;
    background: linear-gradient(145deg, rgba(3, 18, 34, 0.98), rgba(7, 29, 47, 0.94));
    box-shadow: 0 22px 54px rgba(0, 0, 0, 0.28);
  }
  header { padding: 1.2rem 1.25rem 0.55rem; }
  header p,
  section > p:first-child {
    margin: 0 0 0.3rem;
    color: #a8ff60;
    font: 700 0.74rem/1.2 var(--font-mono, monospace);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  header h3 {
    margin: 0;
    color: #f4fbff;
    font-size: clamp(1.08rem, 2.4vw, 1.42rem);
    line-height: 1.25;
  }
  .selector {
    display: flex;
    gap: 0.55rem;
    padding: 0.7rem 1.25rem 1rem;
  }
  button {
    width: 2.35rem;
    height: 2.35rem;
    border: 1px solid rgba(177, 216, 230, 0.42);
    border-radius: 50%;
    background: rgba(8, 35, 55, 0.82);
    color: #dff7ff;
    font: 700 0.82rem/1 var(--font-mono, monospace);
    cursor: pointer;
  }
  button:hover,
  button:focus-visible,
  button[aria-pressed='true'] {
    border-color: #a8ff60;
    color: #a8ff60;
    outline: none;
    box-shadow: 0 0 0 3px rgba(168, 255, 96, 0.15);
  }
  .panels {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 0.9rem;
    padding: 0 1.25rem;
  }
  section {
    min-width: 0;
    border: 1px solid rgba(157, 211, 229, 0.25);
    border-radius: 14px;
    background: rgba(3, 19, 33, 0.74);
    padding: 1rem;
  }
  output {
    display: grid;
    min-height: 10rem;
    place-items: center;
    color: #f5fbff;
    font: 700 clamp(1.05rem, 2.8vw, 1.55rem)/1.5 var(--font-mono, monospace);
    text-align: center;
  }
  .split-key {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 0.5rem;
    align-items: center;
    color: #8ee9ff;
    font: 0.72rem/1.3 var(--font-mono, monospace);
    text-align: center;
  }
  .split-key span {
    border-top: 2px dashed #ff58c8;
    padding-top: 0.45rem;
  }
  .split-key i {
    color: #a8ff60;
    font-style: normal;
    font-size: 1.25rem;
  }
  svg { display: block; width: 100%; height: auto; }
  .plot-bg { fill: #031321; }
  .grid { opacity: 0.35; }
  pattern path { stroke: rgba(77, 160, 187, 0.22); stroke-width: 1; }
  .polygon-fill { fill: rgba(20, 147, 255, 0.08); }
  .polygon-edge {
    fill: none;
    stroke: #8ee9ff;
    stroke-width: 5;
    stroke-linejoin: round;
  }
  .diagonal {
    stroke: #ff58c8;
    stroke-width: 4;
    stroke-dasharray: 12 8;
    stroke-linecap: round;
  }
  .vertices circle { fill: #061726; stroke: #a8ff60; stroke-width: 4; }
  .panel-note,
  .status {
    color: #b9d2dd;
    font: 0.82rem/1.5 var(--font-sans, sans-serif);
  }
  .panel-note { margin: 0.65rem 0 0; }
  .status {
    margin: 0;
    padding: 0.9rem 1.25rem 0;
    color: #dff7ff;
  }
  figcaption {
    margin-top: 1rem;
    border-top: 1px solid rgba(157, 211, 229, 0.2);
    padding: 1rem 1.25rem 1.2rem;
    color: #b9d2dd;
    font-size: 0.82rem;
    line-height: 1.55;
  }
  figcaption strong { color: #f4fbff; }
  @media (max-width: 680px) {
    .panels { grid-template-columns: 1fr; }
    output { min-height: 7rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
  }
</style>
