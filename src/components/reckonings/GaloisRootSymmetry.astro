---
const roots = [
  { id: 'r1', expression: '\u221a3 + \u221a2', value: Math.sqrt(3) + Math.sqrt(2), s3: 1, s2: 1 },
  { id: 'r2', expression: '\u221a3 \u2212 \u221a2', value: Math.sqrt(3) - Math.sqrt(2), s3: 1, s2: -1 },
  { id: 'r3', expression: '\u2212\u221a3 + \u221a2', value: -Math.sqrt(3) + Math.sqrt(2), s3: -1, s2: 1 },
  { id: 'r4', expression: '\u2212\u221a3 \u2212 \u221a2', value: -Math.sqrt(3) - Math.sqrt(2), s3: -1, s2: -1 },
];

const xFor = (value: number) => 70 + ((value + 3.5) / 7) * 660;
---

<figure class="root-lab" data-root-lab>
  <div class="lab-heading">
    <div>
      <p class="eyebrow">ROOT-SYMMETRY WORKBENCH</p>
      <h3>Permute the roots without breaking their algebra</h3>
    </div>
    <p class="equation" aria-label="x to the fourth minus ten x squared plus one equals zero">
      x<sup>4</sup> − 10x<sup>2</sup> + 1 = 0
    </p>
  </div>

  <div class="plot-shell">
    <svg
      viewBox="0 0 800 330"
      role="img"
      aria-labelledby="galois-plot-title galois-plot-desc"
    >
      <title id="galois-plot-title">Four roots on a number line</title>
      <desc id="galois-plot-desc">
        Four fixed root positions lie at approximately negative 3.146, negative 0.318,
        positive 0.318, and positive 3.146. Colored tokens move between those positions when
        either square-root sign is flipped.
      </desc>
      <defs>
        <pattern id="galois-grid" width="32" height="32" patternUnits="userSpaceOnUse">
          <path d="M 32 0 L 0 0 0 32" fill="none" stroke="rgba(85,219,255,.09)" stroke-width="1" />
        </pattern>
        <filter id="galois-glow" x="-80%" y="-80%" width="260%" height="260%">
          <feGaussianBlur stdDeviation="4" result="blur" />
          <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>

      <rect width="800" height="330" rx="16" fill="#06111f" />
      <rect width="800" height="330" rx="16" fill="url(#galois-grid)" />
      <line x1="70" y1="176" x2="730" y2="176" class="axis" />

      {[-3, -2, -1, 0, 1, 2, 3].map((tick) => (
        <g>
          <line x1={xFor(tick)} y1="167" x2={xFor(tick)} y2="185" class="tick" />
          <text x={xFor(tick)} y="211" class="tick-label">{tick}</text>
        </g>
      ))}

      {roots.map((root) => (
        <g class="root-station">
          <line x1={xFor(root.value)} y1="139" x2={xFor(root.value)} y2="176" />
          <circle cx={xFor(root.value)} cy="176" r="7" />
          <text x={xFor(root.value)} y="245" class="root-expression">{root.expression}</text>
          <text x={xFor(root.value)} y="270" class="root-value">{root.value.toFixed(3)}</text>
        </g>
      ))}

      {roots.map((root, index) => (
        <g
          class="root-token"
          data-root-token
          data-origin={root.id}
          data-s3={root.s3}
          data-s2={root.s2}
          transform={`translate(${xFor(root.value)} 118)`}
        >
          <circle r="20" />
          <text y="1">r{index + 1}</text>
        </g>
      ))}

      <text x="400" y="307" class="axis-caption">
        Fixed root positions; the labeled tokens show which root maps where
      </text>
    </svg>
  </div>

  <div class="controls" aria-label="Root symmetry controls">
    <button type="button" data-flip="s2">
      Flip the sign of <span aria-hidden="true">√2</span><span class="sr-only">square root of two</span>
    </button>
    <button type="button" data-flip="s3">
      Flip the sign of <span aria-hidden="true">√3</span><span class="sr-only">square root of three</span>
    </button>
    <button type="button" class="reset" data-reset>Reset</button>
  </div>

  <div class="readout" aria-live="polite" aria-atomic="true">
    <span class="readout-label">Current symmetry</span>
    <strong data-operation>Identity: every root stays put</strong>
    <span data-mapping>r1 → r1, r2 → r2, r3 → r3, r4 → r4</span>
  </div>

  <figcaption>
    The four roots of <span class="nowrap">x<sup>4</sup> − 10x<sup>2</sup> + 1</span> are
    <span class="nowrap">±√3 ± √2</span>. Each button changes one square-root sign.
    The tokens move, but addition, multiplication, rational numbers, and the polynomial equation
    remain intact. Try the two flips in either order: this quartet of symmetries commutes.
  </figcaption>
</figure>

<script>
  const lab = document.querySelector<HTMLElement>('[data-root-lab]');

  if (lab) {
    const rootLab = lab;
    const rootData = [
      { id: 'r1', s3: 1, s2: 1, value: Math.sqrt(3) + Math.sqrt(2) },
      { id: 'r2', s3: 1, s2: -1, value: Math.sqrt(3) - Math.sqrt(2) },
      { id: 'r3', s3: -1, s2: 1, value: -Math.sqrt(3) + Math.sqrt(2) },
      { id: 'r4', s3: -1, s2: -1, value: -Math.sqrt(3) - Math.sqrt(2) },
    ];
    const tokens = Array.from(rootLab.querySelectorAll<SVGGElement>('[data-root-token]'));
    const operation = rootLab.querySelector<HTMLElement>('[data-operation]');
    const mapping = rootLab.querySelector<HTMLElement>('[data-mapping]');
    let flipS2 = false;
    let flipS3 = false;

    const xForValue = (value: number) => 70 + ((value + 3.5) / 7) * 660;

    function destination(s3: number, s2: number) {
      const nextS3 = flipS3 ? -s3 : s3;
      const nextS2 = flipS2 ? -s2 : s2;
      return rootData.find((root) => root.s3 === nextS3 && root.s2 === nextS2)!;
    }

    function update() {
      const pairs: string[] = [];

      for (const token of tokens) {
        const origin = token.dataset.origin!;
        const target = destination(Number(token.dataset.s3), Number(token.dataset.s2));
        token.setAttribute('transform', `translate(${xForValue(target.value)} 118)`);
        pairs.push(`${origin} \u2192 ${target.id}`);
      }

      if (operation) {
        if (flipS2 && flipS3) operation.textContent = 'Both signs flipped';
        else if (flipS2) operation.textContent = 'Sign of \u221a2 flipped';
        else if (flipS3) operation.textContent = 'Sign of \u221a3 flipped';
        else operation.textContent = 'Identity: every root stays put';
      }
      if (mapping) mapping.textContent = pairs.join(', ');

      rootLab.querySelectorAll<HTMLButtonElement>('[data-flip]').forEach((button) => {
        const active = button.dataset.flip === 's2' ? flipS2 : flipS3;
        button.setAttribute('aria-pressed', String(active));
      });
    }

    rootLab.querySelectorAll<HTMLButtonElement>('[data-flip]').forEach((button) => {
      button.addEventListener('click', () => {
        if (button.dataset.flip === 's2') flipS2 = !flipS2;
        if (button.dataset.flip === 's3') flipS3 = !flipS3;
        update();
      });
    });

    rootLab.querySelector<HTMLButtonElement>('[data-reset]')?.addEventListener('click', () => {
      flipS2 = false;
      flipS3 = false;
      update();
    });

    update();
  }
</script>

<style>
  .root-lab {
    background: linear-gradient(145deg, rgba(6, 17, 31, 0.98), rgba(8, 26, 43, 0.96));
    border: 1px solid rgba(85, 219, 255, 0.28);
    border-radius: 16px;
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.28);
    color: #e9f8ff;
    margin: 2rem 0 2.4rem;
    overflow: hidden;
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .lab-heading {
    align-items: end;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .eyebrow {
    color: #55dbff;
    font: 700 0.67rem/1.2 var(--font-sans);
    letter-spacing: 0.16em;
    margin: 0 0 0.35rem;
  }

  h3 {
    color: #f4fbff;
    font: 600 clamp(1rem, 3vw, 1.25rem)/1.3 var(--font-sans);
    margin: 0;
  }

  .equation {
    color: #93ff14;
    flex: none;
    font: 600 1rem/1.3 var(--font-mono, ui-monospace, monospace);
    margin: 0;
  }

  .plot-shell {
    border: 1px solid rgba(147, 255, 20, 0.16);
    border-radius: 16px;
    overflow: hidden;
  }

  svg {
    display: block;
    height: auto;
    width: 100%;
  }

  .axis,
  .tick {
    stroke: rgba(230, 248, 255, 0.68);
    stroke-width: 2;
  }

  .tick-label,
  .root-value,
  .axis-caption {
    fill: rgba(220, 242, 250, 0.72);
    font-family: var(--font-mono, ui-monospace, monospace);
    text-anchor: middle;
  }

  .tick-label { font-size: 15px; }
  .root-value { font-size: 13px; }
  .axis-caption { font-size: 12px; letter-spacing: 0.04em; }

  .root-station line {
    stroke: rgba(85, 219, 255, 0.36);
    stroke-dasharray: 4 5;
  }

  .root-station circle {
    fill: #06111f;
    stroke: #55dbff;
    stroke-width: 2;
  }

  .root-expression {
    fill: #f0fbff;
    font-family: var(--font-serif);
    font-size: 15px;
    text-anchor: middle;
  }

  .root-token {
    filter: url(#galois-glow);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .root-token[data-origin='r1'] circle { fill: #ff1493; }
  .root-token[data-origin='r2'] circle { fill: #93ff14; }
  .root-token[data-origin='r3'] circle { fill: #55dbff; }
  .root-token[data-origin='r4'] circle { fill: #ffca3a; }

  .root-token text {
    fill: #04101b;
    font: 800 13px/1 var(--font-sans);
    text-anchor: middle;
    dominant-baseline: middle;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1rem;
  }

  button {
    background: rgba(85, 219, 255, 0.08);
    border: 1px solid rgba(85, 219, 255, 0.36);
    border-radius: 999px;
    color: #eefaff;
    cursor: pointer;
    font: 650 0.82rem/1.2 var(--font-sans);
    padding: 0.65rem 0.9rem;
  }

  button:hover,
  button:focus-visible {
    background: rgba(85, 219, 255, 0.17);
    border-color: #55dbff;
    outline: none;
  }

  button[aria-pressed='true'] {
    background: rgba(147, 255, 20, 0.16);
    border-color: #93ff14;
    color: #cfff9a;
  }

  button.reset {
    border-color: rgba(255, 20, 147, 0.45);
    color: #ff9bd2;
  }

  .readout {
    background: rgba(0, 0, 0, 0.18);
    border-left: 3px solid #ff1493;
    display: grid;
    gap: 0.22rem;
    margin-top: 1rem;
    padding: 0.75rem 0.9rem;
  }

  .readout-label {
    color: rgba(220, 242, 250, 0.64);
    font: 700 0.62rem/1.2 var(--font-sans);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .readout strong { color: #f8fdff; font-family: var(--font-sans); }
  .readout [data-mapping] { color: #aeeeff; font: 0.78rem/1.45 var(--font-mono, ui-monospace, monospace); }

  figcaption {
    color: rgba(222, 241, 248, 0.75);
    font: 0.82rem/1.55 var(--font-sans);
    margin-top: 0.9rem;
  }

  .nowrap { white-space: nowrap; }
  .sr-only {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  @media (max-width: 680px) {
    .lab-heading { align-items: start; flex-direction: column; }
    .equation { font-size: 0.9rem; }
    .root-expression { font-size: 12px; }
    .root-value { display: none; }
    .controls button { flex: 1 1 10rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .root-token { transition: none; }
  }
</style>
