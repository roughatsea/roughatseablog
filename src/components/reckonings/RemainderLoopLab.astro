<section class="remainder-lab" data-remainder-lab aria-labelledby="remainder-lab-title">
  <div class="lab-heading">
    <div>
      <p class="eyebrow">Long division, one state at a time</p>
      <h3 id="remainder-lab-title">Follow the remainder</h3>
    </div>
    <p class="fraction-readout" aria-live="polite"><span data-fraction>1/7</span> = <span data-decimal>0.142857…</span></p>
  </div>

  <div class="presets" aria-label="Choose a fraction">
    <button type="button" data-preset="1/7" aria-pressed="true">1/7 · six-step loop</button>
    <button type="button" data-preset="1/6" aria-pressed="false">1/6 · one repeating digit</button>
    <button type="button" data-preset="5/12" aria-pressed="false">5/12 · delayed loop</button>
    <button type="button" data-preset="1/8" aria-pressed="false">1/8 · terminates</button>
  </div>

  <div class="machine" aria-describedby="remainder-caption">
    <div class="machine-rule" aria-label="The long division transition rule">
      <span>current remainder</span>
      <span aria-hidden="true">× 10</span>
      <span>= denominator × next digit + next remainder</span>
    </div>
    <ol class="steps" data-steps aria-label="Long division steps"></ol>
    <div class="controls">
      <button type="button" class="control" data-next>Reveal next step</button>
      <button type="button" class="control secondary" data-reset>Reset</button>
      <p class="status" data-status aria-live="polite"></p>
    </div>
  </div>

  <p id="remainder-caption" class="caption"><strong>What to notice:</strong> a repeated remainder creates a loop because it forces the same next digit and next remainder. Remainder zero ends the process. The cards use words, equations, and borders as well as color.</p>
</section>

<script>
  const labs = document.querySelectorAll<HTMLElement>('[data-remainder-lab]');

  for (const lab of labs) {
    const presets: Record<string, { p: number; q: number; display: string }> = {
      '1/7': { p: 1, q: 7, display: '0.142857…' },
      '1/6': { p: 1, q: 6, display: '0.1666…' },
      '5/12': { p: 5, q: 12, display: '0.41666…' },
      '1/8': { p: 1, q: 8, display: '0.125' },
    };

    const stepsList = lab.querySelector<HTMLOListElement>('[data-steps]');
    const fractionReadout = lab.querySelector<HTMLElement>('[data-fraction]');
    const decimalReadout = lab.querySelector<HTMLElement>('[data-decimal]');
    const status = lab.querySelector<HTMLElement>('[data-status]');
    const nextButton = lab.querySelector<HTMLButtonElement>('[data-next]');
    const resetButton = lab.querySelector<HTMLButtonElement>('[data-reset]');
    const presetButtons = [...lab.querySelectorAll<HTMLButtonElement>('[data-preset]')];
    let chosen = '1/7';
    let visible = 1;

    const calculate = (p: number, q: number) => {
      const seen = new Map<number, number>();
      const steps: Array<{ remainder: number; scaled: number; digit: number; next: number; repeatAt: number | null }> = [];
      let remainder = p % q;

      while (!seen.has(remainder) && remainder !== 0 && steps.length < q + 1) {
        seen.set(remainder, steps.length);
        const scaled = remainder * 10;
        const digit = Math.floor(scaled / q);
        const next = scaled % q;
        steps.push({ remainder, scaled, digit, next, repeatAt: null });
        remainder = next;
      }

      if (steps.length > 0 && remainder !== 0) {
        steps[steps.length - 1].repeatAt = seen.get(remainder) ?? null;
      }

      return { steps, terminated: remainder === 0, loopStart: seen.get(remainder) ?? null };
    };

    const render = () => {
      const preset = presets[chosen];
      const result = calculate(preset.p, preset.q);
      const shown = result.steps.slice(0, visible);
      if (!stepsList || !fractionReadout || !decimalReadout || !status || !nextButton) return;

      fractionReadout.textContent = chosen;
      decimalReadout.textContent = preset.display;
      stepsList.innerHTML = shown.map((step, index) => {
        const isFinalShown = index === shown.length - 1;
        const completes = isFinalShown && visible >= result.steps.length;
        const outcome = completes
          ? result.terminated
            ? '<span class="outcome stop">remainder 0 · stop</span>'
            : `<span class="outcome loop">remainder ${step.next} · loop</span>`
          : `<span class="outcome">next remainder ${step.next}</span>`;
        return `<li class="step-card${completes ? ' complete' : ''}">
          <span class="step-number">Step ${index + 1}</span>
          <strong>Remainder ${step.remainder}</strong>
          <code>${step.scaled} = ${preset.q} × ${step.digit} + ${step.next}</code>
          <span class="digit">write digit <b>${step.digit}</b></span>
          ${outcome}
        </li>`;
      }).join('');

      const done = visible >= result.steps.length;
      nextButton.disabled = done;
      nextButton.textContent = done ? (result.terminated ? 'Decimal terminated' : 'Remainder loop found') : 'Reveal next step';
      status.textContent = done
        ? result.terminated
          ? `Remainder zero ends the decimal after ${result.steps.length} step${result.steps.length === 1 ? '' : 's'}.`
          : `The next remainder repeats remainder ${result.steps[result.steps.length - 1].next}; the decimal now cycles.`
        : `${visible} of ${result.steps.length} steps shown.`;
    };

    for (const button of presetButtons) {
      button.addEventListener('click', () => {
        chosen = button.dataset.preset || '1/7';
        visible = 1;
        for (const candidate of presetButtons) candidate.setAttribute('aria-pressed', String(candidate === button));
        render();
      });
    }

    nextButton?.addEventListener('click', () => {
      visible += 1;
      render();
    });

    resetButton?.addEventListener('click', () => {
      visible = 1;
      render();
    });

    render();
  }
</script>

<style>
  .remainder-lab {
    background: linear-gradient(145deg, rgba(3, 17, 28, .96), rgba(7, 28, 41, .9));
    border: 1px solid rgba(84, 226, 255, .28);
    border-radius: 1rem;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .025), 0 1.2rem 3rem rgba(0, 0, 0, .18);
    color: #e8f8ff;
    margin: 2rem 0;
    overflow: hidden;
    padding: clamp(1rem, 3vw, 1.6rem);
  }

  .lab-heading { align-items: end; display: flex; gap: 1rem; justify-content: space-between; }
  .eyebrow { color: #90f5ff; font: 700 .72rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .13em; margin: 0 0 .35rem; text-transform: uppercase; }
  h3 { color: #fff; font-size: clamp(1.35rem, 3vw, 1.8rem); margin: 0; }
  .fraction-readout { color: #c9ff5a; font: 700 clamp(1rem, 2.8vw, 1.35rem)/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; margin: 0; text-align: right; }
  .presets { display: flex; flex-wrap: wrap; gap: .55rem; margin: 1.25rem 0; }
  button { font: inherit; }
  .presets button, .control { background: rgba(9, 42, 58, .88); border: 1px solid rgba(144, 245, 255, .35); border-radius: 999px; color: #dffaff; cursor: pointer; padding: .55rem .8rem; }
  .presets button[aria-pressed='true'] { background: #c9ff5a; border-color: #c9ff5a; color: #08141c; font-weight: 750; }
  button:focus-visible { outline: 3px solid #ff5edb; outline-offset: 3px; }
  .machine { background: rgba(0, 9, 17, .45); border: 1px solid rgba(255, 255, 255, .08); border-radius: .8rem; padding: 1rem; }
  .machine-rule { align-items: center; color: #acd6e2; display: grid; font: 650 .78rem/1.35 ui-monospace, SFMono-Regular, Menlo, monospace; gap: .5rem; grid-template-columns: 1fr auto 2fr; text-align: center; }
  .machine-rule span { border-bottom: 1px dashed rgba(144, 245, 255, .28); padding: .35rem; }
  .steps { display: grid; gap: .7rem; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); list-style: none; margin: 1rem 0; padding: 0; }
  .step-card { background: #071c29; border: 1px solid rgba(144, 245, 255, .24); border-top: 3px solid #54e2ff; border-radius: .7rem; display: grid; gap: .35rem; min-width: 0; padding: .75rem; }
  .step-card.complete { border-style: dashed; border-top-style: solid; }
  .step-number { color: #8cbdca; font: 700 .68rem/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .09em; text-transform: uppercase; }
  .step-card strong { color: #fff; }
  code { color: #dffaff; font-size: .78rem; overflow-wrap: anywhere; }
  .digit { color: #bad3db; font-size: .82rem; }
  .digit b { color: #c9ff5a; font-size: 1.25rem; }
  .outcome { color: #90f5ff; font-size: .75rem; }
  .outcome.loop { color: #ff9bea; font-weight: 750; }
  .outcome.stop { color: #c9ff5a; font-weight: 750; }
  .controls { align-items: center; display: flex; flex-wrap: wrap; gap: .6rem; }
  .control { background: #54e2ff; border-color: #54e2ff; color: #06131a; font-weight: 750; }
  .control.secondary { background: transparent; color: #dffaff; }
  .control:disabled { cursor: default; opacity: .64; }
  .status { color: #b9d6df; flex: 1 1 16rem; font-size: .82rem; margin: 0; }
  .caption { color: #b9d6df; font-size: .84rem; line-height: 1.55; margin: 1rem 0 0; }
  .caption strong { color: #fff; }

  @media (max-width: 600px) {
    .lab-heading { align-items: start; flex-direction: column; }
    .fraction-readout { text-align: left; }
    .machine-rule { grid-template-columns: 1fr; text-align: left; }
    .machine-rule span { padding-inline: 0; }
    .presets { display: grid; grid-template-columns: 1fr; }
    .presets button { text-align: left; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; }
  }
</style>

