---
const days = Array.from({ length: 11 }, (_, day) => day);
const fromSunny = days.map((day) => 2 / 3 + (1 / 3) * 0.4 ** day);
const fromRainy = days.map((day) => 2 / 3 - (2 / 3) * 0.4 ** day);
const x = (day: number) => 105 + day * 73;
const y = (probability: number) => 475 - probability * 235;
const sunnyPath = fromSunny.map((probability, day) => `${day === 0 ? 'M' : 'L'}${x(day)} ${y(probability)}`).join(' ');
const rainyPath = fromRainy.map((probability, day) => `${day === 0 ? 'M' : 'L'}${x(day)} ${y(probability)}`).join(' ');
---

<figure class="markov-lab reckoning-visual" data-markov-lab data-day="0">
  <header>
    <p>Interactive probability forecast</p>
    <h3>Two forecasts forget two different beginnings</h3>
  </header>

  <div class="diagram-shell">
    <svg viewBox="0 0 940 540" role="img" aria-labelledby="markov-title markov-desc">
      <title id="markov-title">A two-state weather chain and two forecasts converging toward the same probability</title>
      <desc id="markov-desc">
        Sunny weather remains sunny with probability eighty percent and becomes rainy with probability
        twenty percent. Rainy weather becomes sunny with probability forty percent and remains rainy
        with probability sixty percent. Below the state diagram, one forecast begins certainly sunny and
        another certainly rainy. Both approach a two-thirds chance of sun.
      </desc>

      <g class="state-panel" aria-hidden="true">
        <text class="panel-label" x="470" y="31" text-anchor="middle">ONE-DAY TRANSITIONS</text>
        <circle class="state sunny" cx="280" cy="125" r="58" />
        <circle class="state rainy" cx="660" cy="125" r="58" />
        <text class="state-name" x="280" y="131" text-anchor="middle">SUNNY</text>
        <text class="state-name" x="660" y="131" text-anchor="middle">RAINY</text>

        <path class="transition blue" d="M337 112C430 62 510 62 603 112" />
        <path class="arrow blue" d="m591 100 12 12-17 3" />
        <text class="probability blue-text" x="470" y="66" text-anchor="middle">20%</text>

        <path class="transition green" d="M603 140C510 190 430 190 337 140" />
        <path class="arrow green" d="m349 152-12-12 17-3" />
        <text class="probability green-text" x="470" y="192" text-anchor="middle">40%</text>

        <path class="transition pink" d="M252 70C203 13 174 70 226 91" />
        <path class="arrow pink" d="m210 91 16 0-7-14" />
        <text class="probability pink-text" x="184" y="48">80%</text>

        <path class="transition gray" d="M688 70C737 13 766 70 714 91" />
        <path class="arrow gray" d="m730 91-16 0 7-14" />
        <text class="probability" x="735" y="48">60%</text>
      </g>

      <g class="plot" aria-hidden="true">
        <text class="panel-label" x="470" y="237" text-anchor="middle">CHANCE OF SUN AFTER EACH DAY</text>
        <path class="axis" d="M105 240V475H855" />
        {[0, .25, .5, .75, 1].map((tick) => (
          <g>
            <path class="grid" d={`M105 ${y(tick)}H855`} />
            <text class="tick" x="88" y={y(tick) + 5} text-anchor="end">{Math.round(tick * 100)}%</text>
          </g>
        ))}
        {days.map((day) => <text class="tick" x={x(day)} y="505" text-anchor="middle">{day}</text>)}
        <text class="axis-title" x="480" y="528" text-anchor="middle">days elapsed</text>

        <path class="equilibrium" d={`M105 ${y(2 / 3)}H855`} />
        <text class="equilibrium-label" x="846" y={y(2 / 3) - 9} text-anchor="end">equilibrium = 66⅔%</text>
        <path class="trajectory sunny-line" d={sunnyPath} />
        <path class="trajectory rainy-line" d={rainyPath} />
        <path class="day-guide" data-day-guide d={`M${x(0)} 240V475`} />

        {fromSunny.map((probability, day) => <circle class="point sunny-point" data-sunny-point={day} cx={x(day)} cy={y(probability)} r="5" />)}
        {fromRainy.map((probability, day) => <circle class="point rainy-point" data-rainy-point={day} cx={x(day)} cy={y(probability)} r="5" />)}
        <path class="selected sunny-diamond" data-sunny-selected d={`M${x(0)} ${y(fromSunny[0]) - 10}l10 10-10 10-10-10z`} />
        <path class="selected rainy-diamond" data-rainy-selected d={`M${x(0)} ${y(fromRainy[0]) - 10}l10 10-10 10-10-10z`} />
      </g>
    </svg>
  </div>

  <div class="readout" aria-live="polite">
    <div>
      <span>Day <strong data-day-count>0</strong></span>
      <p>Started sunny: <strong class="pink-text" data-sunny-value>100.00%</strong></p>
    </div>
    <div>
      <span>Same transition rules</span>
      <p>Started rainy: <strong class="green-text" data-rainy-value>0.00%</strong></p>
    </div>
    <p class="gap">Gap: <strong data-gap-value>100.00 percentage points</strong></p>
  </div>

  <div class="controls">
    <button type="button" data-next-day>Advance one day</button>
    <button type="button" class="secondary" data-reset-day disabled>Reset</button>
  </div>

  <figcaption>
    <strong>What to notice:</strong> the magenta forecast begins at 100% sunny and the green forecast
    begins at 0%. The gap shrinks by a factor of 0.4 each day; both paths approach 66⅔%.
    Color and marker shape distinguish the two paths.
  </figcaption>
</figure>

<script>
  document.querySelectorAll('[data-markov-lab]').forEach((figure) => {
    const next = figure.querySelector('[data-next-day]');
    const reset = figure.querySelector('[data-reset-day]');
    const count = figure.querySelector('[data-day-count]');
    const sunnyValue = figure.querySelector('[data-sunny-value]');
    const rainyValue = figure.querySelector('[data-rainy-value]');
    const gapValue = figure.querySelector('[data-gap-value]');
    const guide = figure.querySelector('[data-day-guide]');
    const sunnyDiamond = figure.querySelector('[data-sunny-selected]');
    const rainyDiamond = figure.querySelector('[data-rainy-selected]');
    if (!(next instanceof HTMLButtonElement)
      || !(reset instanceof HTMLButtonElement)
      || !(guide instanceof SVGPathElement)
      || !(sunnyDiamond instanceof SVGPathElement)
      || !(rainyDiamond instanceof SVGPathElement)
      || !count || !sunnyValue || !rainyValue || !gapValue) return;

    const chartX = (day: number) => 105 + day * 73;
    const chartY = (probability: number) => 475 - probability * 235;
    let day = 0;

    const render = () => {
      const sunny = 2 / 3 + (1 / 3) * 0.4 ** day;
      const rainy = 2 / 3 - (2 / 3) * 0.4 ** day;
      const guideX = chartX(day);
      const sunnyY = chartY(sunny);
      const rainyY = chartY(rainy);
      figure.setAttribute('data-day', String(day));
      count.textContent = String(day);
      sunnyValue.textContent = `${(sunny * 100).toFixed(2)}%`;
      rainyValue.textContent = `${(rainy * 100).toFixed(2)}%`;
      gapValue.textContent = `${((sunny - rainy) * 100).toFixed(2)} percentage points`;
      guide.setAttribute('d', `M${guideX} 240V475`);
      sunnyDiamond.setAttribute('d', `M${guideX} ${sunnyY - 10}l10 10-10 10-10-10z`);
      rainyDiamond.setAttribute('d', `M${guideX} ${rainyY - 10}l10 10-10 10-10-10z`);
      next.toggleAttribute('disabled', day === 10);
      reset.toggleAttribute('disabled', day === 0);
    };

    next.addEventListener('click', () => {
      if (day < 10) day += 1;
      render();
    });
    reset.addEventListener('click', () => {
      day = 0;
      render();
    });
  });
</script>

<style>
  .markov-lab {
    --markov-blue: #087dcc;
    --markov-green: #4f9300;
    --markov-pink: #d9007e;
    background: radial-gradient(circle at 84% 7%, color-mix(in srgb, var(--markov-blue) 12%, transparent), transparent 20rem), var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    font-family: var(--font-sans);
    margin: 2.5rem 50%;
    padding: clamp(1rem, 3vw, 1.5rem);
    transform: translateX(-50%);
    width: min(980px, calc(100vw - 3rem));
  }
  :global([data-theme='dark']) .markov-lab { --markov-blue: #1493ff; --markov-green: #93ff14; --markov-pink: #ff1493; }
  header > p { color: var(--link-color); font-size: .67rem; font-weight: 600; letter-spacing: .12em; margin: 0 0 .2rem; text-transform: uppercase; }
  h3 { font-family: var(--font-serif); font-size: clamp(1.25rem, 3vw, 1.7rem); margin: 0 0 1rem; }
  .diagram-shell { background: var(--bg-color); border: 1px solid var(--border-color); border-radius: 9px; overflow-x: auto; }
  svg { display: block; height: auto; min-width: 700px; width: 100%; }
  .panel-label { fill: var(--text-secondary); font-size: 11px; font-weight: 700; letter-spacing: .14em; }
  .state { fill: var(--surface-color); stroke-width: 3; }
  .state.sunny { stroke: var(--markov-pink); }
  .state.rainy { stroke: var(--markov-green); }
  .state-name { fill: var(--text-primary); font-size: 14px; font-weight: 700; letter-spacing: .08em; }
  .transition, .arrow { fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-width: 2.5; }
  .blue { stroke: var(--markov-blue); }
  .green { stroke: var(--markov-green); }
  .pink { stroke: var(--markov-pink); }
  .gray { stroke: var(--text-secondary); }
  .probability { fill: var(--text-secondary); font-size: 14px; font-weight: 700; }
  .blue-text { color: var(--markov-blue); fill: var(--markov-blue); }
  .green-text { color: var(--markov-green); fill: var(--markov-green); }
  .pink-text { color: var(--markov-pink); fill: var(--markov-pink); }
  .axis { fill: none; stroke: var(--text-secondary); stroke-width: 1.7; }
  .grid { stroke: var(--border-color); stroke-width: 1; }
  .tick, .axis-title { fill: var(--text-secondary); font-size: 12px; }
  .equilibrium { stroke: var(--text-secondary); stroke-dasharray: 6 7; stroke-width: 2; }
  .equilibrium-label { fill: var(--text-secondary); font-size: 12px; font-weight: 700; }
  .trajectory { fill: none; stroke-linecap: round; stroke-linejoin: round; stroke-width: 3.5; }
  .sunny-line { stroke: var(--markov-pink); }
  .rainy-line { stroke: var(--markov-green); stroke-dasharray: 7 5; }
  .point { fill: var(--bg-color); stroke-width: 2.2; }
  .sunny-point { stroke: var(--markov-pink); }
  .rainy-point { stroke: var(--markov-green); }
  .day-guide { stroke: var(--markov-blue); stroke-dasharray: 3 6; stroke-width: 2; }
  .selected { stroke: var(--bg-color); stroke-width: 2; }
  .sunny-diamond { fill: var(--markov-pink); }
  .rainy-diamond { fill: var(--markov-green); }
  .readout { background: var(--bg-color); border: 1px solid var(--border-color); border-radius: 9px; display: grid; gap: .65rem 1rem; grid-template-columns: 1fr 1fr; margin-top: .75rem; padding: .9rem 1rem; }
  .readout div { display: grid; gap: .2rem; }
  .readout span { color: var(--text-secondary); font-size: .67rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .readout p { font-size: .86rem; margin: 0; }
  .readout .gap { border-top: 1px solid var(--border-color); color: var(--text-secondary); grid-column: 1 / -1; padding-top: .65rem; }
  .readout .gap strong { color: var(--text-primary); }
  .controls { display: flex; gap: .55rem; margin-top: .65rem; }
  .controls button { background: var(--markov-blue); border: 1px solid var(--markov-blue); border-radius: 7px; color: white; cursor: pointer; font: inherit; font-size: .82rem; font-weight: 700; padding: .58rem .9rem; }
  .controls button.secondary { background: var(--bg-color); border-color: var(--border-color); color: var(--text-secondary); }
  .controls button:focus-visible { outline: 3px solid color-mix(in srgb, var(--markov-green) 60%, transparent); outline-offset: 2px; }
  .controls button:disabled { cursor: not-allowed; opacity: .42; }
  figcaption { color: var(--text-secondary); font-size: .82rem; line-height: 1.55; margin-top: .85rem; }
  figcaption strong { color: var(--text-primary); }
  @media (max-width: 620px) {
    .markov-lab { width: calc(100vw - 1.5rem); }
    .readout { grid-template-columns: 1fr; }
    .readout .gap { grid-column: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .markov-lab * { transition: none !important; } }
</style>
