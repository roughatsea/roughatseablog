---
const x = (value: number) => 98 + value * 128;
const y = (value: number) => 384 - value * 96;
const points = Array.from({ length: 20 }, (_, index) => [index % 5, Math.floor(index / 5)]);
---

<figure class="pick-seam reckoning-visual">
  <header>
    <p>Why the count survives a cut</p>
    <h3>A shared boundary changes jobs when two pieces are glued</h3>
  </header>

  <div class="seam-shell">
    <svg viewBox="0 0 760 500" role="img" aria-labelledby="pick-seam-title pick-seam-desc">
      <title id="pick-seam-title">Two lattice rectangles joined along a vertical seam</title>
      <desc id="pick-seam-desc">
        Two rectangles of area six share a vertical seam. When joined, the two seam endpoints remain
        boundary points, while the two middle seam points become interior points. The whole rectangle
        has area twelve.
      </desc>
      <defs>
        <pattern id="seam-hatch-left" width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(35)">
          <line x1="0" y1="0" x2="0" y2="12" />
        </pattern>
        <pattern id="seam-hatch-right" width="12" height="12" patternUnits="userSpaceOnUse" patternTransform="rotate(-35)">
          <line x1="0" y1="0" x2="0" y2="12" />
        </pattern>
      </defs>

      <g class="grid" aria-hidden="true">
        {Array.from({ length: 5 }, (_, index) => <line x1={x(index)} y1={y(0)} x2={x(index)} y2={y(3)} />)}
        {Array.from({ length: 4 }, (_, index) => <line x1={x(0)} y1={y(index)} x2={x(4)} y2={y(index)} />)}
      </g>

      <rect class="left-piece" x={x(0)} y={y(3)} width={x(2) - x(0)} height={y(0) - y(3)} />
      <rect class="right-piece" x={x(2)} y={y(3)} width={x(4) - x(2)} height={y(0) - y(3)} />
      <rect class="left-hatch" x={x(0)} y={y(3)} width={x(2) - x(0)} height={y(0) - y(3)} fill="url(#seam-hatch-left)" />
      <rect class="right-hatch" x={x(2)} y={y(3)} width={x(4) - x(2)} height={y(0) - y(3)} fill="url(#seam-hatch-right)" />
      <line class="shared-seam" x1={x(2)} y1={y(0)} x2={x(2)} y2={y(3)} />

      {points.map(([px, py]) => {
        const onOuterBoundary = px === 0 || px === 4 || py === 0 || py === 3;
        const onInteriorSeam = px === 2 && (py === 1 || py === 2);
        return onOuterBoundary
          ? <rect class="boundary-point" x={x(px) - 7} y={y(py) - 7} width="14" height="14" rx="2" />
          : <circle class={onInteriorSeam ? 'seam-point' : 'interior-point'} cx={x(px)} cy={y(py)} r="7" />;
      })}

      <g class="labels" aria-hidden="true">
        <text x={x(1)} y="435" text-anchor="middle">left: 6 square units</text>
        <text x={x(3)} y="435" text-anchor="middle">right: 6 square units</text>
        <text class="total" x={x(2)} y="474" text-anchor="middle">joined: 12 square units</text>
        <text class="seam-label" x={x(2) + 18} y={y(1.5)} transform={`rotate(-90 ${x(2) + 18} ${y(1.5)})`} text-anchor="middle">shared seam disappears inside</text>
      </g>
    </svg>
  </div>

  <figcaption>
    <strong>What to notice:</strong> the cyan squares on the outer border remain boundary points.
    The two lime circles on the former seam become interior points. Pick’s weighted count changes
    by exactly the same amount as ordinary area when the two pieces become one polygon.
  </figcaption>
</figure>

<style>
  .pick-seam { background: var(--surface-color); border: 1px solid var(--border-color); border-radius: 12px; font-family: var(--font-sans); margin: 2.5rem 50%; padding: clamp(1rem, 3vw, 1.5rem); transform: translateX(-50%); width: min(920px, calc(100vw - 3rem)); }
  header > p { color: var(--link-color); font-size: 0.67rem; font-weight: 600; letter-spacing: 0.12em; margin: 0 0 0.2rem; text-transform: uppercase; }
  h3 { font-family: var(--font-serif); font-size: clamp(1.25rem, 3vw, 1.7rem); margin: 0 0 1rem; }
  .seam-shell { background: var(--bg-color); border: 1px solid var(--border-color); border-radius: 9px; overflow-x: auto; }
  svg { display: block; height: auto; min-width: 620px; width: 100%; }
  .grid line { stroke: var(--border-color); stroke-width: 1; }
  .left-piece { fill: color-mix(in srgb, var(--link-color) 18%, var(--surface-color)); stroke: var(--link-color); stroke-width: 3; }
  .right-piece { fill: color-mix(in srgb, #ff1493 13%, var(--surface-color)); stroke: #ff1493; stroke-width: 3; }
  .left-hatch, .right-hatch { opacity: 0.14; stroke: none; }
  #seam-hatch-left line, #seam-hatch-right line { stroke: var(--text-primary); stroke-width: 2; }
  .shared-seam { stroke: #ff1493; stroke-dasharray: 8 6; stroke-width: 4; }
  .boundary-point { fill: var(--link-color); stroke: var(--bg-color); stroke-width: 2; }
  .interior-point { fill: var(--text-secondary); stroke: var(--bg-color); stroke-width: 2; }
  .seam-point { fill: #4f9300; stroke: var(--bg-color); stroke-width: 2; }
  :global([data-theme='dark']) .seam-point { fill: #93ff14; }
  .labels text { fill: var(--text-secondary); font-size: 13px; font-weight: 600; }
  .labels .total { fill: var(--text-primary); font-size: 15px; }
  .labels .seam-label { fill: #d9007e; font-size: 11px; }
  :global([data-theme='dark']) .labels .seam-label { fill: #ff1493; }
  figcaption { color: var(--text-secondary); font-size: 0.82rem; line-height: 1.55; margin-top: 0.85rem; }
  figcaption strong { color: var(--text-primary); }
  @media (max-width: 500px) { .pick-seam { width: calc(100vw - 1.5rem); } }
</style>
