---
interface Section {
  lane: 'final-fantasy' | 'final-fantasy-xiv' | 'beyond-final-fantasy';
  title: string;
  game: string;
  summary: string;
  sourceType: string;
  spoilerLevel: 'none' | 'light' | 'major';
}

interface Props {
  title: string;
  description?: string;
  heroImage: string;
  heroImageAlt: string;
  slug: string;
  date: Date;
  publishedAt?: Date;
  featureLane: Section['lane'];
  sections: Section[];
}

const { title, description, heroImage, heroImageAlt, slug, date, publishedAt, featureLane, sections } = Astro.props;
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const laneLabels: Record<Section['lane'], string> = {
  'final-fantasy': 'Final Fantasy',
  'final-fantasy-xiv': 'Final Fantasy XIV',
  'beyond-final-fantasy': 'Beyond Final Fantasy',
};
---

<article class="save-point-card hover-lift">
  <a class="image-link" href={`/save-point/${slug}`} aria-label={`Read ${title}`}>
    <img
      class="card-image"
      src={heroImage}
      alt={heroImageAlt}
      width="1600"
      height="900"
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="card-content">
    <div class="edition-row">
      <span class="series">Save Point</span>
      <time datetime={(publishedAt ?? date).toISOString()}>{formattedDate}</time>
    </div>
    <h2><a href={`/save-point/${slug}`}>{title}</a></h2>
    {description && <p class="description">{description}</p>}
    <ul class="section-list" aria-label="Stories in this edition">
      {sections.map((section) => (
        <li class:list={[{ feature: section.lane === featureLane }]}>
          <span class="lane">
            {laneLabels[section.lane]}
            {section.lane === featureLane && <em>Feature</em>}
          </span>
          <span class="section-title">{section.title}</span>
        </li>
      ))}
    </ul>
  </div>
</article>

<style>
  .save-point-card {
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    display: grid;
    overflow: hidden;
  }
  .image-link {
    background: #03101f;
    display: block;
  }
  .card-image {
    aspect-ratio: 16 / 9;
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }
  .card-content {
    display: flex;
    flex-direction: column;
    padding: 1.4rem 1.5rem 1.5rem;
  }
  .edition-row {
    align-items: center;
    color: var(--text-secondary);
    display: flex;
    font-size: 0.75rem;
    justify-content: space-between;
    letter-spacing: 0.04em;
    margin-bottom: 0.65rem;
    text-transform: uppercase;
  }
  .series {
    color: var(--link-color);
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.2;
  }
  h2 a:hover {
    color: var(--link-color);
  }
  .description {
    color: var(--text-secondary);
  }
  .section-list {
    display: grid;
    gap: 0.45rem;
    list-style: none;
    margin: auto 0 0;
    padding: 0;
  }
  .section-list li {
    border-left: 2px solid var(--border-color);
    display: grid;
    gap: 0.08rem;
    padding: 0.3rem 0 0.3rem 0.65rem;
  }
  .section-list li.feature {
    border-left-color: #ff1493;
  }
  .lane {
    color: var(--text-secondary);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }
  .lane em {
    color: #b00064;
    font-style: normal;
    margin-left: 0.4rem;
  }
  :global([data-theme='dark']) .lane em {
    color: #ff6bb5;
  }
  .section-title {
    font-family: var(--font-serif);
    font-size: 0.86rem;
    line-height: 1.35;
  }
  @media (min-width: 800px) {
    .save-point-card {
      grid-template-columns: minmax(19rem, 0.98fr) minmax(0, 1.02fr);
    }
  }
  @media (max-width: 520px) {
    .edition-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
