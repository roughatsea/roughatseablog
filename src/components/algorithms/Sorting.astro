---
import { sortingAlgorithms } from '../../data/sorting';
const {selected='bubble-sort'}=Astro.props;
---
<section class="sorting-workspace" data-algorithm={selected} aria-label="Sorting playground">
 <div class="controls"><label>Algorithm<select id="sort-algorithm">{sortingAlgorithms.map(a=><option value={a.slug} selected={selected===a.slug}>{a.name}</option>)}</select></label><label>Input pattern<select id="sort-preset"><option value="mixed">Mixed</option><option value="sorted">Already sorted</option><option value="reversed">Reversed</option><option value="nearly">Nearly sorted</option><option value="duplicates">Repeated values</option><option value="equal">All equal</option></select></label><button id="sort-shuffle">Shuffle input</button></div>
 <form id="sort-input-form"><label class="input-label">Values (2–24 integers, each 1–99)<input id="sort-values" value="8, 3, 6, 2, 9, 4, 1, 7, 5" /></label><button type="submit">Apply input</button></form><p id="sort-validation" role="status"></p>
 <p class="legend">Cyan: idle · Pink: inspected · Amber outline: pivot · Green: final position</p><p class="small">Labels such as #3 record original input positions. Equal values can have different identities. A highlighted range is currently being processed; a sorted prefix can still move later.</p>
 <div id="sort-bars" role="img" aria-label="Array values"></div>
 <p id="sort-explanation" role="status" aria-live="polite"></p>
 <div class="playback"><button id="sort-play">Play</button><button id="sort-back">Back</button><button id="sort-step">Step</button><button id="sort-reset">Reset playback</button><label>Speed<select id="sort-speed"><option value="1100">Slow</option><option value="550" selected>Normal</option><option value="120">Fast</option></select></label></div>
 <label class="timeline">Timeline<input id="sort-timeline" type="range" min="0" max="1" value="0" /></label><p id="sort-progress"></p>
 <dl class="stats"><div><dt>Comparisons</dt><dd id="sort-comparisons">0</dd></div><div><dt>Swaps</dt><dd id="sort-swaps">0</dd></div><div><dt>Array writes</dt><dd id="sort-writes">0</dd></div><div><dt>Recursion depth</dt><dd id="sort-depth">0</dd></div></dl>
 <div class="inspect"><section><h2>Current array</h2><div class="table-scroll"><table><thead><tr><th>Index</th><th>Value</th><th>Original position</th></tr></thead><tbody id="sort-table"></tbody></table></div><section id="sort-buffer-panel" hidden><h3>Merge buffer</h3><p class="small">L and R identify the copied halves. Faded items have already been written.</p><div id="sort-buffer"></div></section></section><section><h2>Sorting pseudocode</h2><pre id="sort-code"></pre><p class="small">Highlighted lines correspond to recorded operations. Counters measure comparisons between item values and writes to the main array; copying the merge buffer is excluded.</p><a href="/scripts/sorting-engine.mjs">Read the executable JavaScript</a></section></div>
</section>
<script is:inline type="module" src="/scripts/sorting-ui.mjs"></script>
<style>
.sorting-workspace{border:1px solid var(--border-color);border-radius:1rem;padding:clamp(1rem,3vw,2rem);background:var(--surface-color);margin:2rem 0}.controls,.playback,form{display:flex;flex-wrap:wrap;gap:.8rem;align-items:end}label{display:flex;flex-direction:column;gap:.35rem;font-size:.9rem}button,select,input{font:inherit;color:var(--text-primary);background:var(--background-color);border:1px solid var(--border-color);border-radius:.4rem;padding:.6rem}button{cursor:pointer}button:disabled{opacity:.45;cursor:default}button:hover:enabled{border-color:var(--link-color)}form{margin-top:1rem}.input-label{flex:1;min-width:180px}.small,.legend{font-size:.875rem;line-height:1.6;color:var(--text-secondary)}.timeline{margin-top:1rem}.timeline input{width:100%;padding:0}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.stats dd{font-size:1.4rem;margin:.3rem 0}.stats dt{font-size:.875rem;color:var(--text-secondary)}.inspect{display:grid;grid-template-columns:1fr 1.4fr;gap:2rem}.inspect>section{min-width:0}.inspect h2{font-size:1.2rem}.table-scroll{overflow:auto}table{border-collapse:collapse;width:100%;font-size:.875rem}th,td{text-align:left;padding:.5rem;border-bottom:1px solid var(--border-color)}pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:.85rem;line-height:1.75;margin:0}#sort-bars{display:flex;align-items:end;gap:clamp(2px,.6vw,8px);height:260px;padding:20px 2px 28px;margin:2rem 0}#sort-explanation{min-height:3.5em;line-height:1.7}@media(max-width:760px){.inspect{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}#sort-bars{height:210px}.controls>*{flex:1;min-width:130px}}
</style>
