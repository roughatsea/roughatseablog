---
import { algorithms } from '../../data/algorithms';
const { selected = 'breadth-first-search' } = Astro.props;
---
<section class="algorithm-workspace" data-algorithm={selected} aria-label="Pathfinding playground">
  <div class="lab-controls">
    <label>Algorithm<select id="algorithm">{algorithms.map(a=><option value={a.slug} selected={a.slug===selected}>{a.name}</option>)}</select></label>
    <label>Start<select id="start">{'ABCDEFGHI'.split('').map(id=><option selected={id==='A'}>{id}</option>)}</select></label>
    <label>Destination<select id="goal">{'ABCDEFGHI'.split('').map(id=><option selected={id==='I'}>{id}</option>)}</select></label>
    <label>Map<select id="preset"><option value="weighted">Weighted routes</option><option value="equal">Equal costs</option><option value="disconnected">Unreachable destination</option></select></label>
  </div>
  <div class="lab-grid">
    <div class="map-column">
      <div class="graph-heading"><span id="objective">Fewest edges</span><span id="step-count">Step 1</span></div>
      <div class="graph-stage"><svg id="graph" viewBox="0 0 1020 440" role="group" aria-label="Editable graph. Select a node to change the destination, or select a connection to edit its weight."></svg></div>
      <div class="legend"><span><i class="undiscovered"></i>Undiscovered</span><span><i class="waiting"></i>Waiting</span><span><i class="visited"></i>Explored</span><span><i class="current"></i>Current</span><span><i class="route"></i>Final path</span></div>
      <div class="playback"><button id="play" type="button">Play</button><button id="back" type="button">Back</button><button id="step" type="button">Step</button><button id="reset" type="button">Reset search</button><label>Speed<select id="speed"><option value="1400">Slow</option><option value="650" selected>Normal</option><option value="180">Fast</option></select></label></div>
      <label class="scrubber">Search timeline<input id="timeline" type="range" min="0" max="1" value="0" /></label>
      <p id="explanation" class="step-explanation" aria-live="polite" aria-atomic="true"></p>
      <div class="metrics"><span>Explored <strong id="explored">0</strong></span><span>Connections examined <strong id="examined">0</strong></span><span>Waiting <strong id="waiting">1</strong></span></div>
      <details class="editor"><summary>Edit the graph</summary><p>Select a connection in the map to edit it. Select any node to make it the destination. The dropdowns also work with a keyboard.</p><div class="edit-controls"><label>Connection<select id="edge"></select></label><label>Weight<input id="weight" type="number" min="1" max="99" value="1" /></label><button id="apply-weight" type="button">Apply weight</button><button id="remove-edge" type="button">Remove connection</button></div><div class="edit-controls"><label>Connect<select id="connect-a">{'ABCDEFGHI'.split('').map(id=><option>{id}</option>)}</select></label><label>To<select id="connect-b">{'ABCDEFGHI'.split('').map(id=><option selected={id==='I'}>{id}</option>)}</select></label><button id="add-edge" type="button">Add connection</button><button id="restore" type="button">Restore map</button></div><p id="edit-status" role="status"></p></details>
    </div>
    <aside class="inspection">
      <div class="panel-buttons" role="group" aria-label="Inspection view"><button data-panel="data" aria-pressed="true" type="button">Data</button><button data-panel="code" aria-pressed="false" type="button">Code</button></div>
      <section id="data-panel"><h2 id="frontier-title">Queue · first in, first out</h2><div id="frontier" class="frontier"></div><p class="small">Leftmost node is next. Distances and predecessors update at their corresponding steps.</p><div class="table-scroll"><table><caption id="distance-caption">Distance from the start</caption><thead><tr><th>Node</th><th id="distance-label">Edges</th><th>Previous</th><th id="estimate-label" hidden>Estimate</th></tr></thead><tbody id="distances"></tbody></table></div></section>
      <section id="code-panel" hidden><h2>Search pseudocode</h2><p class="small">The highlighted line corresponds to the current operation. Helper functions keep the core logic visible.</p><pre id="code"></pre><a href="/scripts/algorithms-engine.mjs">Read the executable JavaScript</a></section>
    </aside>
  </div>
  <noscript><p>Enable JavaScript to operate the playground. The explanations and lessons below remain available.</p></noscript>
</section>
<script is:inline type="module" src="/scripts/algorithms-ui.mjs"></script>
<style is:global>
.algorithm-workspace{--lab-bg:#071426;--lab-panel:#0d2138;--lab-text:#edf5ff;--lab-muted:#b1c5dc;--cyan:#37d6ff;--pink:#ff48bd;--lime:#b7ff53;background:var(--lab-bg);color:var(--lab-text);border:1px solid #284761;border-radius:1.2rem;overflow:hidden;margin:1.5rem 0 2.5rem;font-size:1rem;box-shadow:0 18px 60px #06132625}
.algorithm-workspace *{box-sizing:border-box}.algorithm-workspace button,.algorithm-workspace select,.algorithm-workspace input[type=number]{font:inherit;color:var(--lab-text);background:#122c48;border:1px solid #42627f;border-radius:.5rem;padding:.55rem .7rem;min-height:44px}.algorithm-workspace button{cursor:pointer}.algorithm-workspace button:hover{border-color:var(--cyan);background:#1a3957}.algorithm-workspace button:disabled{opacity:.45;cursor:default}.algorithm-workspace :focus-visible{outline:3px solid var(--lime);outline-offset:3px}.algorithm-workspace label{display:grid;gap:.3rem;font-size:.875rem;color:var(--lab-muted)}.lab-controls{display:flex;flex-wrap:wrap;gap:1rem;padding:1rem 1.25rem;border-bottom:1px solid #284761}.lab-controls label:first-child{flex:1;min-width:210px}.lab-grid{display:grid;grid-template-columns:minmax(0,1fr) 330px}.map-column{min-width:0;padding:1.25rem}.graph-heading{display:flex;justify-content:space-between;gap:1rem;font-size:.875rem;color:var(--lab-muted)}.graph-stage{background:radial-gradient(ellipse at center,#13385c55,transparent 70%);margin:.5rem 0}#graph{width:100%;height:auto;display:block;min-height:240px}.legend{display:flex;flex-wrap:wrap;gap:.6rem 1rem;font-size:.875rem;color:var(--lab-muted)}.legend span{display:flex;align-items:center;gap:.4rem}.legend i{width:10px;height:10px;border-radius:50%;background:#63819f}.legend .waiting{background:var(--cyan)}.legend .visited{background:#9974ff}.legend .current{background:var(--pink)}.legend .route{background:var(--lime)}.playback{display:flex;flex-wrap:wrap;align-items:end;gap:.5rem;margin:1.3rem 0 .8rem}#play{background:#b7ff53;color:#071426;border-color:#b7ff53;font-weight:700;min-width:80px}.scrubber{margin:1rem 0}.scrubber input{width:100%;accent-color:var(--cyan);min-height:24px}.step-explanation{min-height:5.5rem;background:#0d2138;border-left:3px solid var(--cyan);padding:1rem;line-height:1.65;margin:1rem 0}.metrics{display:flex;flex-wrap:wrap;gap:1rem;color:var(--lab-muted);font-size:.875rem}.metrics strong{color:var(--lab-text);font-size:1.2rem;margin-left:.3rem}.editor{margin-top:1.4rem;border-top:1px solid #284761;padding-top:1rem}.editor summary{cursor:pointer;color:var(--cyan)}.editor p{font-size:.875rem;color:var(--lab-muted);line-height:1.5}.edit-controls{display:flex;flex-wrap:wrap;align-items:end;gap:.5rem;margin-top:.8rem}.edit-controls input{width:90px}.inspection{background:var(--lab-panel);padding:1.25rem;border-left:1px solid #284761;min-width:0}.inspection h2{font-family:inherit;font-size:1rem;color:var(--lab-text);margin:1.2rem 0 .7rem}.panel-buttons{display:flex;gap:.5rem}.panel-buttons button[aria-pressed=true]{border-color:var(--cyan);color:var(--cyan)}.frontier{display:flex;flex-wrap:wrap;gap:.4rem;min-height:44px}.frontier span{display:inline-flex;align-items:center;justify-content:center;border:1px solid var(--cyan);border-radius:.5rem;padding:.45rem;min-width:38px;color:var(--cyan)}.small{font-size:.875rem;color:var(--lab-muted);line-height:1.5}.table-scroll{overflow:auto}.inspection table{width:100%;border-collapse:collapse;font-size:.875rem}.inspection caption{text-align:left;color:var(--lab-muted);padding:.5rem 0}.inspection th,.inspection td{text-align:left;padding:.55rem .35rem;border-bottom:1px solid #284761}.inspection tr.active{background:#ff48bd22}.inspection a{color:var(--cyan);font-size:.875rem}#code{background:transparent;padding:0;overflow:auto;font-size:.875rem;line-height:1.8;color:var(--lab-text)}#code span{display:block;padding:0 .4rem;white-space:pre}#code span.active{background:#b7ff5322;color:var(--lime);border-left:2px solid var(--lime)}
@media(max-width:1000px){.lab-grid{grid-template-columns:1fr}.inspection{border-left:0;border-top:1px solid #284761}.inspection table{max-width:600px}#graph{min-height:0}.step-explanation{min-height:0}}@media(max-width:480px){.lab-controls,.map-column,.inspection{padding:.85rem}.lab-controls{gap:.65rem}.lab-controls label{flex:1}.lab-controls select{width:100%}.legend{font-size:.8rem}.algorithm-workspace{border-radius:.7rem}}
</style>
