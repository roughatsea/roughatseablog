---
import {discoveryAlgorithms} from '../../data/discovery-algorithms';
const {selected,family}=Astro.props;
const choices=discoveryAlgorithms.filter(a=>a.family===family);
---
<section class="discovery-workspace" aria-label="Algorithm playground">
 <div class="controls"><label>Algorithm<select id="trace-algorithm">{choices.map(a=><option value={a.slug} selected={a.slug===selected}>{a.name}</option>)}</select></label><label>Examples<select id="trace-preset"><option>Choose an example</option></select></label></div>
 <form id="trace-form"><div id="trace-fields"></div><button type="submit">Apply input</button></form><p id="trace-validation" role="status"></p>
 <p class="small">Step forward, return to an earlier state, or scrub the timeline. Applying input begins a new run. Switching compatible algorithms retains the input; other algorithms load their own defaults.</p>
 <div id="trace-board" aria-label="Algorithm data"></div><p id="trace-explanation" aria-live="polite" role="status"></p>
 <div class="controls"><button id="trace-play">Play</button><button id="trace-back">Back</button><button id="trace-step">Step</button><button id="trace-reset">Reset playback</button><label>Speed<select id="trace-speed"><option value="1100">Slow</option><option value="550" selected>Normal</option><option value="120">Fast</option></select></label></div>
 <label class="timeline">Timeline<input id="trace-timeline" type="range" min="0" max="1" value="0" /></label><p id="trace-progress"></p><dl id="trace-counts"></dl>
 <div class="inspection"><section><h2>Current state</h2><div id="trace-state"></div><section id="trace-history-panel" hidden><h3>Operation history</h3><div id="trace-history"></div></section></section><section><h2>Pseudocode</h2><pre id="trace-code"></pre><p class="small">Each highlighted line corresponds to an operation in the executable trace. Counts describe core algorithm work, excluding validation, snapshots, and rendering.</p><a href="/scripts/discovery-engine.mjs">Read the executable JavaScript</a></section></div>
</section>
<script is:inline type="module" src="/scripts/discovery-ui.mjs"></script>
<style is:global>
.discovery-workspace{border:1px solid var(--border-color);border-radius:1rem;padding:clamp(1rem,3vw,2rem);background:var(--surface-color);margin:2rem 0;min-width:0}.discovery-workspace .controls,.discovery-workspace form,.discovery-workspace #trace-fields{display:flex;flex-wrap:wrap;gap:.8rem;align-items:end}.discovery-workspace label{display:flex;flex-direction:column;gap:.35rem;font-size:.9rem}.discovery-workspace button,.discovery-workspace select,.discovery-workspace input{font:inherit;color:var(--text-primary);background:var(--background-color);border:1px solid var(--border-color);border-radius:.4rem;padding:.6rem;max-width:100%;min-width:0}.discovery-workspace button{cursor:pointer}.discovery-workspace button:disabled{opacity:.45;cursor:default}.discovery-workspace button:hover:enabled{border-color:var(--link-color)}.discovery-workspace form{margin-top:1rem}.discovery-workspace #trace-fields{flex:1}.discovery-workspace #trace-fields label{flex:1;min-width:160px}.discovery-workspace .small{font-size:.875rem;line-height:1.6;color:var(--text-secondary)}.discovery-workspace .timeline{margin-top:1rem}.discovery-workspace .timeline input{width:100%;padding:0}.discovery-workspace #trace-counts{display:flex;flex-wrap:wrap;gap:2rem}.discovery-workspace dd{font-size:1.4rem;margin:.3rem 0}.discovery-workspace dt{font-size:.875rem;color:var(--text-secondary)}.discovery-workspace .inspection{display:grid;grid-template-columns:1fr 1.3fr;gap:2rem}.discovery-workspace .inspection>section{min-width:0}.discovery-workspace h2{font-size:1.2rem}.discovery-workspace h3{font-size:.95rem;margin:1.25rem 0 .75rem}.trace-table-scroll,.trace-board-scroll{overflow:auto;max-width:100%;padding:3px}.discovery-workspace table{border-collapse:collapse;width:100%;font-size:.875rem}.discovery-workspace th,.discovery-workspace td{text-align:left;padding:.5rem;border-bottom:1px solid var(--border-color);overflow-wrap:anywhere}.discovery-workspace pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:.85rem;line-height:1.75;margin:0}.discovery-workspace pre span{display:block}.discovery-workspace pre .active{background:color-mix(in srgb,#ff1493 18%,transparent);border-left:3px solid #ff1493}.trace-cells{display:flex;flex-wrap:wrap;gap:.4rem}.trace-cell{display:flex;flex-direction:column;justify-content:center;align-items:center;min-width:44px;max-width:100%;padding:.7rem;border:1px solid var(--link-color);border-radius:.4rem;background:color-mix(in srgb,var(--link-color) 8%,transparent);font-family:monospace;overflow-wrap:anywhere}.trace-cell small{font:11px sans-serif;color:var(--text-secondary);margin-top:.35rem}.trace-cell.active,.trace-matrix td.active{outline:2px solid #ff1493;background:color-mix(in srgb,#ff1493 16%,transparent)}.trace-cell.amber,.trace-matrix td.amber{outline:2px solid #e2a326;background:color-mix(in srgb,#e2a326 15%,transparent)}.trace-cell.good,.trace-matrix td.good{outline:2px solid #278749;background:color-mix(in srgb,#278749 14%,transparent)}.trace-cell.dim{opacity:.4}.trace-cell.pending{border-color:var(--border-color);background:transparent;color:var(--text-secondary)}.trace-string-stack{overflow-x:auto;padding:3px}.trace-string-stack .trace-board-scroll{overflow:visible;max-width:none}.trace-cells.string-row{flex-wrap:nowrap;width:max-content;gap:3px}.string-row .trace-cell{width:36px;min-width:36px;flex:none;padding:.5rem .15rem}.aligned .trace-cell.dim{visibility:hidden}.trace-matrix{min-width:max-content}.trace-matrix td,.trace-matrix th{min-width:38px;text-align:center}#trace-explanation{min-height:3.5em;line-height:1.7}@media(max-width:760px){.discovery-workspace .inspection{grid-template-columns:1fr}.discovery-workspace .controls label{flex:1;min-width:140px}.discovery-workspace #trace-fields{width:100%;flex:auto}.discovery-workspace #trace-fields label{min-width:100%;width:100%}.trace-cell{padding:.55rem}.discovery-workspace #trace-counts{gap:1rem}}
</style>
