---
import type { CollectionEntry } from "astro:content";
import { formatDate, readingTime } from "../utils/dates";

interface Props {
  post: CollectionEntry<"writing">;
  index?: number;
}

const { post, index = 0 } = Astro.props;
---

<article class="post-card reveal" style={`--delay: ${index * 70}ms`}>
  <a class="post-card-link" href={`/writing/${post.id}/`} aria-label={`Read ${post.data.title}`}>
    <div class="post-card-meta">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
      <span aria-hidden="true">/</span>
      <span>{readingTime(post.body)}</span>
    </div>
    <h2>{post.data.title}</h2>
    <p>{post.data.description}</p>
    <div class="post-card-footer">
      <div class="tag-list" aria-label="Topics">
        {post.data.tags.map((tag) => <span>{tag}</span>)}
      </div>
      <span class="arrow" aria-hidden="true">↗</span>
    </div>
  </a>
</article>
