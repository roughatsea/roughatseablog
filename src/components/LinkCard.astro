---
interface Props {
  title: string;
  url: string;
  heroImage: string;
  heroImageAlt: string;
  slug: string;
  date: Date;
  tags: string[];
  preview: string;
}
const { title, url, heroImage, heroImageAlt, slug, date, tags, preview } = Astro.props;

// Formatting the date nicely
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
---
<div class="link-card hover-lift">
  <img
    class="card-image"
    src={heroImage}
    alt={heroImageAlt}
    width="1600"
    height="900"
    loading="lazy"
    decoding="async"
  />
  <div class="card-content">
    <div class="header-row">
      <h3 class="title">
        <a href={`/links/${slug}`}>{title}</a>
      </h3>
    </div>
    {preview && <p class="description">{preview}</p>}
    <div class="footer-row">
      <div class="metadata">
        <span class="date">{formattedDate}</span>
        {tags.length > 0 && (
          <div class="tags">
            {tags.map((tag) => (
              <a
                class="tag"
                href={`/?tag=${encodeURIComponent(tag)}#entries`}
                data-entry-tag={tag}
              >#{tag}</a>
            ))}
          </div>
        )}
      </div>
      <a class="source-link" href={url} target="_blank" rel="noopener noreferrer">
        Visit source
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
      </a>
    </div>
  </div>
</div>

<style>
  .link-card {
    display: flex;
    flex-direction: column;
    background-color: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 0;
    margin-bottom: 1.5rem;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
  }
  .card-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--bg-color);
  }
  .card-content {
    display: flex;
    flex: 1;
    flex-direction: column;
    height: 100%;
    padding: 1.25rem 1.5rem 1.5rem;
  }
  .header-row {
    margin-bottom: 0.75rem;
  }
  .title {
    margin: 0;
    font-size: 1.125rem;
  }
  .title a {
    color: var(--link-color);
    text-decoration: none;
  }
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .description {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: 1.25rem;
  }
  .footer-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-top: auto;
  }
  .metadata {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }
  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .tag {
    background: var(--bg-color);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
    font-size: 0.75rem;
    position: relative;
    z-index: 1;
  }
  .tag:hover {
    color: var(--link-color);
  }
  .source-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--link-color);
    font-weight: 500;
    position: relative;
    z-index: 1;
    white-space: nowrap;
  }
  .source-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 560px) {
    .footer-row {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (min-width: 960px) {
    .link-card {
      display: grid;
      grid-template-columns: clamp(22rem, 36vw, 26rem) minmax(0, 1fr);
      min-height: 14rem;
    }

    .card-image {
      aspect-ratio: auto;
      height: 100%;
      min-height: 14rem;
    }

    .card-content {
      min-width: 0;
      padding: 1.25rem 1.5rem;
    }

    .title {
      display: -webkit-box;
      line-height: 1.25;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .description {
      display: -webkit-box;
      line-height: 1.5;
      margin-bottom: 0.75rem;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }

    .tags {
      max-height: 3.5rem;
      overflow: hidden;
    }
  }
</style>
