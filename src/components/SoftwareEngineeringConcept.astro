---
type Link = { slug: string; title: string };
type InlinePart = { code: boolean; text: string };

function inlineParts(value: string | null | undefined): InlinePart[] {
  const text = value ?? '';
  return text.split(/(`[^`]+`)/g).filter(Boolean).map((piece) => ({
    code: piece.startsWith('`') && piece.endsWith('`'),
    text: piece.startsWith('`') && piece.endsWith('`') ? piece.slice(1, -1) : piece,
  }));
}

interface Props {
  concept: any;
  previous?: Link;
  next?: Link;
}

const { concept, previous, next } = Astro.props;
const relatedProse = (concept.related ?? '').replace(/^Related:\s*/i, '');
---

<article class="concept-page" id={concept.slug} data-concept-page>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">Rough at Sea</a>
    <span aria-hidden="true">/</span>
    <a href="/guides/software-engineering/">Software Engineering Field Guide</a>
  </nav>

  <header class="concept-header">
    <h1>{concept.title}</h1>
    <div class="concept-meta">
      <span>{concept.domain}</span>
      <span>{concept.chapter}</span>
      <span>{concept.tier_label}</span>
    </div>
    <div class="recognition-block">
      <p class="recognition-label">Recognize it when</p>
      <p class="recognition-text">{concept.look_for}</p>
    </div>
  </header>

  <section class="definition" aria-labelledby="definition-heading">
    <h2 id="definition-heading">What the name means</h2>
    <p>{inlineParts(concept.definition).map((part) => part.code ? <code>{part.text}</code> : part.text)}</p>
  </section>

  <section class="examples" aria-labelledby="examples-heading">
    <div class="examples-heading">
      <div>
        <p class="section-label">Translation, not a terseness contest</p>
        <h2 id="examples-heading">Examples</h2>
      </div>
      <div class="language-switch" role="group" aria-label="Code language" data-guide-language-control>
        <button type="button" data-language="csharp" aria-pressed="false">C#</button>
        <button type="button" data-language="python" aria-pressed="false">Python</button>
        <button type="button" data-language="both" aria-pressed="true">Show both</button>
      </div>
    </div>

    <div class="language-panels">
      <section class="language-panel" data-language-panel="csharp" aria-labelledby="csharp-heading">
        <h3 id="csharp-heading">C#</h3>
        <p class="code-label">Expanded</p>
        <pre><code class="language-csharp">{concept.csharp_expanded.trim()}</code></pre>
        {concept.csharp_shorthand && (
          <>
            <p class="code-label shorthand-label">Modern shorthand</p>
            <pre><code class="language-csharp">{concept.csharp_shorthand.trim()}</code></pre>
          </>
        )}
      </section>

      <section class="language-panel" data-language-panel="python" aria-labelledby="python-heading">
        <h3 id="python-heading">Python</h3>
        <p class="code-label">Expanded</p>
        <pre><code class="language-python">{concept.python_expanded.trim()}</code></pre>
        {concept.python_shorthand && (
          <>
            <p class="code-label shorthand-label">Modern shorthand</p>
            <pre><code class="language-python">{concept.python_shorthand.trim()}</code></pre>
          </>
        )}
      </section>
    </div>

    <div class="walkthrough">
      <h3>Why these examples fit</h3>
      <p>{inlineParts(concept.walkthrough).map((part) => part.code ? <code>{part.text}</code> : part.text)}</p>
    </div>
  </section>

  {concept.modern_note && (
    <aside class="note-box">
      <h2>Modern note</h2>
      <p>{inlineParts(concept.modern_note).map((part) => part.code ? <code>{part.text}</code> : part.text)}</p>
    </aside>
  )}

  <aside class="caution-box">
    <h2>Watch out</h2>
    <p>{inlineParts(concept.caution).map((part) => part.code ? <code>{part.text}</code> : part.text)}</p>
  </aside>

  {(relatedProse || concept.relatedConcepts.length > 0) && (
    <section class="related" aria-labelledby="related-heading">
      <h2 id="related-heading">Nearby language</h2>
      {relatedProse && <p>{inlineParts(relatedProse).map((part) => part.code ? <code>{part.text}</code> : part.text)}</p>}
      {concept.relatedConcepts.length > 0 && (
        <nav aria-label="Related concepts">
          {concept.relatedConcepts.map((related: Link) => (
            <a href={`/guides/software-engineering/${related.slug}/`}>{related.title}</a>
          ))}
        </nav>
      )}
    </section>
  )}

  <section class="sources" aria-labelledby="sources-heading">
    <h2 id="sources-heading">Lineage and sources</h2>
    <p>{concept.source.lineage}</p>
    <ul>
      {concept.source.sources.map((source: { label: string; url: string }) => (
        <li><a href={source.url}>{source.label}</a></li>
      ))}
    </ul>
    <p class="source-caveat">
      These are domain-level starting points; no single source is claimed to support every explanation on this page. The examples and explanatory judgments are original to Rough at Sea.
    </p>
  </section>

  <nav class="concept-pagination" aria-label="Adjacent concepts">
    <div>
      {previous && (
        <a href={`/guides/software-engineering/${previous.slug}/`}>
          <span>Previous</span>
          {previous.title}
        </a>
      )}
    </div>
    <div>
      {next && (
        <a href={`/guides/software-engineering/${next.slug}/`}>
          <span>Next</span>
          {next.title}
        </a>
      )}
    </div>
  </nav>
</article>

<script is:inline>
  const root = document.querySelector('[data-concept-page]');

  if (root instanceof HTMLElement && root.dataset.ready !== 'true') {
    root.dataset.ready = 'true';
    const buttons = [...root.querySelectorAll('[data-language]')];
    const key = 'roughatsea-field-guide-language';
    const valid = (value) => ['csharp', 'python', 'both'].includes(value) ? value : 'both';

    const applyLanguage = (value) => {
      const language = valid(value);
      document.documentElement.dataset.fieldGuideLanguage = language;
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.language === language));
      });
      try {
        localStorage.setItem(key, language);
      } catch {
        // Keep the preference for this page when storage is unavailable.
      }
    };

    let preferred = 'both';
    try {
      preferred = localStorage.getItem(key) ?? 'both';
    } catch {
      // Use the default when storage is unavailable.
    }
    applyLanguage(preferred);

    buttons.forEach((button) => {
      button.addEventListener('click', () => applyLanguage(button.dataset.language ?? 'both'));
    });
  }
</script>

<style>
  .concept-page {
    font-family: var(--font-serif);
    font-size: 1.08rem;
    line-height: 1.75;
    margin: 0 50%;
    transform: translateX(-50%);
    width: min(1000px, calc(100vw - 3rem));
  }

  .breadcrumbs {
    color: var(--text-secondary);
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    gap: 0.45rem;
    margin: 1rem 0 3rem;
  }

  .breadcrumbs a:hover { color: var(--link-color); }

  .concept-header {
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 2rem;
  }

  .recognition-label,
  .section-label {
    color: var(--link-color);
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin: 0 0 0.35rem;
    text-transform: uppercase;
  }

  .recognition-text {
    color: var(--text-secondary);
    font-size: clamp(1.05rem, 2.4vw, 1.3rem);
    line-height: 1.6;
    margin: 0;
    max-width: 48rem;
  }

  .recognition-block {
    border-left: 3px solid var(--link-color);
    margin-top: 1.75rem;
    padding-left: 1rem;
  }

  h1,
  h2,
  h3 { font-family: var(--font-sans); }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1.05;
    margin: 0 0 1.25rem;
  }

  .concept-meta {
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-sans);
    gap: 0.4rem;
  }

  .concept-meta span {
    border: 1px solid var(--border-color);
    border-radius: 999px;
    color: var(--text-secondary);
    font-size: 0.7rem;
    padding: 0.28rem 0.55rem;
  }

  .definition,
  .examples,
  .related,
  .sources {
    margin-top: 3rem;
  }

  .definition { max-width: 48rem; }

  h2 {
    font-size: 1.45rem;
    margin-bottom: 0.8rem;
  }

  .examples {
    background: var(--surface-color);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .examples-heading {
    align-items: end;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
  }

  .language-switch {
    display: flex;
    font-family: var(--font-sans);
    gap: 0.35rem;
  }

  .language-switch button {
    background: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    color: var(--text-primary);
    cursor: pointer;
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.4rem 0.7rem;
  }

  .language-switch button[aria-pressed='true'] {
    background: var(--text-primary);
    border-color: var(--text-primary);
    color: var(--bg-color);
  }

  .language-switch button:focus-visible,
  a:focus-visible {
    outline: 2px solid var(--link-color);
    outline-offset: 2px;
  }

  .language-panels {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1.5rem;
  }

  :global(html[data-field-guide-language='csharp']) [data-language-panel='python'],
  :global(html[data-field-guide-language='python']) [data-language-panel='csharp'] {
    display: none;
  }

  :global(html[data-field-guide-language='csharp']) .language-panels,
  :global(html[data-field-guide-language='python']) .language-panels {
    grid-template-columns: minmax(0, 1fr);
  }

  .language-panel {
    min-width: 0;
  }

  .language-panel h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
  }

  .code-label {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin: 0 0 0.4rem;
    text-transform: uppercase;
  }

  .shorthand-label { margin-top: 1rem; }

  pre {
    background: #0d1117;
    border-radius: 8px;
    color: #e6edf3;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
    font-size: 0.75rem;
    line-height: 1.55;
    margin: 0;
    overflow-x: auto;
    padding: 0.9rem;
    tab-size: 4;
    white-space: pre;
  }

  .walkthrough {
    border-top: 1px solid var(--border-color);
    margin-top: 1.5rem;
    padding-top: 1.5rem;
  }

  .walkthrough h3 { font-size: 1rem; }
  .walkthrough p { margin-bottom: 0; }

  .note-box,
  .caution-box {
    border-left: 4px solid var(--link-color);
    margin: 2rem 0;
    max-width: 48rem;
    padding: 0.2rem 0 0.2rem 1rem;
  }

  .caution-box { border-left-color: #ff1493; }
  .note-box h2,
  .caution-box h2 { font-size: 1rem; }
  .note-box p,
  .caution-box p { margin-bottom: 0; }

  .related,
  .sources { max-width: 48rem; }

  .related nav {
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-sans);
    gap: 0.45rem;
    margin-top: 1rem;
  }

  .related nav a {
    border: 1px solid var(--border-color);
    border-radius: 999px;
    color: var(--link-color);
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.35rem 0.65rem;
  }

  .sources a {
    color: var(--link-color);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sources ul { margin: 0 0 1rem 1.25rem; }

  .source-caveat {
    color: var(--text-secondary);
    font-family: var(--font-sans);
    font-size: 0.78rem;
  }

  .concept-pagination {
    border-top: 1px solid var(--border-color);
    display: grid;
    font-family: var(--font-sans);
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 4rem;
    padding-top: 1.5rem;
  }

  .concept-pagination div:last-child { text-align: right; }
  .concept-pagination a { color: var(--link-color); font-size: 0.88rem; }
  .concept-pagination span {
    color: var(--text-secondary);
    display: block;
    font-size: 0.68rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .concept-page { width: calc(100vw - 1.5rem); }
    .language-panels { grid-template-columns: 1fr; }
  }
</style>
