---
---
<header class="glass-panel">
  <div class="header-content container">
    <a href="/" class="logo">Commonplace Book</a>
    <button id="theme-toggle" aria-label="Toggle Dark Mode">
      <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
      <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
    </button>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 1rem 0;
    margin-bottom: 3rem;
  }
  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    font-weight: 600;
    font-size: 1.25rem;
  }
  #theme-toggle {
    background: none;
    border: none;
    color: var(--text-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border-radius: 50%;
    transition: background-color 0.2s ease;
  }
  #theme-toggle:hover {
    background-color: var(--border-color);
  }
  
  :global([data-theme="dark"]) .sun-icon { display: block; }
  :global([data-theme="dark"]) .moon-icon { display: none; }
  :global(:root:not([data-theme="dark"])) .sun-icon { display: none; }
  :global(:root:not([data-theme="dark"])) .moon-icon { display: block; }
</style>

<script>
  const handleToggleClick = () => {
    const element = document.documentElement;
    element.toggleAttribute('data-theme');
    
    const isDark = element.hasAttribute('data-theme');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  };

  document.getElementById('theme-toggle')?.addEventListener('click', handleToggleClick);
</script>
