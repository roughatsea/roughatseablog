---
const pathname = Astro.url.pathname;
const isWriting = pathname.startsWith('/notes/') || pathname.startsWith('/guides/') || pathname === '/content/';
const isDaily = pathname.startsWith('/soundings/') || pathname.startsWith('/reckonings/') || pathname.startsWith('/save-point/') || pathname.startsWith('/dialogue/') || pathname.startsWith('/wake/');
const isExplorations = pathname.startsWith('/atlas/') || pathname === '/fly' || pathname.startsWith('/fly/');
---

<header class="glass-panel">
  <div class="header-content container">
    <a href="/" class="brand" aria-label="Rough at Sea home">
      <svg class="brand-mark" aria-hidden="true" viewBox="0 0 48 32" fill="none">
        <path d="M3 11c5.2 0 5.2-5 10.4-5s5.2 5 10.4 5S29 6 34.2 6s5.2 5 10.4 5" />
        <path d="M3 20c5.2 0 5.2-5 10.4-5s5.2 5 10.4 5 5.2-5 10.4-5 5.2 5 10.4 5" />
        <path d="M3 29c5.2 0 5.2-5 10.4-5s5.2 5 10.4 5 5.2-5 10.4-5 5.2 5 10.4 5" />
      </svg>
      <span class="brand-copy"><span class="logo">Rough at Sea</span><span class="brand-line">A logbook for curious waters</span></span>
    </a>

    <button id="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation-panel" aria-label="Open menu">
      <svg class="menu-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      <svg class="close-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>

    <div class="header-actions" id="primary-navigation-panel">
      <nav aria-label="Primary navigation">
        <a class="home-link" href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</a>
        <details class:list={['nav-group', { 'is-current': isWriting }]}>
          <summary>Writing</summary>
          <div class="nav-menu">
            <a href="/content/" aria-current={pathname === '/content/' ? 'page' : undefined}><strong>All writing</strong><span>The complete archive</span></a>
            <a href="/guides/software-engineering/" aria-current={pathname.startsWith('/guides/software-engineering/') ? 'page' : undefined}><strong>Field Guide</strong><span>Software engineering, made legible</span></a>
          </div>
        </details>
        <details class:list={['nav-group', { 'is-current': isDaily }]}>
          <summary>Daily</summary>
          <div class="nav-menu">
            <a href="/soundings/" aria-current={pathname.startsWith('/soundings/') ? 'page' : undefined}><strong>Soundings</strong><span>Signals worth noticing</span></a>
            <a href="/reckonings/" aria-current={pathname.startsWith('/reckonings/') ? 'page' : undefined}><strong>Reckonings</strong><span>A daily mathematical encounter</span></a>
            <a href="/save-point/" aria-current={pathname.startsWith('/save-point/') ? 'page' : undefined}><strong>Save Point</strong><span>A daily JRPG corner</span></a>
            <a href="/dialogue/" aria-current={pathname.startsWith('/dialogue/') ? 'page' : undefined}><strong>Dialogue</strong><span>An evolving public conversation</span></a>
            <a href="/wake/" aria-current={pathname.startsWith('/wake/') ? 'page' : undefined}><strong>The Wake</strong><span>What followed the signal</span></a>
          </div>
        </details>
        <details class:list={['nav-group', { 'is-current': isExplorations }]}>
          <summary>Explorations</summary>
          <div class="nav-menu">
            <a href="/atlas/" aria-current={pathname.startsWith('/atlas/') ? 'page' : undefined}><strong>Atlas</strong><span>An interactive world atlas</span></a>
            <a href="/fly" aria-current={pathname === '/fly' || pathname.startsWith('/fly/') ? 'page' : undefined}><strong>Fly</strong><span>A quiet journey through alien worlds</span></a>
          </div>
        </details>
        <a href="/about/" aria-current={pathname === '/about/' ? 'page' : undefined}>About</a>
      </nav>
      <button id="theme-toggle" aria-label="Toggle dark mode">
        <svg class="sun-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
        <svg class="moon-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        <span class="theme-toggle-text">Dark mode</span>
      </button>
    </div>
  </div>
</header>

<style>
  header { margin-bottom: 3rem; padding: .8rem 0; position: sticky; top: 0; z-index: 100; }
  .header-content,.header-actions,.brand,nav { align-items: center; display: flex; }
  .header-content { justify-content: space-between; max-width: 1120px; position: relative; }
  .brand { gap: .7rem; min-width: 0; }
  .brand-mark { color: var(--link-color); flex: 0 0 auto; height: 1.75rem; stroke: currentColor; stroke-linecap: round; stroke-width: 2.5; width: 2.65rem; }
  .brand-copy { display: flex; flex-direction: column; line-height: 1.1; }
  .logo { font-family: var(--font-serif); font-size: 1.25rem; font-weight: 600; }
  .brand-line { color: var(--text-secondary); font-size: .62rem; letter-spacing: .04em; margin-top: .18rem; text-transform: uppercase; }
  .header-actions { gap: .8rem; }
  #menu-toggle { align-items: center; background: none; border: 1px solid var(--border-color); border-radius: 50%; color: var(--text-primary); cursor: pointer; display: none; height: 2.75rem; justify-content: center; padding: 0; width: 2.75rem; }
  #menu-toggle svg { height: 1.25rem; stroke: currentColor; stroke-linecap: round; stroke-width: 2; width: 1.25rem; }
  #menu-toggle .close-icon,#menu-toggle[aria-expanded='true'] .menu-icon { display: none; }
  #menu-toggle[aria-expanded='true'] .close-icon { display: block; }
  nav { gap: .2rem; }
  nav a,summary { border-radius: 999px; color: var(--text-secondary); font-size: .82rem; padding: .4rem .65rem; }
  nav a:hover,nav a[aria-current='page'],summary:hover,.nav-group.is-current summary { background: var(--bg-color); color: var(--text-primary); }
  nav a[aria-current='page'] { box-shadow: inset 0 0 0 1px var(--border-color); }
  .nav-group { position: relative; }
  summary { cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '⌄'; display: inline-block; font-size: .9em; margin-left: .28rem; }
  details[open] summary::after { transform: rotate(180deg); }
  .nav-menu { background: var(--surface-color); border: 1px solid var(--border-color); border-radius: .9rem; box-shadow: var(--glass-shadow); display: grid; gap: .15rem; left: 0; min-width: 15.5rem; padding: .45rem; position: absolute; top: calc(100% + .55rem); z-index: 10; }
  .nav-menu a { border-radius: .65rem; display: grid; gap: .13rem; padding: .55rem .65rem; }
  .nav-menu strong { color: var(--text-primary); font-size: .78rem; font-weight: 600; }
  .nav-menu span { font-size: .68rem; line-height: 1.25; }
  #theme-toggle { align-items: center; background: none; border: none; border-radius: 50%; color: var(--text-primary); cursor: pointer; display: flex; justify-content: center; padding: .5rem; }
  #theme-toggle svg { height: 20px; width: 20px; }
  #theme-toggle:hover { background-color: var(--border-color); }
  .theme-toggle-text { display: none; }
  :global([data-theme='dark']) .sun-icon { display: block; }
  :global([data-theme='dark']) .moon-icon { display: none; }
  :global(:root:not([data-theme='dark'])) .sun-icon { display: none; }
  :global(:root:not([data-theme='dark'])) .moon-icon { display: block; }
  @media (max-width: 980px) {
    header { margin-bottom: 2.25rem; }
    .brand-line { display: none; }
    .brand-mark { height: 1.45rem; width: 2.2rem; }
    .logo { font-size: 1.05rem; }
    #menu-toggle { display: flex; flex: 0 0 auto; }
    .header-actions { align-items: stretch; background: var(--surface-color); border: 1px solid var(--border-color); border-radius: 1rem; box-shadow: var(--glass-shadow); display: none; flex-direction: column; gap: .45rem; padding: .6rem; position: absolute; right: 0; top: calc(100% + .75rem); width: min(18rem, calc(100vw - 3rem)); }
    .header-actions.is-open { display: flex; }
    nav { align-items: stretch; flex-direction: column; gap: .15rem; }
    nav a,summary { border-radius: .7rem; font-size: .9rem; padding: .65rem .8rem; }
    .nav-group { position: static; }
    summary { display: flex; justify-content: space-between; }
    summary::after { margin-left: auto; }
    .nav-menu { background: transparent; border: 0; box-shadow: none; margin: .1rem 0 .3rem; min-width: 0; padding: 0 0 0 .65rem; position: static; }
    .nav-menu a { padding: .55rem .65rem; }
    #theme-toggle { border-radius: .7rem; border-top: 1px solid var(--border-color); gap: .65rem; justify-content: flex-start; padding: .75rem .8rem .55rem; width: 100%; }
    .theme-toggle-text { display: inline; font-family: var(--font-sans); font-size: .9rem; }
  }
  @media (max-width: 390px) { .brand-mark { display: none; } }
</style>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const navigationPanel = document.getElementById('primary-navigation-panel');
  const setMenuOpen = (isOpen: boolean) => {
    menuToggle?.setAttribute('aria-expanded', String(isOpen));
    menuToggle?.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    navigationPanel?.classList.toggle('is-open', isOpen);
  };
  menuToggle?.addEventListener('click', () => setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true'));
  navigationPanel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    if (menuToggle?.contains(event.target) || navigationPanel?.contains(event.target)) return;
    setMenuOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || menuToggle?.getAttribute('aria-expanded') !== 'true') return;
    setMenuOpen(false);
    menuToggle?.focus();
  });
  window.matchMedia('(min-width: 981px)').addEventListener('change', (event) => { if (event.matches) setMenuOpen(false); });

  const themeToggle = document.getElementById('theme-toggle');
  const themeToggleText = themeToggle?.querySelector('.theme-toggle-text');
  const syncThemeToggle = () => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    const nextTheme = isDark ? 'light' : 'dark';
    themeToggle?.setAttribute('aria-label', `Switch to ${nextTheme} mode`);
    if (themeToggleText) themeToggleText.textContent = `${nextTheme[0].toUpperCase()}${nextTheme.slice(1)} mode`;
  };
  themeToggle?.addEventListener('click', () => {
    const element = document.documentElement;
    const isDark = element.getAttribute('data-theme') === 'dark';
    if (isDark) {
      element.removeAttribute('data-theme');
      localStorage.setItem('theme', 'light');
    } else {
      element.setAttribute('data-theme', 'dark');
      localStorage.setItem('theme', 'dark');
    }
    syncThemeToggle();
  });
  syncThemeToggle();
</script>
