---
import { lanes } from '../../../scripts/feed-data.mjs';
interface Source { label: string; url: string }
interface Item { id: string; title: string; lane: string; topic: string; kind: string; sourceDate: string; bullets: string[]; sources: Source[]; article?: string }
interface Edition { date: string; items: Item[] }
interface Props { editions: Edition[]; dates: string[]; archive?: boolean }
const { editions, dates, archive = false } = Astro.props;
const formatDate = (date: string) => new Date(date + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const topics = [...new Set(editions.flatMap(e => e.items.map(i => i.topic)))].sort();
---
<header class="feed-intro">
  <p class="eyebrow">The daily feed</p>
  <h1>A wider world.<br /><em>A personal compass.</em></h1>
  <p class="lede">What matters, what delights, and what you didn’t know to look for. Five bullets at most. Sources always.</p>
  <p class="edition-meta">{archive ? 'From the archive' : 'Latest edition'} · {editions[0] ? formatDate(editions[0].date) : 'Coming soon'} · <a href="/feed/#archive">Browse editions ↓</a></p>
</header>
<div class="feed-layout">
  <aside>
    <h2>Follow your curiosity</h2>
    <p>A daily selection across technology, culture, science, public life, and the occasional wonderful detour.</p>
    <details><summary>How this feed is edited</summary><p>We favor meaningful developments over repeated headlines. Practical consequences and human stakes both matter. Discoveries may be older; their original source date stays visible. Interpretation and uncertainty belong in the summary, not hidden behind a link.</p><p>Daily editions are added after research and verification. The date above shows the latest published edition.</p></details>
    {archive && <p><a href="/feed/">← Back to the latest</a></p>}
  </aside>
  <div>
    <form class="filters" role="search" hidden>
      <label>Search the displayed editions<input type="search" name="q" placeholder="A topic, idea, or headline…" /></label>
      <div class="selects"><label>Perspective<select name="lane"><option value="">All perspectives</option>{lanes.map(lane => <option>{lane}</option>)}</select></label><label>Topic<select name="topic"><option value="">All topics</option>{topics.map(topic => <option>{topic}</option>)}</select></label></div>
    </form>
    <p class="results" aria-live="polite" hidden></p>
    <p class="empty" hidden>No matching entries. Try another search or choose all topics.</p>
    {editions.map(edition => <section class="edition" data-edition>
      <h2 class="date-heading"><a href={`/feed/${edition.date}/`}>{formatDate(edition.date)}</a><span>{edition.items.length} signals</span></h2>
      {edition.items.map(item => <article id={item.id} data-feed-item data-lane={item.lane} data-topic={item.topic}>
        <div class="item-meta"><span>{item.lane}</span><span>{item.topic}</span><span>{item.kind}</span></div>
        <h3><a href={`/feed/${edition.date}/#${item.id}`}>{item.title}</a></h3>
        <ul>{item.bullets.map(bullet => <li>{bullet}</li>)}</ul>
        <footer><p>Sources: {item.sources.map((source, index) => <Fragment>{index > 0 && ' · '}<a href={source.url} rel="noopener noreferrer">{source.label}</a></Fragment>)}</p><p>Source dated <time datetime={item.sourceDate}>{formatDate(item.sourceDate)}</time>{item.article && <> · <a href={item.article}>Read the Rough at Sea article →</a></>}</p></footer>
      </article>)}
    </section>)}
  </div>
</div>
{!archive && <section id="archive" class="archive"><h2>Every edition</h2><p>Keep exploring. Each day has a permanent home.</p><div>{dates.map(date => <a href={`/feed/${date}/`}>{formatDate(date)}</a>)}</div></section>}
<style>
  .feed-intro { max-width: 800px; margin: 1rem 0 3rem; }
  .eyebrow { color: var(--link-color); text-transform: uppercase; letter-spacing: .18em; font-size: .75rem; font-weight: 600; }
  h1 { font-family: var(--font-serif); font-size: clamp(2.7rem, 6vw, 4.8rem); line-height: 1.12; letter-spacing: -.04em; margin: 1rem 0 1.4rem; }
  h1 em { font-weight: 400; color: var(--text-secondary); }
  .lede { max-width: 39rem; font-size: 1.12rem; color: var(--text-secondary); }
  .edition-meta, .item-meta, footer, .results { font-size: .78rem; color: var(--text-secondary); }
  .feed-layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 3.5rem; }
  aside { border-top: 2px solid var(--link-color); padding-top: 1.2rem; font-size: .88rem; color: var(--text-secondary); }
  aside h2 { font-size: 1rem; color: var(--text-primary); } aside details { margin-top: 1.5rem; } summary { cursor: pointer; }
  .filters { padding: 1.2rem; background: var(--surface-color); border: 1px solid var(--border-color); border-radius: .8rem; margin-bottom: 1.5rem; }
  label { display: grid; gap: .4rem; font-size: .75rem; color: var(--text-secondary); }
  input, select { width: 100%; min-width: 0; min-height: 44px; padding: .6rem .7rem; font: inherit; font-size: .9rem; color: var(--text-primary); background: var(--bg-color); border: 1px solid var(--border-color); border-radius: .4rem; }
  .selects { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; margin-top: .8rem; }
  .date-heading { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: space-between; font-size: .9rem; padding-bottom: .8rem; border-bottom: 1px solid var(--border-color); } .date-heading span { color: var(--text-secondary); font-weight: 400; }
  article { padding: 1.8rem 0; border-bottom: 1px solid var(--border-color); scroll-margin-top: 7rem; overflow-wrap: anywhere; }
  .item-meta { display: flex; gap: .5rem 1rem; flex-wrap: wrap; } .item-meta span:first-child { color: var(--link-color); }
  h3 { font-family: var(--font-serif); font-size: clamp(1.45rem, 3vw, 1.9rem); line-height: 1.3; margin: .6rem 0 1rem; } h3 a { color: inherit; }
  ul { padding-left: 1.2rem; } li { padding-left: .3rem; margin: .7rem 0; line-height: 1.75; } footer { margin-top: 1.2rem; } footer p { margin: .35rem 0; }
  .edition + .edition { margin-top: 3rem; } .archive { border-top: 1px solid var(--border-color); margin-top: 4rem; padding-top: 2rem; } .archive div { display: flex; flex-wrap: wrap; gap: 1rem; } .archive p { color: var(--text-secondary); }
  [hidden] { display: none !important; } :is(input,select,a,summary):focus-visible { outline: 2px solid var(--link-color); outline-offset: 4px; }
  @media(max-width: 760px) { .feed-layout { grid-template-columns: 1fr; gap: 1.5rem; } aside { padding-top: .8rem; } .feed-intro { margin-bottom: 2rem; } }
  @media(max-width: 420px) { .selects { grid-template-columns: 1fr; } }
</style>
<script>
  const form = document.querySelector<HTMLFormElement>('.filters');
  const items = [...document.querySelectorAll<HTMLElement>('[data-feed-item]')];
  const results = document.querySelector<HTMLElement>('.results');
  const empty = document.querySelector<HTMLElement>('.empty');
  if (form) {
    form.hidden = false;
    const filter = () => {
      const data = new FormData(form);
      const query = String(data.get('q') || '').trim().toLocaleLowerCase();
      const lane = data.get('lane'); const topic = data.get('topic');
      let count = 0;
      items.forEach(item => {
        item.hidden = !!((lane && item.dataset.lane !== lane) || (topic && item.dataset.topic !== topic) || (query && !item.textContent?.toLocaleLowerCase().includes(query)));
        if (!item.hidden) count++;
      });
      document.querySelectorAll<HTMLElement>('[data-edition]').forEach(edition => { edition.hidden = !edition.querySelector('[data-feed-item]:not([hidden])'); });
      if (results) { results.hidden = false; results.textContent = `${count} ${count === 1 ? 'entry' : 'entries'} shown`; }
      if (empty) empty.hidden = count > 0;
    };
    form.addEventListener('input', filter);
    form.addEventListener('submit', event => event.preventDefault());
  }
</script>
