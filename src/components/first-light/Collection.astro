---
import type { Edition } from '../../../scripts/first-light-data.mjs';
interface Props { editions: Edition[] }
const { editions } = Astro.props;
const formatDate = (date: string) => new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

{editions.length > 0 && <section id="collection" class="collection" aria-labelledby="collection-title">
  <header><div><p class="eyebrow">Keep exploring</p><h2 id="collection-title">The First Light collection</h2></div><p>Another day. Another possible world.</p></header>
  <div class="collection-grid">{editions.map(edition => <a class="edition-card" href={`/feed/${edition.date}/`}>
    <img src={edition.images.cover.srcSmall || edition.images.cover.src} width={edition.images.cover.width} height={edition.images.cover.height} alt={edition.images.cover.alt} loading="lazy" decoding="async" />
    <div class="card-copy"><p>Issue {String(edition.issue).padStart(3, '0')} <span aria-hidden="true">·</span> <time datetime={edition.date}>{formatDate(edition.date)}</time></p><h3>{edition.title}</h3><span class="read">Open this issue <span aria-hidden="true">↗</span></span></div>
  </a>)}</div>
</section>}

<style>
  .collection { max-width: 1320px; margin: 3.5rem auto 4rem; scroll-margin-top: 7rem; }
  header { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem 2rem; margin-bottom: 1.7rem; }
  .eyebrow { font-size: .65rem; font-weight: 600; text-transform: uppercase; letter-spacing: .13em; color: var(--link-color); margin-bottom: .6rem; }
  h2 { font-family: var(--font-serif); font-size: clamp(1.8rem,3vw,2.4rem); font-weight: 400; letter-spacing: -.025em; margin: 0; }
  header > p { color: var(--text-secondary); font-size: .75rem; margin: 0; }
  .collection-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.8rem; }
  .edition-card { display: block; min-width: 0; border-bottom: 1px solid var(--border-color); padding-bottom: 1.2rem; }
  img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; display: block; border-radius: 2px; }
  .card-copy { padding-top: .9rem; }
  .card-copy > p { font-size: .64rem; color: var(--text-secondary); margin-bottom: .6rem; }
  .card-copy > p > span { padding: 0 .4rem; }
  h3 { font-family: var(--font-serif); font-size: 1.45rem; font-weight: 400; line-height: 1.35; letter-spacing: -.02em; margin-bottom: 1rem; }
  .read { color: var(--link-color); font-size: .7rem; }
  .edition-card:hover h3 { text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1px; }
  .edition-card:focus-visible { outline: 3px solid var(--link-color); outline-offset: 5px; }
  @media(max-width: 950px) { .collection-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media(max-width: 600px) { .collection { margin-top: 2.5rem; } .collection-grid { grid-template-columns: 1fr; gap: 1.7rem; } }
</style>
