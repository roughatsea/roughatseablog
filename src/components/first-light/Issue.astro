---
import type { Edition } from '../../../scripts/first-light-data.mjs';
import Artwork from './Artwork.astro';

interface Props {
  edition: Edition;
  isArchive?: boolean;
  hasArchive?: boolean;
}

const { edition, isArchive = false, hasArchive = false } = Astro.props;
const formatDate = (date: string) => new Date(`${date}T12:00:00Z`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const contentWords = [edition.dek, ...edition.fiction.opening, ...edition.fiction.continuation, ...edition.items.flatMap(item => [item.title, ...item.bullets]), ...edition.singularity.paragraphs, ...edition.singularity.signals, edition.singularity.question, ...edition.closing.paragraphs].join(' ').split(/\s+/).length;
const readMinutes = Math.max(5, Math.ceil(contentWords / 210));
const number = String(edition.issue).padStart(3, '0');
---

<div class="first-light">
  <header class="masthead">
    <div class="masthead-top"><span>Rough at Sea <span class="divider">/</span> An illustrated daily</span><span class="masthead-promise">A future worth imagining.</span></div>
    <h1><a href="/feed/" aria-label="First Light, latest issue">First Light<span class="sunrise" aria-hidden="true"></span></a></h1>
    <div class="masthead-bottom"><p>Science. Possibility. The lives we could lead.</p><span>Vol. 01 <span class="divider">/</span> No. {number}</span></div>
  </header>

  <nav class="issue-nav" aria-label="In this issue">
    <a href="#imagined-future">An imagined future</a>
    <a href="#discoveries">Today’s discoveries</a>
    <a href="#singularity">Toward the singularity</a>
    {isArchive ? <a href="/feed/">Latest issue <span aria-hidden="true">↗</span></a> : hasArchive ? <a href="#collection">Past issues <span aria-hidden="true">↓</span></a> : <a href="#about-first-light">About First Light</a>}
  </nav>

  <article class="issue" aria-labelledby="issue-title">
    <header class="issue-heading">
      <div class="issue-meta"><span>{isArchive ? 'From the collection' : 'The latest issue'}</span><span class="meta-dot" aria-hidden="true">·</span><time datetime={edition.date}>{formatDate(edition.date)}</time><span class="meta-dot" aria-hidden="true">·</span><span>{readMinutes} minute read</span></div>
      <h2 id="issue-title">{edition.title}</h2>
      <p class="dek">{edition.dek}</p>
    </header>

    <Artwork image={edition.images.cover} number={1} priority />

    <section id="imagined-future" class="fiction-opening section-grid" aria-labelledby="fiction-title">
      <div class="section-heading">
        <p class="eyebrow"><span class="section-number">01</span> A possible Tuesday</p>
        <h2 id="fiction-title">{edition.fiction.title}</h2>
        <p class="genre-label">An imagined future</p>
      </div>
      <div class="story opening-copy">{edition.fiction.opening.map(paragraph => <p>{paragraph}</p>)}</div>
    </section>

    <section id="discoveries" class="reporting" aria-labelledby="discoveries-title">
      <header class="department-heading">
        <div><p class="eyebrow"><span class="section-number">02</span> From the world we have</p><h2 id="discoveries-title">What is becoming possible</h2></div>
        <p>Reported developments & worthwhile discoveries.<br />Five bullets at most. Sources to explore.</p>
      </header>
      <div class="dispatch-grid">
        {edition.items.map((item, index) => <article class="dispatch" id={item.id}>
          <div class="dispatch-top"><span class="department">{item.department}</span><span class="dispatch-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span></div>
          <h3><a href={`/feed/${edition.date}/#${item.id}`}>{item.title}</a></h3>
          <div class="dispatch-meta"><span>{item.kind}</span><span>{item.topic}</span></div>
          <ul>{item.bullets.map(bullet => <li>{bullet}</li>)}</ul>
          <footer class="sources">
            <p class="source-heading">Explore the sources <span>· <time datetime={item.sourceDate}>{formatDate(item.sourceDate)}</time></span></p>
            <div class="source-links">{item.sources.map(source => <a href={source.url} rel="noopener noreferrer">{source.label} <span aria-hidden="true">↗</span></a>)}</div>
            {item.article && <a class="article-link" href={item.article}>Read the Rough at Sea article <span aria-hidden="true">→</span></a>}
          </footer>
        </article>)}
      </div>
    </section>

    <section id="singularity" class="singularity" aria-labelledby="singularity-title">
      <div class="interlude-heading"><p class="eyebrow"><span class="section-number">03</span> Toward the singularity</p><p>Following the possibility of a more capable civilization.</p></div>
      <Artwork image={edition.images.possibility} number={2} />
      <div class="singularity-grid">
        <div class="analysis">
          <p class="genre-label">Analysis & open questions</p>
          <h2 id="singularity-title">{edition.singularity.title}</h2>
          <div class="reading">{edition.singularity.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
          <div class="analysis-sources sources"><p class="source-heading">Further reading</p><div class="source-links">{edition.singularity.sources.map(source => <a href={source.url} rel="noopener noreferrer">{source.label} <span aria-hidden="true">↗</span></a>)}</div></div>
        </div>
        <aside class="watch" aria-labelledby="watch-title">
          <h3 id="watch-title">What to watch next</h3>
          <ol>{edition.singularity.signals.map(signal => <li>{signal}</li>)}</ol>
          <div class="open-question"><p class="eyebrow">The open question</p><p>{edition.singularity.question}</p></div>
        </aside>
      </div>
    </section>

    <section class="human-feature" aria-labelledby="continuation-title">
      <div class="human-art"><Artwork image={edition.images.human} number={3} /></div>
      <div class="human-story">
        <p class="eyebrow"><span class="section-number">04</span> A possible Tuesday, continued</p>
        <h2 id="continuation-title">A life inside that future</h2>
        <p class="genre-label">An imagined future</p>
        <div class="story">{edition.fiction.continuation.map(paragraph => <p>{paragraph}</p>)}</div>
        <details class="assumptions"><summary>What this imagined future assumes</summary><p>{edition.fiction.assumptions}</p></details>
      </div>
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="interlude-heading"><p class="eyebrow"><span class="section-number">05</span> One last wonder</p><p>Leave a little room for the unfamiliar.</p></div>
      <Artwork image={edition.images.closing} number={4} />
      <div class="closing-copy"><h2 id="closing-title">{edition.closing.title}</h2>{edition.closing.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
    </section>
  </article>

  <footer id="about-first-light" class="publication-note">
    <div class="publication-name">First Light<span aria-hidden="true"> ✳</span></div>
    <p>An illustrated daily about discovery, the technological singularity, and the lives we could lead. Reporting is sourced. Fiction and original generated artwork open a window onto possible futures.</p>
    <a href={`/feed/${edition.date}/`}>Issue {number} <span aria-hidden="true">↗</span></a>
  </footer>
</div>

<style>
  .first-light {
    --fl-ink: #20363d;
    --fl-muted: #56676b;
    --fl-accent: #a3522e;
    --fl-line: #d9d9cb;
    --fl-panel: #f5f4ed;
    --fl-paper: #fcfcfc;
    max-width: 1320px;
    margin: 0 auto;
    color: var(--fl-ink);
  }
  :global([data-theme='dark']) .first-light {
    --fl-ink: #f0ede2;
    --fl-muted: #b0b9b7;
    --fl-accent: #edb084;
    --fl-line: #354144;
    --fl-panel: #162126;
    --fl-paper: #0a0a0a;
  }
  :global([data-toxic-sunrise='true']) .first-light { --fl-accent: var(--link-color); }
  .first-light :is(h1,h2,h3) { color: var(--fl-ink); }
  .first-light :is(section, article, footer)[id] { scroll-margin-top: 7rem; }
  .first-light a:focus-visible, summary:focus-visible { outline: 3px solid var(--fl-accent); outline-offset: 5px; border-radius: 2px; }
  .masthead { border-top: 1px solid var(--fl-line); border-bottom: 3px double var(--fl-ink); padding: .8rem 0 1rem; }
  .masthead-top, .masthead-bottom { display: flex; align-items: center; justify-content: space-between; gap: .5rem 1.5rem; }
  .masthead-top { font-size: .67rem; letter-spacing: .08em; text-transform: uppercase; color: var(--fl-muted); }
  .masthead-promise { text-transform: none; font-family: var(--font-serif); font-size: .86rem; font-style: italic; letter-spacing: 0; }
  .divider { color: var(--fl-accent); padding: 0 .5rem; }
  .masthead h1 { font-family: var(--font-serif); font-size: clamp(3rem, 12.7vw, 10rem); font-weight: 400; line-height: 1.02; letter-spacing: -.065em; text-align: center; margin: 1.35rem 0 1.1rem; }
  .masthead h1 a { display: inline-block; position: relative; padding-right: .23em; }
  .sunrise { position: absolute; height: .095em; width: .19em; top: .12em; right: -.01em; border-radius: .2em .2em 0 0; background: var(--fl-accent); }
  .masthead-bottom { color: var(--fl-muted); font-size: .7rem; letter-spacing: .035em; }
  .masthead-bottom p { margin: 0; }
  .masthead-bottom > span { white-space: nowrap; }
  .issue-nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .25rem 1.6rem; border-bottom: 1px solid var(--fl-line); padding: .6rem 0; font-size: .72rem; color: var(--fl-muted); }
  .issue-nav a { padding: .4rem 0; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 5px; }
  .issue-nav a:hover { color: var(--fl-accent); text-decoration-color: currentColor; }
  .issue-heading { max-width: 1000px; margin: 0 auto; padding: 3.5rem 1rem 2.75rem; text-align: center; }
  .issue-meta { display: flex; align-items: center; flex-wrap: wrap; justify-content: center; gap: .35rem .65rem; font-size: .67rem; letter-spacing: .04em; color: var(--fl-muted); }
  .issue-meta > span:first-child { color: var(--fl-accent); font-weight: 600; }
  .meta-dot { color: var(--fl-accent); }
  .issue-heading h2 { max-width: 920px; margin: 1.2rem auto 1.2rem; font-family: var(--font-serif); font-size: clamp(2.2rem, 4.5vw, 4.05rem); font-weight: 400; line-height: 1.13; letter-spacing: -.035em; text-wrap: balance; }
  .dek { max-width: 680px; margin: 0 auto; font-size: 1rem; line-height: 1.8; color: var(--fl-muted); text-wrap: pretty; }
  .eyebrow { margin-bottom: .85rem; font-size: .65rem; line-height: 1.6; font-weight: 600; text-transform: uppercase; letter-spacing: .13em; color: var(--fl-accent); }
  .section-number { margin-right: .7rem; padding-right: .7rem; border-right: 1px solid var(--fl-line); color: var(--fl-muted); }
  .section-grid { display: grid; grid-template-columns: minmax(0,.8fr) minmax(0,1.5fr); gap: clamp(2rem,6vw,6rem); max-width: 1050px; margin: 4rem auto; }
  .section-heading h2, .analysis h2, .human-story h2, .closing h2 { font-family: var(--font-serif); font-size: clamp(1.9rem,3vw,2.7rem); line-height: 1.2; font-weight: 400; letter-spacing: -.025em; text-wrap: balance; }
  .genre-label { width: fit-content; margin: 1rem 0 1.4rem; padding: .27rem .55rem; border: 1px solid var(--fl-line); color: var(--fl-muted); font-size: .64rem; line-height: 1.5; letter-spacing: .04em; }
  .story { font-family: var(--font-serif); font-size: 1.13rem; line-height: 1.95; }
  .story p { margin-bottom: 1.35rem; }
  .opening-copy > p:first-child::first-letter { float: left; font-size: 4.3rem; line-height: .9; padding: .1em .13em 0 0; color: var(--fl-accent); }
  .story > p:last-child, .reading > p:last-child { margin-bottom: 0; }
  .department-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; border-top: 1px solid var(--fl-ink); padding: 1.65rem 0 1.8rem; }
  .department-heading h2 { font-family: var(--font-serif); font-size: clamp(1.85rem,3vw,2.65rem); font-weight: 400; letter-spacing: -.025em; margin: 0; }
  .department-heading > p { font-size: .73rem; line-height: 1.7; color: var(--fl-muted); margin: 0; }
  .dispatch-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); column-gap: 3.6rem; }
  .dispatch { min-width: 0; padding: 1.75rem 0 2.15rem; border-top: 1px solid var(--fl-line); display: flex; flex-direction: column; }
  .dispatch-top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .department { color: var(--fl-accent); font-size: .65rem; text-transform: uppercase; letter-spacing: .1em; font-weight: 600; }
  .dispatch-number { font-family: var(--font-serif); color: var(--fl-muted); font-size: .92rem; }
  .dispatch h3 { font-family: var(--font-serif); font-size: clamp(1.55rem,2.3vw,2rem); font-weight: 400; line-height: 1.3; letter-spacing: -.02em; margin: .65rem 0 .85rem; text-wrap: pretty; }
  .dispatch h3 a:hover { color: var(--fl-accent); }
  .dispatch-meta { display: flex; flex-wrap: wrap; gap: .3rem .7rem; font-size: .64rem; color: var(--fl-muted); line-height: 1.5; margin-bottom: 1rem; }
  .dispatch-meta > span + span { border-left: 1px solid var(--fl-line); padding-left: .7rem; }
  .dispatch ul { padding-left: 1.1rem; margin-bottom: 1.15rem; }
  .dispatch li { font-size: .9rem; line-height: 1.85; padding-left: .25rem; margin-bottom: .7rem; }
  .dispatch li::marker { color: var(--fl-accent); font-size: .7em; }
  .dispatch li:last-child { margin-bottom: 0; }
  .sources { color: var(--fl-muted); }
  .dispatch .sources { margin-top: auto; padding-top: .5rem; }
  .source-heading { font-size: .64rem; line-height: 1.6; margin-bottom: .35rem; }
  .source-heading > span { color: var(--fl-muted); }
  .source-links { display: flex; flex-wrap: wrap; align-items: baseline; gap: .35rem 1rem; }
  .source-links a, .article-link { font-size: .72rem; line-height: 1.65; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--fl-line); overflow-wrap: anywhere; }
  .source-links a:hover, .article-link:hover { color: var(--fl-accent); text-decoration-color: currentColor; }
  .source-links a > span { font-size: .85em; color: var(--fl-accent); }
  .article-link { display: inline-block; margin-top: .7rem; }
  .singularity { margin-top: 3rem; }
  .interlude-heading { display: flex; align-items: baseline; justify-content: space-between; gap: .5rem 1.5rem; border-top: 1px solid var(--fl-ink); padding: 1.2rem 0; }
  .interlude-heading p { margin: 0; }
  .interlude-heading > p:last-child:not(:first-child) { font-size: .72rem; color: var(--fl-muted); }
  .singularity-grid { display: grid; grid-template-columns: minmax(0,1.6fr) minmax(0,1fr); gap: clamp(2rem,6vw,6rem); max-width: 1140px; margin: 2.7rem auto 4.5rem; }
  .analysis > .genre-label { margin-top: 0; }
  .analysis h2 { margin-bottom: 1.25rem; }
  .reading { font-size: .98rem; line-height: 1.95; }
  .reading p { margin-bottom: 1.2rem; }
  .analysis-sources { margin-top: 1.5rem; }
  .watch { background: var(--fl-panel); border-top: 3px solid var(--fl-accent); padding: 1.6rem 1.65rem; align-self: start; }
  .watch h3 { font-family: var(--font-serif); font-size: 1.3rem; font-weight: 400; margin-bottom: 1.1rem; }
  .watch ol { padding-left: 1.3rem; }
  .watch li { padding-left: .35rem; font-size: .84rem; line-height: 1.8; margin-bottom: .9rem; }
  .watch li::marker { color: var(--fl-accent); font-size: .75rem; }
  .open-question { padding-top: 1.1rem; margin-top: 1.2rem; border-top: 1px solid var(--fl-line); }
  .open-question > p:last-child { font-family: var(--font-serif); font-size: 1.17rem; line-height: 1.65; margin: 0; }
  .human-feature { display: grid; grid-template-columns: minmax(0,1.17fr) minmax(0,1fr); gap: clamp(2rem,5vw,4.5rem); align-items: start; border-top: 1px solid var(--fl-line); padding-top: 3rem; margin-bottom: 4.5rem; }
  .human-art { position: sticky; top: 7rem; }
  .human-story h2 { font-size: clamp(1.8rem,2.5vw,2.3rem); margin: .7rem 0; }
  .human-story .story { font-size: 1.04rem; }
  .assumptions { margin-top: 1.7rem; color: var(--fl-muted); border-top: 1px solid var(--fl-line); border-bottom: 1px solid var(--fl-line); font-size: .77rem; line-height: 1.8; }
  .assumptions summary { cursor: pointer; padding: .8rem 0; }
  .assumptions p { margin: .2rem 0 1rem; }
  .closing-copy { max-width: 760px; margin: 2.5rem auto 3.5rem; text-align: center; }
  .closing-copy h2 { margin-bottom: 1.3rem; }
  .closing-copy p { font-family: var(--font-serif); font-size: 1.13rem; line-height: 1.9; }
  .publication-note { display: grid; grid-template-columns: 1fr 2.4fr auto; align-items: center; gap: 2rem; margin-bottom: 2rem; padding: 1.6rem 0; border-top: 3px double var(--fl-ink); border-bottom: 1px solid var(--fl-line); }
  .publication-name { font-family: var(--font-serif); font-size: 1.4rem; letter-spacing: -.035em; white-space: nowrap; }
  .publication-name > span { color: var(--fl-accent); margin-left: .25rem; font-family: var(--font-sans); }
  .publication-note p { color: var(--fl-muted); font-size: .72rem; line-height: 1.8; margin: 0; }
  .publication-note > a { font-size: .7rem; color: var(--fl-accent); white-space: nowrap; padding: .5rem 0; }
  .publication-note > a:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 1050px) {
    .section-grid { grid-template-columns: minmax(0,.8fr) minmax(0,1.4fr); gap: 2.7rem; }
    .dispatch-grid { column-gap: 2rem; }
    .singularity-grid { grid-template-columns: minmax(0,1.3fr) minmax(0,1fr); gap: 2.4rem; }
    .human-feature { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .publication-note { grid-template-columns: 1fr 2fr; }
    .publication-note > a { grid-column: 2; }
  }
  @media (max-width: 760px) {
    .masthead-top { font-size: .58rem; letter-spacing: .045em; }
    .masthead-promise { display: none; }
    .masthead h1 { margin: 1.4rem 0 1.2rem; }
    .masthead-bottom { align-items: flex-start; font-size: .61rem; gap: .75rem; }
    .masthead-bottom p { max-width: 15rem; }
    .masthead-bottom .divider { padding: 0 .2rem; }
    .issue-nav { justify-content: flex-start; column-gap: 1.1rem; font-size: .66rem; padding: .5rem 0; }
    .issue-heading { padding: 2.4rem 0 2rem; }
    .issue-meta { font-size: .62rem; gap: .25rem .5rem; }
    .issue-heading h2 { font-size: clamp(2rem,7vw,3.4rem); margin-top: 1rem; }
    .dek { font-size: .9rem; line-height: 1.85; }
    .section-grid { grid-template-columns: 1fr; gap: .6rem; margin: 2.5rem 0 3rem; }
    .section-heading h2 { max-width: 30rem; }
    .genre-label { margin-bottom: 1rem; }
    .story { font-size: 1.07rem; line-height: 1.95; }
    .department-heading { display: block; padding-bottom: 1.5rem; }
    .department-heading > p { margin-top: 1rem; }
    .department-heading > p br { display: none; }
    .dispatch-grid { grid-template-columns: 1fr; }
    .dispatch { padding: 1.5rem 0 1.9rem; }
    .dispatch h3 { font-size: 1.65rem; }
    .dispatch li { font-size: .88rem; line-height: 1.9; }
    .singularity { margin-top: 1.7rem; }
    .interlude-heading { display: block; padding: 1rem 0; }
    .interlude-heading > p:last-child:not(:first-child) { margin-top: .35rem; font-size: .68rem; }
    .singularity-grid { grid-template-columns: 1fr; gap: 1.8rem; margin: 2rem 0 3rem; }
    .reading { font-size: .94rem; }
    .watch { padding: 1.35rem 1.3rem; }
    .human-feature { grid-template-columns: 1fr; gap: 2rem; padding-top: 2rem; margin-bottom: 3rem; }
    .human-art { position: static; }
    .human-story .story { font-size: 1.07rem; }
    .closing-copy { margin: 2rem 0 2.5rem; }
    .closing-copy p { font-size: 1.06rem; }
    .publication-note { grid-template-columns: 1fr auto; gap: 1rem; }
    .publication-note p { grid-column: 1 / -1; grid-row: 2; }
    .publication-note > a { grid-column: 2; grid-row: 1; }
  }
  @media (max-width: 390px) {
    .masthead-bottom { flex-wrap: wrap; }
    .masthead-bottom p { max-width: none; }
    .issue-meta .meta-dot { display: none; }
    .issue-meta { gap: .35rem .8rem; }
  }
  @media (prefers-reduced-motion: reduce) { .first-light a { transition: none; } }
  @media print {
    .issue-nav, .assumptions { display: none; }
    .human-art { position: static; }
    .first-light { --fl-ink: #111; --fl-muted: #444; --fl-accent: #333; --fl-line: #aaa; --fl-panel: #fff; }
    .human-feature, .singularity-grid { grid-template-columns: 1fr; }
    .dispatch, .story p, .watch { break-inside: avoid; }
  }
</style>
