---
interface Props {
  id: string;
  image: string;
  imageAlt: string;
}

const { id, image, imageAlt } = Astro.props;
---

<figure id={id} class="division-gate">
  <img
    src={image}
    alt={imageAlt}
    width="1600"
    height="686"
    loading="lazy"
    decoding="async"
  />
</figure>

<style>
  .division-gate {
    width: min(1200px, calc(100vw - 1.5rem));
    margin: 6.5rem 0 3.75rem 50%;
    transform: translateX(-50%);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--border-color) 72%, #b8884b 28%);
    border-radius: 20px;
    background: #090806;
    box-shadow:
      0 24px 80px rgba(0, 0, 0, 0.32),
      var(--glass-shadow);
    scroll-margin-top: 1rem;
  }

  .division-gate img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 800 / 343;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    .division-gate {
      width: min(100%, calc(100vw - 1rem));
      margin-top: 5rem;
      margin-bottom: 2.75rem;
      border-radius: 12px;
    }

    .division-gate img {
      min-height: 15.5rem;
      object-position: center;
    }
  }
</style>
