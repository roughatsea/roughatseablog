{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roughatsea.com/schemas/wake-run.schema.json",
  "title": "The Wake weekly run log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "runId",
    "mode",
    "startedAt",
    "completedAt",
    "inputWindow",
    "inputPackets",
    "summary",
    "publicHighlights",
    "admissions",
    "updates",
    "reviews",
    "deferred",
    "failures",
    "recordCountAfter",
    "attentionMethod",
    "commit"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "runId": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "mode": { "enum": ["bootstrap", "weekly", "manual-correction"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "inputWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    },
    "inputPackets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.json$"
      },
      "uniqueItems": true
    },
    "summary": { "$ref": "#/$defs/text" },
    "publicHighlights": {
      "type": "array",
      "items": { "$ref": "#/$defs/text" }
    },
    "admissions": {
      "type": "array",
      "items": { "$ref": "#/$defs/admission" }
    },
    "updates": {
      "type": "array",
      "items": { "$ref": "#/$defs/update" }
    },
    "reviews": {
      "type": "array",
      "items": { "$ref": "#/$defs/review" }
    },
    "deferred": {
      "type": "array",
      "items": { "$ref": "#/$defs/deferred" }
    },
    "failures": {
      "type": "array",
      "items": { "$ref": "#/$defs/failure" }
    },
    "recordCountAfter": { "type": "integer", "minimum": 0 },
    "attentionMethod": { "$ref": "#/$defs/text" },
    "commit": { "type": ["string", "null"] }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wakeId", "sourceSignalId", "observationId", "reason"],
      "properties": {
        "wakeId": { "$ref": "#/$defs/text" },
        "sourceSignalId": { "$ref": "#/$defs/text" },
        "observationId": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wakeId", "observationIds", "summary"],
      "properties": {
        "wakeId": { "$ref": "#/$defs/text" },
        "observationIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/text" }
        },
        "summary": { "$ref": "#/$defs/text" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wakeId", "observationId", "materialChange"],
      "properties": {
        "wakeId": { "$ref": "#/$defs/text" },
        "observationId": { "$ref": "#/$defs/text" },
        "materialChange": { "type": "boolean" }
      }
    },
    "deferred": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signalId", "reason"],
      "properties": {
        "signalId": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "summary"],
      "properties": {
        "subject": { "$ref": "#/$defs/text" },
        "summary": { "$ref": "#/$defs/text" }
      }
    }
  }
}
