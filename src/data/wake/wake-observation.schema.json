{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roughatsea.com/schemas/wake-observation.schema.json",
  "title": "The Wake point-zero observation packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "observationDate",
    "article",
    "capture",
    "signals"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "observationDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "title",
        "publishedAt",
        "path"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^morning-soundings-\\d{4}-\\d{2}-\\d{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "path": {
          "type": "string",
          "pattern": "^src/content/soundings/morning-soundings-\\d{4}-\\d{2}-\\d{2}\\.md$"
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "capturedAt",
        "sourceStateAsOf",
        "notes"
      ],
      "properties": {
        "mode": {
          "enum": [
            "contemporaneous",
            "reconstructed"
          ]
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceStateAsOf": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/signal"
      }
    }
  },
  "$defs": {
    "nullableDate": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      ]
    },
    "nullableString": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "aliases"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "notes"
      ],
      "properties": {
        "level": {
          "enum": [
            "primary-supported",
            "mixed",
            "first-party-only",
            "preliminary",
            "disputed",
            "synthesis"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title",
        "publisher",
        "publishedAt",
        "accessedAt",
        "role",
        "lineage"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "publishedAt": {
          "$ref": "#/$defs/nullableDate"
        },
        "accessedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "role": {
          "enum": [
            "primary-research",
            "official-primary",
            "first-party",
            "independent-reporting",
            "institutional-reporting",
            "analysis-context",
            "archival-source"
          ]
        },
        "lineage": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "watchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "expectedWindow",
        "trigger"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "expectedWindow": {
          "$ref": "#/$defs/nullableString"
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "active-candidate",
            "passive",
            "unsuitable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attentionSnapshot": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "query",
            "dateWindow",
            "capturedAt",
            "matchingSources"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "query": {
              "type": "string",
              "minLength": 1
            },
            "dateWindow": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              }
            },
            "capturedAt": {
              "type": "string",
              "format": "date-time"
            },
            "matchingSources": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uri"
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signalId",
        "order",
        "sectionRole",
        "headline",
        "canonicalSubject",
        "signalType",
        "topics",
        "geography",
        "canonicalClaim",
        "knownFacts",
        "uncertainties",
        "evidence",
        "sources",
        "openQuestions",
        "watchFor",
        "trackingTerms",
        "existingWakeId",
        "disposition",
        "selectionReason",
        "reviewAfter",
        "attentionSnapshot"
      ],
      "properties": {
        "signalId": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "sectionRole": {
          "enum": [
            "signal",
            "deep-sounding"
          ]
        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "canonicalSubject": {
          "$ref": "#/$defs/subject"
        },
        "signalType": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "geography": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "canonicalClaim": {
          "type": "string",
          "minLength": 1
        },
        "knownFacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "watchFor": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/watchItem"
          }
        },
        "trackingTerms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "existingWakeId": {
          "$ref": "#/$defs/nullableString"
        },
        "disposition": {
          "$ref": "#/$defs/disposition"
        },
        "selectionReason": {
          "type": "string",
          "minLength": 1
        },
        "reviewAfter": {
          "$ref": "#/$defs/nullableDate"
        },
        "attentionSnapshot": {
          "$ref": "#/$defs/attentionSnapshot"
        }
      }
    }
  }
}
