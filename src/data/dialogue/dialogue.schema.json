{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.roughatsea.com/schemas/dialogue-1.0.0.json",
  "title": "Dialogue canonical record definitions",
  "type": "object",
  "$defs": {
    "score_0_100": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "big_five": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openness", "conscientiousness", "extraversion", "agreeableness", "neuroticism"],
      "properties": {
        "openness": { "$ref": "#/$defs/score_0_100" },
        "conscientiousness": { "$ref": "#/$defs/score_0_100" },
        "extraversion": { "$ref": "#/$defs/score_0_100" },
        "agreeableness": { "$ref": "#/$defs/score_0_100" },
        "neuroticism": { "$ref": "#/$defs/score_0_100" }
      }
    },
    "relationship_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affection", "trust", "intellectual_respect", "familiarity", "friction"],
      "properties": {
        "affection": { "$ref": "#/$defs/score_0_100" },
        "trust": { "$ref": "#/$defs/score_0_100" },
        "intellectual_respect": { "$ref": "#/$defs/score_0_100" },
        "familiarity": { "$ref": "#/$defs/score_0_100" },
        "friction": { "$ref": "#/$defs/score_0_100" }
      }
    },
    "evidence_link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "claim_boundary", "note"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "claim_boundary": { "enum": ["source-says", "author-infers"] },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "thread_id", "author_id", "published_at", "in_reply_to", "depth", "paragraphs", "evidence", "canonical_status", "validation_run_id", "provenance", "state_changes"],
      "properties": {
        "id": { "type": "string", "pattern": "^msg-[0-9]{4,}$" },
        "thread_id": { "type": "string", "minLength": 1 },
        "author_id": { "type": "string", "minLength": 1 },
        "published_at": { "type": "string", "format": "date-time" },
        "in_reply_to": { "type": ["string", "null"] },
        "depth": { "type": "integer", "minimum": 0 },
        "paragraphs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence_link" } },
        "canonical_status": { "enum": ["accepted"] },
        "validation_run_id": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active_thread_ids", "retrieved_memory_ids", "implicated_belief_ids", "relationship_context_ids", "external_source_ids", "raw_model_reasoning_stored"],
          "properties": {
            "active_thread_ids": { "type": "array", "items": { "type": "string" } },
            "retrieved_memory_ids": { "type": "array", "items": { "type": "string" } },
            "implicated_belief_ids": { "type": "array", "items": { "type": "string" } },
            "relationship_context_ids": { "type": "array", "items": { "type": "string" } },
            "external_source_ids": { "type": "array", "items": { "type": "string" } },
            "raw_model_reasoning_stored": { "const": false }
          }
        },
        "state_changes": { "type": "array" }
      }
    }
  },
  "description": "Dialogue data is split across named JSON files. This document defines the high-risk shared shapes; scripts/validate-dialogue.mjs enforces cross-file references and complete founding coverage."
}
