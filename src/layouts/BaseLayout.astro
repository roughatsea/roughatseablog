---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import ToxicSunriseToggle from '../components/ToxicSunriseToggle.astro';

interface Props {
  title: string;
  description?: string;
  robots?: string;
  image?: string;
  article?: boolean;
}

const {
  title,
  description = "Notes, links, and useful signals gathered in uncertain waters.",
  robots,
  image = '/og.png',
  article = false,
} = Astro.props;
const pageTitle = title === 'Rough at Sea' ? title : `${title} · Rough at Sea`;
const siteOrigin = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const imageUrl = new URL(image, siteOrigin).toString();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
      }

      if (typeof localStorage !== 'undefined' && localStorage.getItem('toxic-sunrise') === 'on') {
        document.documentElement.setAttribute('data-toxic-sunrise', 'true');
      }

      try {
        const fieldGuideLanguage = localStorage.getItem('roughatsea-field-guide-language');
        if (fieldGuideLanguage && ['csharp', 'python', 'both'].includes(fieldGuideLanguage)) {
          document.documentElement.setAttribute('data-field-guide-language', fieldGuideLanguage);
        }
      } catch {
        // Field-guide pages show both languages if storage is unavailable.
      }

      try {
        const hasActiveTag = new URLSearchParams(window.location.search).has('tag');
        const explorerIsCollapsed = localStorage.getItem('roughatsea-tag-explorer-collapsed') === 'true';
        if (explorerIsCollapsed && !hasActiveTag) {
          document.documentElement.setAttribute('data-tag-explorer-collapsed', 'true');
        }
      } catch {
        // The explorer simply starts open if storage is unavailable.
      }
    </script>
  </head>
  <body>
    <Header />
    <main class="container">
      <slot />
    </main>
    <footer class="container">
      <ToxicSunriseToggle />
    </footer>
  </body>
</html>
